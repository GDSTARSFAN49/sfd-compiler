public void OnStartup() 
{
    Events.UserMessageCallback.Start(OnUserMessage);

    foreach (var p in Game.GetPlayers())
    {
        Player.Players.Add(new Player(p));
    }

    var data = Game.LocalStorage.GetItem("data") as string;

    if (data == null || data == "") 
    return;
 
    var playerdatas = data.Split(',');

    foreach (var pd in playerdatas)
    {
        var x = pd.Split(';');
        var player = Player.Players.Where(p => p.User.ConnectionIP == x[0]).FirstOrDefault();

        if (player == null)
        continue;
  
        var e_player = new Player(player.Ply, Convert.ToInt32(x[1]));
        Player.Players.Remove(player);
        Player.Players.Add(e_player);
    }

    new Timers("Global").AddTimer(1000, 0, (args) =>  
    { 
        string log;

        if (Game.LocalStorage.TryGetItemString("plist", out log))
        {
            var ulog = log.Split(',').ToList();

            foreach (var x in log.Split(','))
            {
                if (x == null || x == "")
                    continue;

                var xy = x.Split(';');
                var ply = Game.GetActiveUsers().FirstOrDefault(ux => ux.ConnectionIP.Equals(xy[0]));
                if (ply != null) 
                {
                    Random rnd = new Random();
                    switch(rnd.Next(0,4))
                    {
                       case 0:
                       Game.PlaySound("TutorialSuccess1", new Vector2(0,0), 1f);
                       Game.PlaySound("ElevatorDing", new Vector2(0,0), 0.6f);
                       Game.PlaySound("TutorialSuccess2", new Vector2(0,0), 1f);
                       Game.ShowChatMessage(Capitalize(xy[1].ToLowerInvariant()) + "ing " + ply.Name + " for evading the rule before", new Color(5,95,15));
                       Game.RunCommand("/" + xy[1] + " " + ply.Name);
                       ulog.Remove(x);
                       break;
                       case 1:
                       Game.PlaySound("TutorialSuccess1", new Vector2(0,0), 1f);
                       Game.PlaySound("ElevatorDing", new Vector2(0,0), 0.6f);
                       Game.PlaySound("TutorialSuccess2", new Vector2(0,0), 1f);
                       Game.ShowChatMessage(Capitalize(xy[1].ToLowerInvariant()) + "ing " + ply.Name + " for double rule-breaking", new Color(5,95,15));
                       Game.RunCommand("/" + xy[1] + " " + ply.Name);
                       ulog.Remove(x);
                       break;
                       case 2:
                       Game.PlaySound("TutorialSuccess1", new Vector2(0,0), 1f);
                       Game.PlaySound("ElevatorDing", new Vector2(0,0), 0.6f);
                       Game.PlaySound("TutorialSuccess2", new Vector2(0,0), 1f);
                       Game.ShowChatMessage(Capitalize(xy[1].ToLowerInvariant()) + "ing " + ply.Name + " for trying to avoiding punishment", new Color(5,95,15));
                       Game.RunCommand("/" + xy[1] + " " + ply.Name);
                       ulog.Remove(x);
                       break;
                       case 3:
                       Game.PlaySound("TutorialSuccess1", new Vector2(0,0), 1f);
                       Game.PlaySound("ElevatorDing", new Vector2(0,0), 0.6f);
                       Game.PlaySound("TutorialSuccess2", new Vector2(0,0), 1f);
                       Game.ShowChatMessage(Capitalize(xy[1].ToLowerInvariant()) + "ing " + ply.Name + " for avoiding punishment", new Color(5,95,15));
                       Game.RunCommand("/" + xy[1] + " " + ply.Name);
                       ulog.Remove(x);
                       break;
                   }
                }
            }
 
            Game.LocalStorage.SetItem("plist", string.Join(",", ulog.ToArray()));
        }
    });
}

public void OnShutdown()
{
    var data = "";

    for (var i = 0; i < Player.Players.Count(); i++)
    {
         if (Player.Players[i].IsHost)
             continue;

         data += Player.Players[i].IP + ";" + Player.Players[i].Warnings;

         if (i != Player.Players.Count() - 1) 
             data += ",";
    }
 
    Game.LocalStorage.SetItem("data", data);
}

public void OnUserMessage(UserMessageCallbackArgs ua) 
{ 
   if (ua.User.IsHost)
   {  
      if(ua.Message.ToUpper().Contains("XD"))
       { 
          Game.LocalStorage.SetItem("XD",x4u + 1);
          Game.RunCommand("/msg [" + (x4u + 1) + "]");
          Game.LocalStorage.SetItem("XD",1);
          x4u++;
       }
       return;
    }

    var msg = ua.Message.Split(']');
    var actual_message = msg[msg.Count() - 1];

    var player = Player.GetPlayer(ua.User);

    if (player == null)
    {
        player = new Player(ua.User);
 
        if (Player.Players != null)
            Player.Players.Add(player);
    }

    foreach (var s in words.Where(w => w != "" || w != null))
    {
        if (actual_message.ToLowerInvariant().Split(' ').Contains(s.ToLowerInvariant()) || 
            Truncate2(actual_message).ToLowerInvariant().Split(' ').Contains(s.ToLowerInvariant()) ||
            Truncate2(actual_message).Split(' ').Select(x => x.ToLowerInvariant()).ToList().Any(x => Sanitize(x).Contains(s)) ||
            (s.Contains("  ") && actual_message.ToLowerInvariant().Contains(s.ToLowerInvariant())) ||
            (s.Contains("  ") && Sanitize(Truncate2(actual_message).ToLowerInvariant()).Any(x => x.Contains(s.ToLowerInvariant()))) ||
            (s.Length > 3 && actual_message.ToLowerInvariant().Contains(string.Join("", s.ToLowerInvariant().Split(' ')))) ||
            (s.Length > 3 && Sanitize(s).Any(x => Truncate2(actual_message).ToLowerInvariant().Split(' ').Any(y => y.Length > 4 && (y.Contains(s) || y.Contains(x))))))
        {
            var warnings = player.Warnings;
            var message = "";

            if (warnings < WARNINGS - 1)
            {
      
                message = string.Format("", s, warnings + 1, (this.Final == Punishment.BAN ? "ban" : "kick"));
                warnings ++;
                Game.PlaySound("MenuCancel", new Vector2(0,0), 1f);
                Game.PlaySound("MenuOk", new Vector2(0,0), 1f);
                Game.PlaySound("MenuCancel", new Vector2(0,0), 1f);
                Random rnd = new Random();
                switch(rnd.Next(0,8))
                {
                   case 0:
                   Game.RunCommand("/msg It was the first warning for you! Don't write ''xd'' again! ["+warnings+"]");
                   break;
                   case 1:
                   Game.RunCommand("/msg ''xd's'' are not recommended on this server ["+warnings+"]");
                   break;
                   case 2:
                   Game.RunCommand("/msg Writing ''xd's'' is not recommended on this server ["+warnings+"]");
                   break;
                   case 3:
                   Game.RunCommand("/msg Don't write this again! ["+warnings+"]");
                   break;
                   case 4:
                   Game.RunCommand("/msg Don't write ''xd'' again! ["+warnings+"]");
                   break;
                   case 5:
                   Game.RunCommand("/msg You've got the first warning for ''xd'' ["+warnings+"]");
                   break;
                   case 6:
                   Game.RunCommand("/msg Only the Host can write this word ["+warnings+"]");
                   break;
                   case 7:
                   Game.RunCommand("/msg "+ua.User.Name+", this word is forbidden ["+warnings+"]");
                   break;
                }
            }
            else if (warnings == WARNINGS - 1)
            {
                message = string.Format("", s, (this.Final == Punishment.BAN ? "ban" : "kick")); 
                warnings ++;               
                Game.PlaySound("MenuCancel", new Vector2(0,0), 1f);
                Game.PlaySound("MenuOk", new Vector2(0,0), 1f);
                Game.PlaySound("MenuCancel", new Vector2(0,0), 1f);
                Random rnd = new Random();
                switch(rnd.Next(0,7))
                {
                   case 0:
                   Game.RunCommand("/msg It was the second and last warning! Don't write ''xd'' again, or you will be exiled! ["+warnings+"]");
                   break;
                   case 1:
                   Game.RunCommand("/msg If you will write ''xd'' again - you will be exiled! ["+warnings+"]");
                   break;
                   case 2:
                   Game.RunCommand("/msg This word is not allowed, so because of this you will be exiled after your next ''xd''! ["+warnings+"]");
                   break;
                   case 3:
                   Game.RunCommand("/msg Don't write ''xd'' again, or will be exiled! ["+warnings+"]");
                   break;
                   case 4:
                   Game.RunCommand("/msg Third ''xd'' will lead you to exile! ["+warnings+"]");
                   break;
                   case 5:
                   Game.RunCommand("/msg Only the Host can write this word ["+warnings+"]");
                   break;
                   case 6:
                   Game.RunCommand("/msg "+ua.User.Name+", second warning for you, before the exile! ["+warnings+"]");
                   break;
               }
            }         
            else if (warnings == WARNINGS)
            {
                Game.PlaySound("ChurchBell1", new Vector2(0,0), 1f);
                Random rnd = new Random();
                switch(rnd.Next(0,5))
                {
                   case 0:
                   Game.ShowChatMessage("Preparing for the exile...  [x]",new Color(250,125,0));
                   break;
                   case 1:
                   Game.ShowChatMessage("You didn't follow the rule, so get exile right now! [x]",new Color(250,125,0));
                   break;
                   case 2:
                   Game.ShowChatMessage("You will be added to the exiled-list [x]",new Color(250,125,0));
                   break;
                   case 3:
                   Game.ShowChatMessage("You didn't stop at the last warning, so you will be exiled [x]",new Color(250,125,0));
                   break;
                   case 4:
                   Game.ShowChatMessage(ua.User.Name+", you will be exiled from the server for non-compliance with the rule [x]",new Color(250,125,0));
                   break;
                }
                IObjectTimerTrigger t2 = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
                t2.SetIntervalTime(1000);
                t2.SetRepeatCount (1);
                t2.SetScriptMethod("rt1");
                t2.Trigger();
                IObjectTimerTrigger t3 = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
                t3.SetIntervalTime(2000);
                t3.SetRepeatCount (1);
                t3.SetScriptMethod("rt2");
                t3.Trigger();
                IObjectTimerTrigger t4 = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
                t4.SetIntervalTime(2950);
                t4.SetRepeatCount (1);
                t4.SetScriptMethod("rt3");
                t4.Trigger();
                var ip = ua.User.ConnectionIP;

                new Timers("Global").AddTimer(AddPunishmentDelay ? 3000 : 1, 1, (args) =>
                {
                    if (Game.GetActiveUsers().Any(u => u.ConnectionIP.Equals(ip)))
                        Game.RunCommand(this.Final == Punishment.BAN ? "/ban " : "/kick " + ua.User.Name);

                    else if (!Game.GetActiveUsers().Any(u => u.ConnectionIP.Equals(ip)))   
                    {
                        this.Log(ip, this.Final.ToString());
                    }
                        Game.RunCommand("/kick " + ua.User.Name);
                        Game.RunCommand("/kick " + ua.User.Name);
                        Game.RunCommand("/kick " + ua.User.Name);
                        Game.RunCommand("/kick " + ua.User.Name);
                        Game.RunCommand("/kick " + ua.User.Name);  
                        {
                           IObjectTimerTrigger t = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
                           t.SetIntervalTime(501);
                           t.SetRepeatCount (1);
                           t.SetScriptMethod("x");
                           t.Trigger();                         
                        }                                                                         
                  });
            }

            switch (ANNOUNCE_MESSAGES)
            {
                case true: 
                    if (message != "")
                        Game.ShowChatMessage(message, ChatMessageColor);

                    break;

                case false:
                    if (message != "")
                        Game.ShowChatMessage(message, ChatMessageColor, ua.User.UserIdentifier);

                    break;
            }
            player.Warnings = warnings;
            return;
        }
    }
} 

