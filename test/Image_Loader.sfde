//Default Constructors
/*		Image img = new Image(
								(Vector2)	Position,
								(Point)		Size,
								(bool)		BackGround,
								(string)	String Input								
							);
 */
//Script Notes:
/*		-Origin of the sprite is top left
 *
 *		-Larger images will take longer to load, recommended images sizes are 16x16 or any lower area
 *
 *		-The image converter was made quickly in python using PIL
 *
*/
//Image Functions:
/*		GetWorldPosition() 				- Sets the world position of the image
 *		SetWorldPosition(Vector2)		- Returns world position
 *
 *		SetFlip(Point) 					- Set flip on Horizontal and Vertical axes, 1 is normal, -1 is flipped
 *		GetFlip() 						- Returns flip Point
 *
 *		SetScale(float)					- Set image scale
 *		GetScale()						- Returns image scale
 *
 *		SetAngle(float)					- Set angle in radians of image, rotates by the top-left of image
 *		GetAngle()						- Returns angle in radians
 *
 *		SetFrame(int)					- Set the image's current frame
 *		GetFrame()						- Returns current frame
 *
 *		AnimStart(uint=0)				- Start image sequence animation, defaults to last time interval(ms) passes in
 *		AnimStop()						- Pause animation and stay on last frame
 *
 *		SetFrameData(string)			- Pass in new string data for image sequence
 *		GetFrameData()					- Returns string data for image sequence
 */

public class Image{
	//Image Details
	Point Size;
	float Scale = 1;
	bool BackGround = false;
	
	Vector2 Position = Vector2.Zero;
	Point Flip = new Point(1, 1);
	float Angle = 0;

	//Text Data To Be Parsed
	string[] Frames = null;
	int CurrentFrame = 0;
	
	//In-Game Objects To Show Image
	IObjectText[] Pixels = null;
	
	//Tracker For Updater
	Events.UpdateCallback Updater = null;
	uint IntervalTime = 20;
	
	public Image(Vector2 _pos, Point _size, bool _bg, string _input){
		Position = _pos;
		Size = _size;
		BackGround = _bg;
		Frames = _input.Split('_');
		
		CreateCanvas();
		SetFrame(0);
	}
	
	private void CreateCanvas(){
		
		//Cleanup old objects for forced canvas creation
		if(Pixels != null)
			foreach(IObject o in Pixels)
				o.Remove();
				
		//Spawn Pixels from top->bottom, left->right
		Pixels = new IObjectText[Size.X * Size.Y];
		
		uint create = 0;
		for(uint h = 0; h < Size.Y; h ++){
			
			for(uint w = 0;w < Size.X; w ++){
				Pixels[create] = (IObjectText)Game.CreateObject((BackGround) ? "BgText" : "Text", Position + (new Vector2(-1, 2) * Scale) + (new Vector2(w, -h) * Scale));
				Pixels[create].SetText(".");
				create ++;
			}
		}
	}
	
	public void AnimStart(uint _intervaltime = 0){
		
		if(_intervaltime != 0)
			IntervalTime = _intervaltime;
		
		//Safe check if already running
		AnimStop();
		Updater = Events.UpdateCallback.Start(Update, IntervalTime, 0);
	}
	
	public void AnimStop(){
		
		if(Updater != null){
			Updater.Stop();
			Updater = null;
		}
	}

	private void Update(float ellapsed){
		
		//Looper
		if(++ CurrentFrame >= Frames.Length)
			CurrentFrame = 0;
		
		SetFrame(CurrentFrame);
	}
	
	public void SetFrame(int frame){
		
		CurrentFrame = frame;
		
		//Clamp To Frames
		if(CurrentFrame >= Frames.Length){
			CurrentFrame = Frames.Length - 1;
			
		}else if(CurrentFrame < 0){
			CurrentFrame = 0;
		}
		
		//Within Proper Index		
		byte r = 0;
		byte g = 0;
		byte b = 0;
		
		int temp = 0;
		
		string[] Colours = Frames[CurrentFrame].Split('|');
		
		for(uint i = 0; i < ((Colours.Length < Pixels.Length) ? Colours.Length : Pixels.Length); i ++){
			Vector2 Pos = new Vector2((int)i % Size.X, (int)Math.Floor((double)i / Size.Y));	
			
			if(Flip.X == -1){
				Pos.X = (Size.X - 1) - Pos.X;
			}
			if(Flip.Y == -1){
				Pos.Y = (Size.Y - 1) - Pos.Y;
			}
			
			int index = (int)Pos.X + (int)(Pos.Y * Size.Y);
			
			if(Colours[i] == "="){
				Pixels[index].SetTextColor(new Color(r, g, b));
			
			//Assume Hex String
			}else{							

				try{
					temp = Convert.ToInt32(Colours[i], 16);
				}
				catch( ArgumentOutOfRangeException ){
					temp = 0xFFFFFF;
				}
				
				r = (byte)((temp >> 16) & 0xFF);
				g = (byte)((temp >> 8) & 0xFF);
				b = (byte)((temp >> 0) & 0xFF);
				
				if(Pixels[index] != null){
					Pixels[index].SetTextColor(new Color(r, g, b));
				}
			}
		}
	}

	public int GetFrame(){
		return CurrentFrame;
	}

	public void SetScale(float scale){
		
		foreach(IObjectText txt in Pixels)
			txt.SetTextScale(scale);
		
		Scale = scale;
		SetWorldPosition(Position);
	}

	public float GetScale(){
		return Scale;
	}

	public void SetWorldPosition(Vector2 pos){
		Position = pos;

		for(uint h = 0; h < Size.Y; h ++){
			
			for(uint w = 0; w < Size.X; w ++){
				Vector2 mov = Position;
				
				//Snap Text To Grid
				mov += (new Vector2(-1 * (float)Math.Cos(Angle), -1 * (float)Math.Sin(Angle)) * Scale);
				mov += (new Vector2(2 * (float)Math.Cos(Angle + MathHelper.PIOver2), 2 * (float)Math.Sin(Angle + MathHelper.PIOver2)) * Scale);
				
				//Relative Position For Pixels
				mov += (new Vector2(w * (float)Math.Cos(Angle), w * (float)Math.Sin(Angle)) * Scale);
				mov += (new Vector2(-h * (float)Math.Cos(Angle + MathHelper.PIOver2), -h * (float)Math.Sin(Angle + MathHelper.PIOver2)) * Scale);
				
				Pixels[w + h * Size.Y].SetWorldPosition(mov);
				Pixels[w + h * Size.Y].SetAngle(Angle);
			}
		}
	}
	
	public Vector2 GetWorldPosition(){
		return Position;
	}
	
	public void Remove(){
		
		foreach(IObject o in Pixels)
			o.Remove();
		
		Frames = null;
	}
	
	public void SetFrameData(string input){
		Frames = input.Split('_');
	}
	
	public string[] GetFrameData(){
		return Frames;
	}
	
	public void SetFlip(Point flip){
		
		if(Math.Abs(flip.X) == 1 && Math.Abs(flip.Y) == 1){
			Flip = flip;
			SetFrame(CurrentFrame);
		}
	}
	
	public Point GetFlip(){ 
		return Flip;
	}
	
	public void SetAngle(float angle){
		Angle = angle;
		SetWorldPosition(Position);
	}
	
	public float GetAngle(float angle){
		return Angle;
	}
}