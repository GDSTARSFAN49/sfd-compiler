///// GLADIATOR /////

IPlayer gladiator;
IProfile prfGladiator = new IProfile(), prfGladiatorR = new IProfile();
IObject arenaHitbox;
IObject[] arenaObj = new IObject[4], prisonObj = new IObject[4];
IObjectText prisonTxt;
int arenaDelay = 5, prisonDelay = 5;
bool[] moves28 = {true, true};

public void SpawnGladiator(IPlayer p) {
	gladiator = p;

	autoEquipped.Add(gladiator);

	gladiator.SetProfile(prfGladiator);
	gladiator.GiveWeaponItem(WeaponItem.MACHETE);
	CreateTimer(50, 0, "GladiatorTick", true);
}

public void GladiatorTick(TriggerArgs args) {
	MeleeWeaponItem melee = gladiator.CurrentMeleeWeapon;

	/// DEATHMATCH - START ///
	if(gladiator.IsMeleeAttacking && gladiator.IsWalking && moves28[0]) {
		arenaHitbox = CreateHitbox(gladiator.GetWorldPosition() + new Vector2(-36, 40), new Point(10, 6));
		moves28[0] = false;
	} else if(arenaDelay > 0 && !moves28[0]) {
		arenaHitbox.SetWorldPosition(gladiator.GetWorldPosition() + new Vector2(-36, 40));

		arenaDelay--;
		if(arenaDelay == 0) {
			gladiator.SetWorldPosition(gladiator.GetWorldPosition() + new Vector2(-20*gladiator.FacingDirection, 16));

			for(int i=0;i<2;i++) {
				arenaObj[i] = Game.CreateObject("Stone04B", gladiator.GetWorldPosition() + new Vector2(-48, 52 + (-64*i)));
				arenaObj[i].SetSizeFactor(new Point(7, 1));
			}

			for(int i=0;i<2;i++) {
				arenaObj[i+2] = Game.CreateObject("MetalBars00A", gladiator.GetWorldPosition() + new Vector2(-44 + (88*i), 40));
				arenaObj[i+2].SetSizeFactor(new Point(1, 6));
			}
			arenaObj[2].SetFaceDirection(-1);

			if(Array.Exists(Game.GetObjectsByArea(arenaHitbox.GetAABB()), o => prisonObj.Contains(o)))
				RemovePrison();

			foreach(IPlayer p in Game.GetObjectsByArea<IPlayer>(arenaHitbox.GetAABB())) {
				if(!IsOnSameTeam(p, gladiator)) {
					p.SetWorldPosition(gladiator.GetWorldPosition() + new Vector2(40*gladiator.FacingDirection, 0));
				} else if(p != gladiator && IsOnSameTeam(p, gladiator))
					p.SetWorldPosition(gladiator.GetWorldPosition());
				p.SetLinearVelocity(Vector2.Zero);
				
			}
			arenaHitbox.Remove();
			CreateTimer(10000, 1, "EndDeathmatch", true);
			
			PlayerModifiers mods = gladiator.GetModifiers();
			mods.MeleeDamageDealtModifier *= STRENGTH_2;
			mods.MeleeForceModifier *= STRENGTH_1;
			gladiator.SetProfile(prfGladiatorR);
			gladiator.SetModifiers(mods);
			gladiator.GiveWeaponItem(WeaponItem.MACHETE);

			Game.PlayEffect("CFTXT", gladiator.GetAABB().Center, "40 seconds until use.");
			CreateTimer(40000, 1, "GladiatorCD1", true);
		}
	}
	/// DEATHMATCH - END ///

	/// PRISON - START ///
	if(gladiator.IsBlocking && gladiator.IsWalking && moves28[1]) {
		Vector2 pos = gladiator.GetWorldPosition() + new Vector2(0, 8);
		prisonTxt = CreateText(pos, "! ! ! ! ! !", Color.Red, 3, (TextAlignment)(1-gladiator.FacingDirection));
		moves28[1] = false;
	} else if(prisonDelay > 0 && !moves28[1]) {
		prisonTxt.SetWorldPosition(gladiator.GetWorldPosition() + new Vector2(0, 8));
		prisonTxt.SetTextAlignment((TextAlignment)(1+(-1*gladiator.FacingDirection)));

		prisonDelay--;
		if(prisonDelay == 0) {
			for(int i=0;i<2;i++) {
				prisonObj[i] = Game.CreateObject("Stone04B", gladiator.GetWorldPosition() + new Vector2(gladiator.FacingDirection == 1 ? 20 : -52, 44 + (-40*i)));
				prisonObj[i].SetSizeFactor(new Point(3, 1)); 
			}

			for(int i=0;i<2;i++) {
				prisonObj[i+2] = Game.CreateObject("MetalBars00A", gladiator.GetWorldPosition() + new Vector2((24 + (24*i))*gladiator.FacingDirection, 32));
				prisonObj[i+2].SetSizeFactor(new Point(1, 3));
			}
			prisonObj[2].SetFaceDirection(-1);

			Area a = gladiator.GetAABB();
			a.Grow(26, 0);
			a.Move(new Vector2(26*gladiator.FacingDirection, 0));
			
			IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, gladiator));
			foreach(IPlayer p in foes) {
				p.SetWorldPosition(gladiator.GetWorldPosition() + new Vector2(36*gladiator.FacingDirection, 16));
				p.SetLinearVelocity(Vector2.Zero);
			}
			prisonTxt.Remove();
			CreateTimer(5000, 1, "RemovePrison", true);

			Game.PlayEffect("CFTXT", gladiator.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "GladiatorCD2", true);
		}
	} 
	/// PRISON - END ///

	/// PASSIVE: AUTO-EQUIP ///
	if(melee.WeaponItem == WeaponItem.NONE && !gladiator.IsDead)
		gladiator.GiveWeaponItem(WeaponItem.MACHETE);
}

public void EndDeathmatch(TriggerArgs args) {
	PlayerModifiers mods = gladiator.GetModifiers();
	mods.MeleeDamageDealtModifier /= STRENGTH_2;
	mods.MeleeForceModifier /= STRENGTH_1;
	gladiator.SetProfile(prfGladiator);
	gladiator.SetModifiers(mods);

	for(int i=0;i<arenaObj.Length;i++)
		arenaObj[i].Remove();
}

public void RemovePrison(TriggerArgs args=null) {
	for(int i=0;i<prisonObj.Length;i++)
		prisonObj[i].Remove();

	if(args != null) 
		((IObject)args.Caller).Remove();
}

public void GladiatorCD1(TriggerArgs args) {
	arenaDelay = 5;
	moves28[0] = true;
	Game.PlayEffect("CFTXT", gladiator.GetAABB().Center, "Deathmatch is ready!");
	((IObject)args.Caller).Remove();
}

public void GladiatorCD2(TriggerArgs args) {
	prisonDelay = 5;
	moves28[1] = true;
	Game.PlayEffect("CFTXT", gladiator.GetAABB().Center, "Prison is ready!");
	((IObject)args.Caller).Remove();
}










///// NINJA /////

IPlayer ninja;
List<IPlayer> shrouded = new List<IPlayer>();
IProfile prfNinja = new IProfile();
IObject hookObj;
IObjectAreaTrigger smokeArea;
IObjectTimerTrigger hookTimer;
int starCombo = 3;
bool[] moves29 = {true, true, true, true};

public void SpawnNinja(IPlayer p) {
	ninja = p;
	hookTimer = CreateTimer(250, 1, "RemoveHook");

	PlayerModifiers mods = p.GetModifiers();
	mods.RunSpeedModifier += FAST_1;
	mods.SprintSpeedModifier += FAST_1;

	ninja.SetProfile(prfNinja);
	ninja.SetModifiers(mods);
	CreateTimer(50, 0, "NinjaTick", true);
}

public void NinjaTick(TriggerArgs args) {
	/// DEADLY STARS - START ///
	if((ninja.IsMeleeAttacking || ninja.IsJumpAttacking) && ninja.IsWalking && moves29[0]) {
		for(int i=0;i<3;i++) {
			Vector2 pos = ninja.GetWorldPosition(), traj;
			int face = ninja.FacingDirection;
			float pi = (float)Math.PI;

			if(ninja.IsInMidAir)
				traj = new Vector2((float)Math.Cos(pi/4 + pi/16*(1-i)) * face, (float)Math.Sin(pi/4 + pi/16*(1-i)) * -1);
			else
				traj = new Vector2((float)Math.Cos(pi/36*(1-i)) * face, (float)Math.Sin(pi/36*(1-i)));

			IObjectWeaponItem star = (IObjectWeaponItem)Game.CreateObject("WpnShuriken", pos + new Vector2(8*face, 8));
			star.CustomID = "DStar";
			star.SetLinearVelocity(traj * 28);
			star.SetAngularVelocity(2*pi);
			star.SetMaxFire();
			star.TrackAsMissile(true);
			star.SetBreakOnDrop(true);
		}

		starCombo = 3;
		moves29[0] = false;
		Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "NinjaCD1", true);
	}
	/// DEADLY STARS - END ///

	/// GRAPPLING HOOK - START ///
	if((ninja.IsKicking || ninja.IsJumpKicking) && ninja.IsWalking && hookObj == null && moves29[1]) {
		hookObj = Game.CreateObject("BgChain00A", ninja.GetWorldPosition() + new Vector2(8*ninja.FacingDirection, 8));
		if(ninja.IsKicking)
			hookObj.SetAngle(ninja.FacingDirection == 1 ? 1.57f : 4.71f);
		else
			hookObj.SetAngle(ninja.FacingDirection == 1 ? 2.36f : 3.93f);
		hookObj.SetSizeFactor(new Point(1, 4));
		hookTimer.StartTimer();
	} else if(hookObj != null && hookTimer.IsTimerRunning) {
		IObject target = Array.Find(Game.GetObjectsByArea(hookObj.GetAABB()), o => {
			Area a = o.GetAABB();
			CollisionFilter cf = o.GetCollisionFilter();
			IPlayer p = o is IPlayer ? (IPlayer)o : ninja;

			bool cond1 = !IsOnSameTeam(p, ninja)  && !p.IsDiving && !p.IsRolling;
			bool cond2 = o.GetBodyType() == BodyType.Static && (cf.MaskBits == 53193 || cf.MaskBits == 61421) && !o.Name.Contains("Plat");

			return (cond1 || cond2) && IsInArea(hookObj, o);
		});
 
		if(target != null) {
			hookTimer.StopTimer();
			if(target is IPlayer)
				LaunchPlayer((IPlayer)target, (ninja.GetAABB().Center - target.GetAABB().Center) / 6.5f);
			else {
				Area a = Area.Intersect(target.GetAABB(), hookObj.GetAABB());
				ninja.SetWorldPosition(ninja.GetWorldPosition() + new Vector2(0, 4));
				ninja.SetLinearVelocity((a.Center - ninja.GetWorldPosition()) / 6);
			}
			RemoveHook();
		} else {
			hookObj.SetWorldPosition(ninja.GetWorldPosition() + new Vector2(8*ninja.FacingDirection, 8));
			hookObj.SetSizeFactor(new Point(1, hookObj.GetSizeFactor().Y + 2));
		}
	}
	/// GRAPPLING HOOK - END ///

	/// REVERSAL - START ///
	if(ninja.IsBlocking && ninja.IsWalking && moves29[2]) {
		Area a = ninja.GetAABB();
		a.Grow(8, 6);
		IPlayer target = Array.Find(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, ninja) && IsHostile(p));

		if(target != null && !target.IsRocketRiding) {
			StunPlayer(target, 1500);
			Game.PlayEffect("DIG", ninja.GetAABB().Center);
			ninja.SetWorldPosition(target.GetWorldPosition() + new Vector2(-12*target.FacingDirection, 0));

			ninja.SetInputEnabled(false);
			ninja.AddCommand(new PlayerCommand(PlayerCommandType.Grab, (PlayerCommandFaceDirection)target.FacingDirection));
			CreateTimer(200, 1, "EnableNinja", true);

			moves29[2] = false;
			Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "15 seconds until use.");
			CreateTimer(15000, 1, "NinjaCD3", true);
		} else {
			moves29[2] = false;
			Game.PlayEffect("CFTXT", ninja.GetAABB().Center + new Vector2(0, 4), "Counter failed!");
			Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "5 seconds until use.");
			CreateTimer(5000, 1, "NinjaCD3", true);
		}
	}
	/// REVERSAL - END //

	/// SMOKE BOMB - START ///
	if(ninja.IsCrouching && ninja.IsWalking && moves29[3]) {
		smokeArea = CreateArea(ninja.GetWorldPosition() + new Vector2(-56, 48), new Point(15, 8), "ShroudUp", "ShroudDown");
		CreateTimer(375, 24, "SmokeShroud", true);

		moves29[3] = false;
		Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "NinjaCD4", true);
	}
	/// SMOKE BOMB - END ///
}

public void RemoveHook(TriggerArgs args=null) {
	hookObj.Remove();
	hookObj = null;
	hookTimer.ResetTrigger();

	moves29[1] = false;
	Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "10 seconds until use.");
	CreateTimer(10000, 1, "NinjaCD2", true);
}

public void EnableNinja(TriggerArgs args) {
	ninja.SetInputEnabled(true);
	((IObject)args.Caller).Remove();
}

public void ShroudUp(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(IsOnSameTeam(p, ninja)) {
		shrouded.Add(p);
		p.SetNametagVisible(false);
		p.SetStatusBarsVisible(false);
	}
}

public void ShroudDown(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(shrouded.Contains(p)) {
		shrouded.Remove(p);
		p.SetNametagVisible(true);
		p.SetStatusBarsVisible(true);
	}
}

public void SmokeShroud(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	Area a = smokeArea.GetAABB();

	for(int i=0;i<a.Height/8;i++) {
		for(int j=0;j<a.Width/8;j++) {
			Game.PlayEffect("DIG", a.TopLeft + new Vector2(8*j, -8*i));
		}
	}

	if(!timer.IsTimerRunning) {
		shrouded.ForEach(p => {
			p.SetNametagVisible(true);
			p.SetStatusBarsVisible(true);
		});
		shrouded.Clear();
		smokeArea.Remove();
		((IObject)args.Caller).Remove();
	}
}

public void NinjaCD1(TriggerArgs args) {
	moves29[0] = true;
	Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "Deadly Stars is ready!");
	((IObject)args.Caller).Remove();
}

public void NinjaCD2(TriggerArgs args) {
	moves29[1] = true;
	Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "Grappling Hook is ready!");
	((IObject)args.Caller).Remove();
}

public void NinjaCD3(TriggerArgs args) {
	moves29[2] = true;
	Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "Reversal is ready!");
	((IObject)args.Caller).Remove();
}

public void NinjaCD4(TriggerArgs args) {
	moves29[3] = true;
	Game.PlayEffect("CFTXT", ninja.GetAABB().Center, "Smoke Bomb is ready!");
	((IObject)args.Caller).Remove();
}










///// NECROMANCER /////

IPlayer necro;
List<IPlayer> orcs = new List<IPlayer>(), goblins = new List<IPlayer>();
IProfile prfNecro = new IProfile(), prfOrc = new IProfile(), prfGoblin = new IProfile();
PlayerModifiers orcMods, goblinMods;
IObjectText[] runes = new IObjectText[3];
int runeCount = 0;
bool[] moves30 = {true, true, true, true};

public void SpawnNecromancer(IPlayer p) {
	necro = p;

	orcMods = p.GetModifiers();
	orcMods.MaxHealth += GIANT;
	orcMods.CurrentHealth = orcMods.MaxHealth;
	orcMods.MeleeDamageDealtModifier *= STRENGTH_2;
	orcMods.MeleeForceModifier *= STRENGTH_1;
	orcMods.SizeModifier = 1.25f;

	goblinMods = p.GetModifiers();
	goblinMods.MaxHealth -= GIANT;
	goblinMods.CurrentHealth = goblinMods.MaxHealth;
	goblinMods.MeleeDamageDealtModifier /= STRENGTH_1;
	goblinMods.RunSpeedModifier += FAST_1;
	goblinMods.SprintSpeedModifier += FAST_1;
	goblinMods.SizeModifier = 0.85f;

	necro.SetProfile(prfNecro);
	necro.SetTeam(necro.GetTeam() == PlayerTeam.Independent ? PlayerTeam.Team2 : necro.GetTeam());
	CreateTimer(50, 0, "NecromancerTick", true);
}

public void NecromancerTick(TriggerArgs args) {
	/// SUMMON: ORCS - START ///
	if(necro.IsMeleeAttacking && necro.IsWalking && moves30[0]) {
		for(int i=0;i<2;i++) {
			IPlayer orc = Game.CreatePlayer(necro.GetWorldPosition() + new Vector2((24 + (8*i))*necro.FacingDirection, 0));
			orcs.Add(orc);

			orc.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
			orc.SetProfile(prfOrc);
			orc.SetTeam(necro.GetTeam());
			orc.SetModifiers(orcMods);
			
			Game.PlayEffect("FIRE", orc.GetWorldPosition());
			Game.PlaySound("LogoSlam", orc.GetAABB().Center);
		}
		CreateTimer(10000, 1, "DestroyOrcs", true);
		
		moves30[0] = false;
		Game.PlayEffect("CFTXT", necro.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "NecromancerCD1", true);
	}
	/// SUMMON: ORCS - END ///

	/// RUNIC DETONATION - START ///
	if(necro.IsKicking && necro.IsWalking && runeCount > 0 && moves30[1]) {
		for(int i=0;i<runeCount;i++) {
			IObjectText rune = runes[i];
			Game.TriggerExplosion(rune.GetWorldPosition());
			Game.SpawnFireNodes(rune.GetWorldPosition(), 20, 4, FireNodeType.Flamethrower);

			Game.PlaySound("LogoSlam", rune.GetWorldPosition());
			rune.Remove();
		}

		runeCount = 0;
		moves30[1] = false;
		Game.PlayEffect("CFTXT", necro.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "NecromancerCD2", true);
	}
	/// RUNIC DETONATION - END ///

	/// SUMMON: GOBLINS - START ///
	if(necro.IsBlocking && necro.IsWalking && moves30[2]) {
		for(int i=0;i<3;i++) {
			IPlayer goblin = Game.CreatePlayer(necro.GetWorldPosition() + new Vector2((20 + (6*i))*necro.FacingDirection, 0));
			goblins.Add(goblin);

			goblin.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
			goblin.SetGuardTarget(necro);

			goblin.SetProfile(prfGoblin);
			goblin.SetTeam(necro.GetTeam());
			goblin.SetModifiers(goblinMods);

			Game.PlayEffect("FIRE", goblin.GetWorldPosition());
			Game.PlaySound("LogoSlam", goblin.GetAABB().Center);
		}

		moves30[2] = false;
		Game.PlayEffect("CFTXT", necro.GetAABB().Center, "15 seconds until use.");
		CreateTimer(20000, 1, "NecromancerCD3", true);
	}
	/// SUMMON: GOBLINS - END ///

	/// RUNIC DRAWING - START ///
	if(necro.IsCrouching && necro.IsWalking && runeCount != 3 && moves30[3]) {
		runes[runeCount] = (IObjectText)Game.CreateObject("BgText", necro.GetWorldPosition() + new Vector2(0, 8));
		runes[runeCount].SetText("Ø");
		runes[runeCount].SetTextScale(1.25f);
		runes[runeCount].SetTextAlignment(TextAlignment.Middle);
		runeCount++;
	
		moves30[3] = false;
		Game.PlayEffect("CFTXT", necro.GetAABB().Center, "1 seconds until use.");
		CreateTimer(1000, 1, "NecromancerCD4", true);
	}
	/// RUNIC CIRCLE - END ///

	/// REMOVING DEAD GOBLINS ///
	for(int i=0;i<goblins.Count;i++) {
		if(goblins[i].IsDead) {
			goblins[i].Remove();
			goblins.Remove(goblins[i]);
		}
	}

	if(goblins.Count > 0 && goblins[0].GetTeam() != necro.GetTeam())
		goblins.ForEach(p => p.SetTeam(necro.GetTeam()));

	if(orcs.Count > 0 && orcs[0].GetTeam() != necro.GetTeam())
		orcs.ForEach(p => p.SetTeam(necro.GetTeam()));
}

public void DestroyOrcs(TriggerArgs args) {
	for(int i=0;i<orcs.Count;i++) {
		if(!orcs[i].IsRemoved) {
			Vector2 pos = orcs[i].GetAABB().Center;
			orcs[i].Gib();
			Game.TriggerExplosion(pos);
		}
	}
	orcs.Clear();
}

public void NecromancerCD1(TriggerArgs args) {
	moves30[0] = true;
	Game.PlayEffect("CFTXT", necro.GetAABB().Center, "Summon: Orcs is ready!");
	((IObject)args.Caller).Remove();
}

public void NecromancerCD2(TriggerArgs args) {
	moves30[1] = true;
	Game.PlayEffect("CFTXT", necro.GetAABB().Center, "Runic Detonation is ready!");
	((IObject)args.Caller).Remove();
}

public void NecromancerCD3(TriggerArgs args) {
	moves30[2] = true;
	Game.PlayEffect("CFTXT", necro.GetAABB().Center, "Summon: Goblins is ready!");
	((IObject)args.Caller).Remove();
}

public void NecromancerCD4(TriggerArgs args) {
	moves30[3] = true;
	Game.PlayEffect("CFTXT", necro.GetAABB().Center, "Runic Drawing is ready!");
	((IObject)args.Caller).Remove();
}










///// VAMPIRE /////

IPlayer vampire;
IProfile prfVampire = new IProfile(), prfBeast = new IProfile();
float vampRange = 16, flyAmp = 1;
bool[] moves31 = {true, true};

public void SpawnVampire(IPlayer p) {
	vampire = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.RunSpeedModifier += FAST_1;
	mods.RunSpeedModifier += FAST_1;

	vampire.SetProfile(prfVampire);
	vampire.SetModifiers(mods);
	CreateTimer(50, 0, "VampireTick", true);
}

public void VampireTick(TriggerArgs args) {
	/// VAMPIRIC BEAST - START ///
	if(vampire.IsMeleeAttacking && vampire.IsWalking && moves31[0]) {
		PlayerModifiers mods = vampire.GetModifiers();
		mods.MaxHealth += GIANT;
		mods.CurrentHealth += GIANT;
		mods.MeleeDamageDealtModifier *= STRENGTH_2;
		mods.MeleeForceModifier *= STRENGTH_1;
		mods.SizeModifier += 0.25f;
		vampRange = 32;
		flyAmp = 1.5f;

		vampire.SetProfile(prfBeast);
		vampire.SetModifiers(mods);
		CreateTimer(12000, 1, "EndBeast", true);

		moves31[0] = false;
		Game.PlayEffect("CFTXT", vampire.GetAABB().Center, "60 seconds until use.");
		CreateTimer(60000, 1, "VampireCD1", true);
	}
	/// VAMPIRIC BEAST - END ///
}

public void EndBeast(TriggerArgs args) {
	PlayerModifiers mods = vampire.GetModifiers();
	mods.MaxHealth -= GIANT;
	mods.CurrentHealth *= 0.6f;
	mods.MeleeDamageDealtModifier /= STRENGTH_2;
	mods.MeleeForceModifier /= STRENGTH_1;
	mods.SizeModifier -= 0.25f;
	vampRange = 16;
	flyAmp = 1;

	vampire.SetProfile(prfVampire);
	vampire.SetModifiers(mods);
}

public void VampireCD1(TriggerArgs args) {
	moves31[0] = true;
	Game.PlayEffect("CFTXT", vampire.GetAABB().Center, "Vampiric Beast is ready!");
	((IObject)args.Caller).Remove();
}

public void VampireCD2(TriggerArgs args) {
	moves31[1] = true;
	((IObject)args.Caller).Remove();
}










///// SLENDERMAN /////

IPlayer slender, mimicked;
List<IPlayer> illusions = new List<IPlayer>(), distortions = new List<IPlayer>();
IProfile prfSlender = new IProfile();
IObject shroudObj;
bool disguiseOn = false;
bool[] moves32 = {true, true, true, true};

public void SpawnSlenderman(IPlayer p) {
	slender = p;
	slender.SetProfile(prfSlender);
	slender.SetTeam(slender.GetTeam() == PlayerTeam.Independent ? PlayerTeam.Team1 : slender.GetTeam());
	CreateTimer(50, 0, "SlendermanTick", true);
}

public void SlendermanTick(TriggerArgs args) {
	/// PARANOIA - START ///
	if(slender.IsMeleeAttacking && slender.IsWalking && moves32[0]) {
		Area mapArea = Game.GetCameraMaxArea();
		mapArea.TopRight += new Vector2(8 - (mapArea.TopRight.X % 8), 8 - (mapArea.TopRight.Y % 8));
		mapArea.BottomLeft += new Vector2((mapArea.BottomLeft.X*-1 % 8) - 8, (mapArea.BottomLeft.Y*-1 % 8) - 8);
		
		shroudObj = Game.CreateObject("FarBgShadow00A", mapArea.TopLeft + new Vector2(4, -4));
		shroudObj.SetSizeFactor(new Point(((int)mapArea.Width) / 8, ((int)mapArea.Height) / 8));

		PlayerModifiers mods = slender.GetModifiers();
		mods.CurrentHealth = mods.MaxHealth;
		mods.MeleeDamageDealtModifier *= 0;
		mods.MeleeForceModifier *= 0;
		mods.MeleeStunImmunity = 1;

		for(int i=0;i<3;i++) {
			IPlayer illusion = Game.CreatePlayer(slender.GetWorldPosition() + new Vector2((12 + (12*i))*slender.FacingDirection, 0));
			illusions.Add(illusion);

			illusion.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
			illusion.SetNametagVisible(false);
			illusion.SetStatusBarsVisible(false);

			illusion.SetProfile(prfSlender);
			illusion.SetTeam(slender.GetTeam());
			illusion.SetModifiers(mods);
			
			Game.PlaySound("LogoSlam", illusion.GetAABB().Center);
		}
		slender.SetNametagVisible(false);
		slender.SetStatusBarsVisible(false);
		CreateTimer(10000, 1, "EndParanoia", true);

		moves32[0] = false;
		Game.PlayEffect("CFTXT", slender.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "SlendermanCD1", true);
	}
	/// PARANOIA - END ///

	/// DISTORTION - START ///
	if(slender.IsKicking && slender.IsWalking && moves32[1]) {
		Area a = slender.GetAABB();
		a.Grow(40, 38);
		Vector2 pos = slender.GetAABB().Center;

		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, slender) && !p.IsDead);
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).Last();

		if(target != null) {
			PlayerModifiers mods = target.GetModifiers();
			mods.MaxHealth /= 5;
			mods.CurrentHealth = mods.MaxHealth;
			mods.ExplosionDamageTakenModifier = 1/2f;
			mods.FireDamageTakenModifier = 1/3f;
			mods.MeleeDamageTakenModifier = 1;
			mods.ImpactDamageTakenModifier = 1;
			mods.ProjectileDamageTakenModifier = 1;
			mods.ProjectileCritChanceTakenModifier = 1;
			mods.MeleeDamageDealtModifier *= 0.5f;
			mods.MeleeForceModifier *= 0.5f;
			mods.MeleeStunImmunity = 0;

			for(int i=0;i<4;i++) {
				IPlayer distortion = Game.CreatePlayer(target.GetWorldPosition() + new Vector2(-12 + (8*i), 0));
				distortions.Add(distortion);

				distortion.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
				distortion.SetNametagVisible(false);
				distortion.SetStatusBarsVisible(false);

				distortion.SetProfile(target.GetProfile());
				distortion.SetTeam(slender.GetTeam());
				distortion.SetModifiers(mods);
			
				Game.PlaySound("LogoSlam", distortion.GetAABB().Center);
			}

			moves32[1] = false;
			Game.PlayEffect("CFTXT", slender.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "SlendermanCD2", true);
		}
	}
	/// DISTORTION - END ///

	/// TELEPORT: FORWARD - START ///
	if(slender.IsBlocking && slender.GetEnergy() >= 15 && slender.IsWalking && moves32[2]) {
		Area a = slender.GetAABB();
		a.Grow(-4, -6);
		a.Move(new Vector2(80*slender.FacingDirection, 0));
		
		if(!Array.Exists(Game.GetObjectsByArea(a), o => !(o is IPlayer) && o.GetCollisionFilter().MaskBits == 0xEFED && o.GetSize().Y >= 16)) {
			slender.SetWorldPosition(slender.GetWorldPosition() + new Vector2(80*slender.FacingDirection, 0));
			PlayerModifiers mods = slender.GetModifiers();
			mods.CurrentEnergy -= mods.CurrentEnergy > 20 ? 20 : mods.CurrentEnergy;
			slender.SetModifiers(mods);
			Game.PlaySound("LogoSlam", a.Center, 1/3f);
		}

		moves32[2] = false;
		CreateTimer(500, 1, "SlendermanCD3", true);
	}
	/// TELEPORT: FORWARD - END ///

	/// DISGUISE - START ///
	if(slender.IsCrouching && slender.IsWalking && !disguiseOn && moves32[3]) {
		Area a = slender.GetAABB();
		a.Grow(40, 38);

		mimicked = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, slender) && !p.IsDead);
		if(foes.Length != 0)
			mimicked = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, a.Center)).Last();

		if(mimicked != null) {
			PlayerModifiers mods = slender.GetModifiers();
			mods.ExplosionDamageTakenModifier *= 1/3f;
			mods.ProjectileDamageTakenModifier *= 1/3f;
			mods.ProjectileCritChanceTakenModifier *= 1/3f;
			mods.FireDamageTakenModifier *= 1/3f;
			mods.MeleeDamageTakenModifier *= 1/3f;
			mods.ImpactDamageTakenModifier *= 1/3f;

			slender.SetProfile(mimicked.GetProfile());
			slender.SetModifiers(mods);
			slender.SetNametagVisible(false);
			mimicked.SetNametagVisible(false);

			disguiseOn = true;
			moves32[3] = false;
			Game.PlayEffect("CFTXT", slender.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "SlendermanCD4", true);
		}
	}
	/// DISGUISE - END ///

	/// DISTORTION: REMOVAL ///
	distortions.RemoveAll(e => {
		if(e.IsDead && !e.IsRemoved)
			e.Remove();
		return e.IsDead;
	});

	if(illusions.Count > 0 && illusions[0].GetTeam() != slender.GetTeam())
		illusions.ForEach(p => p.SetTeam(slender.GetTeam()));

	if(distortions.Count > 0 && distortions[0].GetTeam() != slender.GetTeam())
		distortions.ForEach(p => p.SetTeam(slender.GetTeam()));
}

public void EndParanoia(TriggerArgs args) {
	shroudObj.Remove();
	for(int i=0;i<3;i++) {
		if(!illusions[i].IsRemoved)
			illusions[i].Remove();
	}
	illusions.Clear();
	slender.SetNametagVisible(true);
	slender.SetStatusBarsVisible(true);
}

public void SlendermanCD1(TriggerArgs args) {
	moves32[0] = true;
	Game.PlayEffect("CFTXT", slender.GetAABB().Center, "Paranoia is ready!");
	((IObject)args.Caller).Remove();
}

public void SlendermanCD2(TriggerArgs args) {
	moves32[1] = true;
	Game.PlayEffect("CFTXT", slender.GetAABB().Center, "Distortion is ready!");
	((IObject)args.Caller).Remove();
}

public void SlendermanCD3(TriggerArgs args) {
	moves32[2] = true;
	((IObject)args.Caller).Remove();
}

public void SlendermanCD4(TriggerArgs args) {
	moves32[3] = true;
	Game.PlayEffect("CFTXT", slender.GetAABB().Center, "Disguise is ready!");
	((IObject)args.Caller).Remove();
}










///// BOMBERMAN /////

IPlayer bomber;
IProfile prfBomberLv1 = new IProfile(), prfBomberLv2 = new IProfile(), prfBomberLv3 = new IProfile();
IObjectTimerTrigger chargeTimer;
int bomberLvl = 1;
bool[] moves33 = {true, true};

public void SpawnBomberman(IPlayer p) {
	bomber = p;

	CollisionFilter cf = p.GetCollisionFilter();
	cf.BlockExplosions = true;

	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier = 0;
	mods.FireDamageTakenModifier = 0;
	mods.MeleeDamageTakenModifier *= FRAGILE;
	mods.ImpactDamageTakenModifier = 0;
	mods.ProjectileDamageTakenModifier *= FRAGILE;
	mods.ProjectileCritChanceTakenModifier *= FRAGILE;
	mods.CanBurn = 0;

	chargeTimer = CreateTimer(15000, 0, "LvlCharge");

	bomber.SetCollisionFilter(cf);
	bomber.SetProfile(prfBomberLv1);
	bomber.SetModifiers(mods);
	CreateTimer(50, 0, "BombermanTick", true);
}

public void BombermanTick(TriggerArgs args) {
	if(bomber.IsInputEnabled && !chargeTimer.IsTimerRunning)
		chargeTimer.Trigger();

	/// SELF-DESTRUCT - START ///
	if((bomber.IsMeleeAttacking || bomber.IsJumpAttacking) && bomber.IsWalking && moves33[0]) {
		Vector2 pos = bomber.GetAABB().Center;
		Vector2[] circle;
		float pi = (float)Math.PI;

		circle = V2Circle(5, 20, pi/4);
		for(int i=0;i<5;i++)
			Game.TriggerExplosion(pos + circle[i]);

		if(bomberLvl >= 2) {
			circle = V2Circle(10, 40, pi/4);
			for(int i=0;i<10;i++)
				Game.TriggerExplosion(pos + circle[i]);
		}
		
		if(bomberLvl == 3) {
			circle = V2Circle(15, 60, pi/4);
			for(int i=0;i<15;i++)
				Game.TriggerExplosion(pos + circle[i]);
		}

		bomber.SetProfile(prfBomberLv1);
		CreateTimer(25 * (bomberLvl+1), 1, "ResetVelocity", true);

		bomberLvl = 1;
		chargeTimer.StopTimer();
		chargeTimer.ResetTrigger();
		chargeTimer.StartTimer();

		moves33[0] = false;
		Game.PlayEffect("CFTXT", bomber.GetAABB().Center, "5 seconds until use.");
		CreateTimer(5000, 1, "BombermanCD1", true);
	}
	/// SELF-DESTRUCT - END ///

	/// BARREL BOMBARDMENT - START ///
	if(bomber.IsBlocking && bomber.IsWalking && moves33[1]) {
		for(int i=0;i<2;i++) {
			Game.CreateObject("BarrelExplosive", bomber.GetWorldPosition() + new Vector2(40 + (32*i), 4)).SetMaxFire();
			Game.CreateObject("BarrelExplosive", bomber.GetWorldPosition() + new Vector2(-40 + (-32*i), 4)).SetMaxFire();
		}

		moves33[1] = false;
		Game.PlayEffect("CFTXT", bomber.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "BombermanCD2", true);
	}
	/// BARREL BOMBARDMENT - END ///
}

public void LvlCharge(TriggerArgs args) {
	if(bomberLvl < 3) {
		bomber.SetProfile(bomberLvl == 1 ? prfBomberLv2 : prfBomberLv3);
		Game.PlayEffect("CFTXT", bomber.GetAABB().Center, "POWER INCREASED!!");
		bomberLvl++;
	}
}

public void ResetVelocity(TriggerArgs args) {
	bomber.SetLinearVelocity(Vector2.Zero);
}

public void BombermanCD1(TriggerArgs args) {
	moves33[0] = true;
	Game.PlayEffect("CFTXT", bomber.GetAABB().Center, "Self-Destruct is ready!");
	((IObject)args.Caller).Remove();
}

public void BombermanCD2(TriggerArgs args) {
	moves33[1] = true;
	Game.PlayEffect("CFTXT", bomber.GetAABB().Center, "Barrel Bombardment is ready!");
	((IObject)args.Caller).Remove();
}










///// PARASITE /////

IPlayer parasite;
IProfile prfParasite = new IProfile();

public void SpawnParasite(IPlayer p) {
	parasite = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.RunSpeedModifier += FAST_1;
	mods.RunSpeedModifier += FAST_1;

	parasite.SetProfile(prfParasite);
	parasite.SetModifiers(mods);
	CreateTimer(50, 0, "ParasiteTick", true);
}

public void ParasiteTick(TriggerArgs args) {
	/// PASSIVE: POSSESSION ///
	if(parasite.IsHoldingPlayerInGrab) {
		IPlayer p = Game.GetPlayer(parasite.HoldingPlayerInGrabID); // The player to possess
		float hpReturn = parasite.GetHealth() / 2;

		if(!p.IsDead && p.GetHealth() <= p.GetMaxHealth()/2 && !p.IsBot) {
			p.SetTeam(parasite.GetTeam() == PlayerTeam.Independent ? p.GetTeam() : parasite.GetTeam());

			IUser u = p.GetUser();
			p.SetUser(parasite.GetUser());
			parasite.SetUser(u);

			parasite.Remove();
			parasite = p;
		} else if(p.IsDead && !p.IsBot && (parasite.GetTeam() == PlayerTeam.Independent || p.GetTeam() != parasite.GetTeam())) {
			int i = activeCharacters[p.UniqueID];
			SpawnCharacter(i, parasite);
			p.Remove();
		}

		PlayerModifiers mods = parasite.GetModifiers();
		mods.CurrentHealth = mods.MaxHealth / 2 + hpReturn;
		parasite.SetModifiers(mods);
	}
}










///// WARRIOR /////

IPlayer warrior;
IProfile prfWarrior = new IProfile(), prfWarriorStr = new IProfile(), prfWarriorDef = new IProfile();
bool atkMode = false, defMode = false;
bool[] moves35 = {true, true};

public void SpawnWarrior(IPlayer p) {
	warrior = p;
	autoEquipped.Add(warrior);
	warrior.SetProfile(prfWarrior);
	warrior.GiveWeaponItem(WeaponItem.KATANA);
	CreateTimer(50, 0, "WarriorTick", true);
}

public void WarriorTick(TriggerArgs args) {
	MeleeWeaponItem melee = warrior.CurrentMeleeWeapon;

	/// STANCE: ATTACK - START ///
	if(warrior.IsMeleeAttacking && warrior.IsWalking && !atkMode && moves35[0]) {
		PlayerModifiers mods = warrior.GetModifiers();

		if(defMode) {
			mods.ExplosionDamageTakenModifier /= TANK;
			mods.ProjectileDamageTakenModifier /= TANK;
			mods.FireDamageTakenModifier /= TANK;
			mods.MeleeDamageTakenModifier /= TANK;
			mods.ImpactDamageTakenModifier /= TANK;
			mods.MeleeDamageDealtModifier *= STRENGTH_1;
			mods.RunSpeedModifier -= SLOW;
			mods.SprintSpeedModifier -= SLOW;
		}

		mods.ExplosionDamageTakenModifier *= FRAGILE;
		mods.ProjectileDamageTakenModifier *= FRAGILE;
		mods.FireDamageTakenModifier *= FRAGILE;
		mods.MeleeDamageTakenModifier *= FRAGILE;
		mods.ImpactDamageTakenModifier *= FRAGILE;
		mods.MeleeDamageDealtModifier *= STRENGTH_1;
		mods.RunSpeedModifier += FAST_2;
		mods.SprintSpeedModifier += FAST_2;
		
		warrior.SetProfile(prfWarriorStr);
		warrior.SetModifiers(mods);
		atkMode = true;
		defMode = false;
		Game.CreateDialogue("ATTACK!!", new Color(85, 85, 85), warrior, "", 600, false);

		moves35[0] = false;
		Game.PlayEffect("CFTXT", warrior.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "WarriorCD1", true);
	}
	/// STANCE: ATTACK - END ///

	/// STANCE: DEFENSE - START ///
	if(warrior.IsBlocking && warrior.IsWalking && !defMode && moves35[0]) {
		PlayerModifiers mods = warrior.GetModifiers();

		if(atkMode) {
			mods.ExplosionDamageTakenModifier /= FRAGILE;
			mods.ProjectileDamageTakenModifier /= FRAGILE;
			mods.FireDamageTakenModifier /= FRAGILE;
			mods.MeleeDamageTakenModifier /= FRAGILE;
			mods.ImpactDamageTakenModifier /= FRAGILE;
			mods.MeleeDamageDealtModifier /= STRENGTH_1;
			mods.RunSpeedModifier -= FAST_2;
			mods.SprintSpeedModifier -= FAST_2;
		}

		mods.ExplosionDamageTakenModifier *= TANK;
		mods.ProjectileDamageTakenModifier *= TANK;
		mods.FireDamageTakenModifier *= TANK;
		mods.MeleeDamageTakenModifier *= TANK;
		mods.ImpactDamageTakenModifier *= TANK;
		mods.MeleeDamageDealtModifier /= STRENGTH_1;
		mods.RunSpeedModifier += SLOW;
		mods.SprintSpeedModifier += SLOW;

		warrior.SetProfile(prfWarriorDef);
		warrior.SetModifiers(mods);
		atkMode = false;
		defMode = true;
		Game.CreateDialogue("DEFEND!!", new Color(85, 85, 85), warrior, "", 600, false);

		moves35[0] = false;
		Game.PlayEffect("CFTXT", warrior.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "WarriorCD1", true);
	}
	/// STANCE: DEFENSE - END ///

	/// STANCE: NORMAL - START ///
	if(warrior.IsCrouching && warrior.IsWalking && (defMode || atkMode) && moves35[0]) {
		PlayerModifiers mods = warrior.GetModifiers();

		if(atkMode) {
			mods.ExplosionDamageTakenModifier /= FRAGILE;
			mods.ProjectileDamageTakenModifier /= FRAGILE;
			mods.FireDamageTakenModifier /= FRAGILE;
			mods.MeleeDamageTakenModifier /= FRAGILE;
			mods.ImpactDamageTakenModifier /= FRAGILE;
			mods.MeleeDamageDealtModifier /= STRENGTH_1;
			mods.RunSpeedModifier -= FAST_2;
			mods.SprintSpeedModifier -= FAST_2;
		} else if(defMode) {
			mods.ExplosionDamageTakenModifier /= TANK;
			mods.ProjectileDamageTakenModifier /= TANK;
			mods.FireDamageTakenModifier /= TANK;
			mods.MeleeDamageTakenModifier /= TANK;
			mods.ImpactDamageTakenModifier /= TANK;
			mods.MeleeDamageDealtModifier *= STRENGTH_1;
			mods.RunSpeedModifier -= SLOW;
			mods.SprintSpeedModifier -= SLOW;
		}

		warrior.SetProfile(prfWarrior);
		warrior.SetModifiers(mods);
		atkMode = false;
		defMode = false;
		Game.CreateDialogue("NEUTRAL!!", new Color(85, 85, 85), warrior, "", 600, false);

		moves35[0] = false;
		Game.PlayEffect("CFTXT", warrior.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "WarriorCD1", true);
	}
	/// STANCE: NORMAL - END ///

	/// FLIP - START ///
	if(warrior.IsRolling && warrior.IsWalking && warrior.GetEnergy() >= 10 && moves35[1]) {
		warrior.SetWorldPosition(warrior.GetWorldPosition() + new Vector2(0, 4));
		warrior.SetLinearVelocity(new Vector2(4.5f*warrior.FacingDirection, 9));

		PlayerModifiers mods = warrior.GetModifiers();
		mods.CurrentEnergy -= mods.CurrentEnergy > 15 ? 15 : mods.CurrentEnergy;
		warrior.SetModifiers(mods);

		moves35[1] = false;
		CreateTimer(500, 1, "WarriorCD2", true);
	}
	/// FLIP - END ///

	/// PASSIVE: AUTO-EQUIP ///
	if(melee.WeaponItem == WeaponItem.NONE && !warrior.IsDead)
		warrior.GiveWeaponItem(WeaponItem.KATANA);
}

public void WarriorCD1(TriggerArgs args) {
	moves35[0] = true;
	Game.PlayEffect("CFTXT", warrior.GetAABB().Center, "Stance is ready!");
	((IObject)args.Caller).Remove();
}

public void WarriorCD2(TriggerArgs args) {
	moves35[1] = true;
	((IObject)args.Caller).Remove();
}










///// SANS /////

IPlayer sans;
IProfile prfSans = new IProfile();
PlayerModifiers sansMods;
bool[] moves36 = {true, true, true, true};

IPlayer blue = null;
List<IPlayer> boned = new List<IPlayer>();
List<IObject[]> bones = new List<IObject[]>();
List<IObject[]> gasters = new List<IObject[]>();
List<IObjectTimerTrigger> gasterTimers = new List<IObjectTimerTrigger>();
List<IObjectAreaTrigger> boneArea = new List<IObjectAreaTrigger>();
IObjectText soulTxt, boneTxt;
VirtualKey blueKey = VirtualKey.NONE;
int boneIndex = 0;

public void SpawnSans(IPlayer p) {
	sans = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth = 1;
	mods.CurrentHealth = 1;
	mods.ExplosionDamageTakenModifier = 0;
	mods.ProjectileDamageTakenModifier = 0;
	mods.FireDamageTakenModifier = 0;
	mods.MeleeDamageTakenModifier = 0;
	mods.ImpactDamageTakenModifier = 0;
	mods.MeleeDamageDealtModifier = 1/8.5f;
	mods.CanBurn = 0;
	mods.EnergyConsumptionModifier = 0.1f;
	mods.EnergyRechargeModifier = 0.1f;
	sansMods = mods;

	sans.SetProfile(prfSans);
	sans.SetModifiers(mods);
	CreateTimer(50, 0, "SansTick", true);
}

public void SansTick(TriggerArgs args) {
	/// BONES - START ///
	if(sans.IsMeleeAttacking && sans.IsWalking && sans.GetEnergy() >= 4 && moves36[0]) {
		Area a = sans.GetAABB();
		a.Grow(72, 70);
		Vector2 pos = sans.GetAABB().Center;

		boneTxt = CreateText(pos + new Vector2(44*sans.FacingDirection, 2), "[  !  ]", Color.Red, 8/3f, TextAlignment.Middle);

		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, sans) && p.IsOnGround && !p.IsDead);
		if(foes.Length != 0) {
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).Last();
			pos = target.GetAABB().Center;
			boneTxt.SetWorldPosition(pos + new Vector2(0, 2));
		}
		Game.PlaySound("StreetsweeperSelfDestructBeep", pos, 0.1f);
		CreateTimer(375, 1, "CreateBones", true);
		
		PlayerModifiers mods = sans.GetModifiers();
		mods.CurrentEnergy -= mods.CurrentEnergy > 6 ? 6 : mods.CurrentEnergy;
		sans.SetModifiers(mods);

		moves36[0] = false;
		CreateTimer(500, 1, "SansCD1", true);
	}
	/// BONES - START ///

	/// GASTER BLASTER - START ///
	if(sans.IsKicking && sans.IsWalking && sans.GetEnergy() >= 6 && moves36[1]) {
		Area a = sans.GetAABB();
		a.Grow(112, 110);
		Vector2 pos = sans.GetAABB().Center;

		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, sans) && !p.IsDead);
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).Last();
		pos += new Vector2(0, 26);

		if(target != null) {
			Vector2 dist = target.GetAABB().Center - pos;
			float angle = (float)Math.Atan2(dist.X, -1*dist.Y);
			SpawnGBlaster(pos, angle);

			PlayerModifiers mods = sans.GetModifiers();
			mods.CurrentEnergy -= mods.CurrentEnergy > 8 ? 8 : mods.CurrentEnergy;
			sans.SetModifiers(mods);

			moves36[1] = false;
			CreateTimer(500, 1, "SansCD2", true);
		}
	}
	/// GASTER BLASTER - END ///

	/// BLUE SOUL - START ///
	if(sans.IsBlocking && sans.IsWalking && sans.GetEnergy() >= 8 && moves36[2]) {
		Area a = sans.GetAABB();
		a.Grow(56, 54);
		Vector2 pos = sans.GetAABB().Center;

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, sans) && !p.IsDead);
		if(foes.Length != 0)
			blue = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).Last();

		if(blue != null) {
			soulTxt = CreateText(blue.GetAABB().Center + new Vector2(0, 2), "<O>", Color.Cyan, 1.5f, TextAlignment.Middle);
			sans.SetInputMode(PlayerInputMode.ReadOnly);
			moves36[2] = false;
		}
	} else if(blueKey != VirtualKey.NONE && !moves36[2]) {
		if(blue.IsOnGround)
			blue.SetWorldPosition(blue.GetWorldPosition() + new Vector2(0, 4));

		int x = (int)blueKey;
		if(x <= 1)
			blue.SetLinearVelocity(new Vector2(0, x == 0 ? 12 : -12));
		else
			blue.SetLinearVelocity(new Vector2(x == 2 ? -12 : 12, 1.5f));

		blue = null;
		blueKey = VirtualKey.NONE;
		soulTxt.Remove();
		CreateTimer(100, 1, "EnableSans", true);

		PlayerModifiers mods = sans.GetModifiers();
		mods.CurrentEnergy -= mods.CurrentEnergy > 10 ? 10 : mods.CurrentEnergy;
		sans.SetModifiers(mods);

		CreateTimer(500, 1, "SansCD3", true);
	}
	/// BLUE SOUL - END ///

	/// BLUE SOUL: ACTIVE ///
	if(blue != null && !blue.IsDead)
		soulTxt.SetWorldPosition(blue.GetAABB().Center + new Vector2(0, 2));
	else if(blue != null && (blue.IsDead || sans.IsDead)) {
		blue = null;
		soulTxt.Remove();
		sans.SetInputMode(PlayerInputMode.Enabled);
		moves36[2] = true;
	}

	/// DODGE - START ///
	if(!IsHostile(sans) && !sans.IsDead && sans.IsWalking && sans.GetEnergy() >= 2 && moves36[2] && moves36[3]) {
		Area a = sans.GetAABB();
		a.Grow(8, 6);
		Vector2 pos = a.Center;
		IObject target = null;

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, sans) && IsHostile(p));
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).First();
		
		a.Grow(8, 8);
		IObject[] missiles = Array.FindAll(Game.GetObjectsByArea(a), o => o.IsMissile);
		if(missiles.Length != 0)
			target = Enumerable.OrderByDescending(missiles, o => Vector2.Distance(o.GetAABB().Center, pos)).First();

		if(target != null) {
			(a = target.GetAABB()).Move(new Vector2(-10*target.GetFaceDirection(), 0));
			if(!Array.Exists(Game.GetObjectsByArea(a), o => !(o is IPlayer) && IsWall(o))) {
				if(target is IPlayer) {
					sans.SetWorldPosition(target.GetWorldPosition() + new Vector2(-20*target.GetFaceDirection(), 0));
					StunPlayer((IPlayer)target, 500, false);
				} else {
					int move = Math.Sign(target.GetLinearVelocity().X);
					sans.SetWorldPosition(new Vector2(target.GetWorldPosition().X + -16*(move == 0 ? 1 : move), pos.Y-6));
				}

				PlayerModifiers mods = sans.GetModifiers();
				mods.CurrentEnergy -= mods.CurrentEnergy > 4 ? 4 : mods.CurrentEnergy;
				sans.SetModifiers(mods);

				Game.PlayEffect("CFTXT", pos, "MISS!");
			}

			moves36[3] = false;
			CreateTimer(500, 1, "SansCD4", true);
		}
	}
	/// DODGE - END ///

	/// PASSIVE: DETERMINATION - START ///
	if((sans.GetEnergy() < 1 || IsVulnerable(sans)) && sans.GetModifiers().CanBurn == 0) {
		PlayerModifiers mods = sans.GetModifiers();
		mods.ExplosionDamageTakenModifier += 1;
		mods.ProjectileDamageTakenModifier += 1;
		mods.FireDamageTakenModifier += 1;
		mods.MeleeDamageTakenModifier += 1;
		mods.ImpactDamageTakenModifier += 1;
		mods.CanBurn = 1;

		mods.CurrentEnergy -= mods.CurrentEnergy > 8 ? 8 : mods.CurrentEnergy;
		sans.SetModifiers(mods);
		Game.PlayEffect("CFTXT", sans.GetAABB().Center, "!!");
	} else if(!sans.IsDead && !IsVulnerable(sans) && sans.GetEnergy() >= 1 && sans.GetModifiers().CanBurn == 1) {
		sansMods.CurrentEnergy = sans.GetEnergy();
		sans.SetModifiers(sansMods);
	}
	/// PASSIVE: DETERMNATION - END ///
}

public void CreateBones(TriggerArgs args) {
	Vector2 pos = boneTxt.GetWorldPosition() + new Vector2(0, 4);
	int height = 3;
	float pi = (float)Math.PI, angle = boneTxt.GetAngle();

	IObject[] obj = new IObject[14];
	for(int i=0;i<7;i++) {
		obj[i*2] = Game.CreateObject("BgFrame01A", pos + new Vector2(-18 + (6*i), -2));
		obj[i*2].SetSizeFactor(new Point(1, 1 + height));
		obj[i*2+1] = Game.CreateObject("BgFrame01B", pos + new Vector2(-18 + (6*i), 0));
		obj[i*2+1].SetAngle(7*pi/4);
	}
	bones.Add(obj);
	boneArea.Add(CreateArea(pos + new Vector2(-16, 0), new Point(5, 2), "GetBoned", "GetUnboned"));
	boneTxt.Remove();

	CreateTimer(1000, 1, "RemoveBones", true);
	((IObject)args.Caller).Remove();
}

public void RemoveBones(TriggerArgs args) {
	Array.ForEach(bones[0], o => o.Remove());
	boneArea[0].Remove();

	bones.RemoveAt(0);
	boneArea.RemoveAt(0);
	boned.Clear();

	((IObject)args.Caller).Remove();
}

public void GetBoned(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(!IsOnSameTeam(p, sans) && !boned.Contains(p) && !p.IsRolling && !p.IsDiving) {
		p.DealDamage(15*p.GetModifiers().ProjectileDamageTakenModifier, sans.UniqueID);
		Game.PlayEffect("BLD", p.GetAABB().Center);
		Game.PlaySound("BulletHitFlesh", p.GetAABB().Center, 1/2f);
		boned.Add(p);
	}
}

public void GetUnboned(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(boned.Contains(p))
		boned.Remove(p);
}

public void SpawnGBlaster(Vector2 pos, float angle) {	
	IObject[] gaster = new IObject[4];
	float cos = (float)Math.Cos(angle), sin = (float)Math.Sin(angle);

	for(int i=0;i<2;i++) {
		int face = 1 + (-2*i);
		gaster[i] = Game.CreateObject("BgWall00I", pos);
		gaster[i].SetFaceDirection(face);
		gaster[i].SetWorldPosition(pos + new Vector2(8*sin + 5*face*cos, -8*cos + 5*face*sin));
		gaster[i].SetAngle((face == -1 ? 4.71f : 1.57f) + angle);
	}
	gaster[2] = Game.CreateObject("BgBullsSkull00", pos);
	gaster[2].SetAngle(angle);

	gasters.Add(gaster);
	gasterTimers.Add(CreateTimer(1000, 1, "TriggerGBlast", true));
}

public void TriggerGBlast(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	int x = gasterTimers.IndexOf(timer);

	IObject[] gaster = gasters[x];
	Vector2 pos = gaster[2].GetAABB().Center;
	float angle = gaster[2].GetAngle();
	float cos = (float)Math.Cos(angle), sin = (float)Math.Sin(angle);
	
	for(int i=0;i<2;i++) {
		int face = gaster[i].GetFaceDirection();
		gaster[i].SetWorldPosition(gaster[i].GetWorldPosition() + new Vector2(2*face*cos, 2*face*sin));
	}
	gaster[3] = Game.CreateObject("BgWindow00A", pos + new Vector2(12*sin, -12*cos));
	gaster[3].SetAngle(angle);
	gaster[3].SetSizeFactor(new Point(1, 50));
	gaster[3].SetColor2("White"); 

	gasterTimers[x] = CreateTimer(25, 25, "GBlastTick", true);
	((IObject)args.Caller).Remove();
}

public void GBlastTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	int x = gasterTimers.IndexOf(timer);
	IObject[] gaster = gasters[x];
	
	IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(gaster[3].GetAABB()), p => !IsOnSameTeam(p, sans) && !p.IsRolling && !p.IsDiving && IsInArea(gaster[3], p));
	foreach(IPlayer p in foes) {
		p.DealDamage(3*p.GetModifiers().ProjectileDamageTakenModifier, sans.UniqueID);
		Game.PlayEffect("BulletHit", p.GetAABB().Center);
		Game.PlaySound("BulletHitCloth", p.GetAABB().Center, 0.25f);
	}

	if(!timer.IsTimerRunning) {
		for(int i=0;i<4;i++)
			gaster[i].Remove();
		gasters.RemoveAt(0);
		gasterTimers.RemoveAt(0);
		timer.Remove();
	}
}

public void EnableSans(TriggerArgs args) {
	sans.SetInputMode(PlayerInputMode.Enabled);
	((IObject)args.Caller).Remove();
}

public void SansCD1(TriggerArgs args) {
	moves36[0] = true;
	((IObject)args.Caller).Remove();
}

public void SansCD2(TriggerArgs args) {
	moves36[1] = true;
	((IObject)args.Caller).Remove();
}

public void SansCD3(TriggerArgs args) {
	moves36[2] = true;
	((IObject)args.Caller).Remove();
}

public void SansCD4(TriggerArgs args) {
	moves36[3] = true;
	((IObject)args.Caller).Remove();
}










///// SAITAMA /////

IPlayer saitama;
IProfile prfSaitama = new IProfile();
bool moves37 = true;

public void SpawnSaitama(IPlayer p) {
	saitama = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.EnergyConsumptionModifier = 0;
	mods.ExplosionDamageTakenModifier = 0;
	mods.ProjectileDamageTakenModifier = 0;
	mods.ProjectileCritChanceTakenModifier = 0;
	mods.FireDamageTakenModifier = 0;
	mods.MeleeDamageTakenModifier = 0;
	mods.ImpactDamageTakenModifier = 0;
	mods.MeleeDamageDealtModifier = 100;
	mods.MeleeForceModifier = 50;
	mods.MeleeStunImmunity = 1;
	mods.RunSpeedModifier = 2;
	mods.SprintSpeedModifier = 2;

	saitama.SetProfile(prfSaitama);
	saitama.SetModifiers(mods);
	CreateTimer(50, 0, "SaitamaTick", true);
}

public void SaitamaTick(TriggerArgs args) {
	/// SERIOUS PUNCH - START ///
	if(saitama.IsMeleeAttacking && saitama.IsWalking && moves37) {
		Area a = saitama.GetAABB();
		a.Grow(392, 390);
		a.Move(new Vector2(400*saitama.FacingDirection, 200));

		IPlayer[] victims = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => p != saitama);
		foreach(IPlayer p in victims)
			LaunchPlayer(p, new Vector2(100*saitama.FacingDirection, 50*Math.Sign(p.GetAABB().Center.Y-a.Center.Y)));

		IObject[] objects = Array.FindAll(Game.GetObjectsByArea(a), o => !(o is IPlayer));
		foreach(IObject o in objects) {
			if(o.Destructable)
				o.Destroy();
			else if(o.GetBodyType() == BodyType.Dynamic)
				o.SetLinearVelocity(new Vector2(100*saitama.FacingDirection, 50*Math.Sign(o.GetAABB().Center.Y-a.Center.Y)));
		}

		moves37 = false;
		Game.PlayEffect("CFTXT", saitama.GetAABB().Center, "5 seconds until use.");
		CreateTimer(5000, 1, "SaitamaCD1", true);
	}
	/// SERIOUS PUNCH - END ///
}

public void SaitamaCD1(TriggerArgs args) {
	moves37 = true;
	Game.PlayEffect("CFTXT", saitama.GetAABB().Center, "Serious Punch is ready!");
	((IObject)args.Caller).Remove();
}




















///////                      ///////
///////   CALLBACK METHODS   ///////
///////                      ///////

public void OnDamage(IPlayer p, PlayerDamageArgs args) {
	/// PASSIVE: LIFE STEAL - START ///
	if(!p.IsDead && args.DamageType == PlayerDamageEventType.Melee && cannibal != null && args.SourceID == cannibal.UniqueID) {
		PlayerModifiers mods = cannibal.GetModifiers();
		mods.CurrentHealth += args.Damage / 2;
		cannibal.SetModifiers(mods);
		Game.PlaySound("ImpactFlesh", cannibal.GetWorldPosition(), 2/3f);
	}
	/// PASSIVE: LIFE STEAL - END ///

	/// PASSIVE: DEOMONIC PACT - START ///
	if(!p.IsDead && insurgent != null && p == insurgent && args.DamageType != PlayerDamageEventType.Fire && args.SourceID != insurgent.UniqueID) {
		dueTimers.Add(CreateTimer(10000, 1, "DevilsDue", true));
		dueDmg.Add(args.Damage);
	}
	/// PASSIVE: DEOMONIC PACT - END ///

	/// DEADLY STARS: COMBO - START ///
	if(!p.IsDead && ninja != null && args.DamageType == PlayerDamageEventType.Missile && Game.GetObject(args.SourceID).CustomID.Equals("DStar")) {
		p.DealDamage(args.Damage*starCombo, ninja.UniqueID);
		Game.PlayEffect("BLD", p.GetAABB().Center);
		starCombo *= 2;
	}
	/// DEADLY STARS: COMBO - END ///

	/// PASSIVE: NECROTIC PACT - START ///
	if(!p.IsDead && args.DamageType == PlayerDamageEventType.Melee && goblins.Contains(Game.GetPlayer(args.SourceID)) && !necro.IsDead)  {
		PlayerModifiers mods = necro.GetModifiers();
		mods.CurrentHealth += args.Damage * STRENGTH_1/4.25f;
		necro.SetModifiers(mods);
		Game.PlaySound("GetHealthSmall", necro.GetWorldPosition(), 1/3f);
	}
	/// PASSIVE: NECROTIC PACT - END ///

	/// DISGUISE: UNCOVERED ///
	if(p == slender && disguiseOn) {
		PlayerModifiers mods = slender.GetModifiers();
		mods.ExplosionDamageTakenModifier *= 3;
		mods.ProjectileDamageTakenModifier *= 3;
		mods.ProjectileCritChanceTakenModifier *= 3;
		mods.FireDamageTakenModifier *= 3;
		mods.MeleeDamageTakenModifier *= 3;
		mods.ImpactDamageTakenModifier *= 3;

		slender.SetProfile(prfSlender);
		slender.SetModifiers(mods);
		slender.SetNametagVisible(true);
		if(!mimicked.IsRemoved)
			mimicked.SetNametagVisible(true);
		Game.PlayEffect("CFTXT", slender.GetAABB().Center, "DISCOVERED!!");

		disguiseOn = false;
	}
}

public void OnKeyMoves(IPlayer p, VirtualKeyInfo[] info) {
	VirtualKeyInfo[] args = Array.FindAll(info, e => e.Event == VirtualKeyEvent.Pressed);
	foreach(VirtualKeyInfo arg in args) {
		switch(arg.Key) {
			case VirtualKey.JUMP:
				/// BROS. JUMP - START ///
				if(p == mario && p.IsWalking && !p.IsDiving && !p.IsDisabled && moves9[1]) {
					if(p.GetLinearVelocity().Y < 0) { // FOOTSTOOL CHECK
						Area a = mario.GetAABB();
						a.Grow(0, -6);
						a.Move(new Vector2(0, -10));

						IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), _p => !IsOnSameTeam(_p, mario));
						foreach(IPlayer _p in foes) {
							_p.DealDamage(5*_p.GetModifiers().ImpactDamageTakenModifier, mario.UniqueID);
							LaunchPlayer(_p, Vector2.Zero);
							Game.PlaySound("PlayerLandKnockdown", a.Center, 0.5f);
						}
					}

					if(p.IsOnGround)
						p.SetWorldPosition(p.GetWorldPosition() + new Vector2(0, 4));
					p.SetLinearVelocity(new Vector2(0, 12));

					Game.PlayEffect("H_T", p.GetWorldPosition());
					Game.PlaySound("PlayerJump", p.GetWorldPosition());
					Game.PlaySound("PlayerKick", p.GetWorldPosition(), 2/3f);

					moves9[1] = false;
				}
				/// BROS. JUMP - END ///

				/// PASSIVE: WIND JUMP - START ///
				if(p == wind && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y < 0 && p.GetEnergy() > 0) {
					p.SetLinearVelocity(new Vector2(0, 7.5f));

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/12 ? p.GetMaxEnergy()/12 : p.GetEnergy(); 
					p.SetModifiers(mods);

					Game.PlaySound("Wings", p.GetWorldPosition(), 1/3f);
					Game.PlayEffect("TR_SPR", p.GetWorldPosition(), p.UniqueID, "TR_D", 0.1f);
				}
				/// PASSIVE: WIND JUMP - END ///

				/// PASSIVE: FIRE JUMP - START ///
				if(p == fire && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y < 0 && p.GetEnergy() > 0f) {
					p.SetLinearVelocity(new Vector2(0, 9));

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/10 ? p.GetMaxEnergy()/10 : p.GetEnergy(); 
					p.SetModifiers(mods);

					Game.PlaySound("Flamethrower", p.GetWorldPosition(), 1/3f);
					Game.PlayEffect("TR_SPR", p.GetWorldPosition(), p.UniqueID, "TR_F", 0.1f);
				}
				/// PASSIVE: FIRE JUMP - END ///

				/// PASSIVE: GRAVITAL HOP - START ///
				if(p == grav && p.IsInMidAir && !p.IsWalking && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y < 0 && p.GetEnergy() > 0) {
					p.SetLinearVelocity(new Vector2(0, 11));

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/15 ? p.GetMaxEnergy()/15 : p.GetEnergy();
					p.SetModifiers(mods);

					Game.PlaySound("PlayerJump", p.GetWorldPosition());
				}
				/// PASSIVE: GRAVITAL HOP - END ///

				/// PASSIVE: ROCKET HOP - START ///
				if(p == rocketeer && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y < 0 && p.GetEnergy() > 0) {
					p.SetLinearVelocity(new Vector2(0, 9));

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/10 ? p.GetMaxEnergy()/10 : p.GetEnergy(); 
					p.SetModifiers(mods);

					Game.PlaySound("Flamethrower", p.GetWorldPosition(), 1/3f);
					Game.PlayEffect("TR_SPR", p.GetWorldPosition(), p.UniqueID, "TR_F", 0.1f);
				}
				/// PASSIVE: ROCKET HOP - END ///

				/// PASSIVE: WINGS - START /// 
				if(p == vampire && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y < 0 && p.GetEnergy() > 0) {
					p.SetLinearVelocity(new Vector2(2*p.FacingDirection, 6) * flyAmp);

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/12 ? p.GetMaxEnergy()/12 : p.GetEnergy(); 
					p.SetModifiers(mods);

					Game.PlaySound("Wings", p.GetWorldPosition(), 0.5f);
				}
				/// PASSIVE: WINGS - END /// 

				/// TELEPORT: UPWARD - START ///
				if(p == slender && slender.GetEnergy() >= 15 && p.IsWalking && !p.IsDiving && !p.IsDisabled && moves32[2]) {
					Area coll = slender.GetAABB();
					coll.Grow(-4, -6);
					coll.Move(new Vector2(0, 80));
		
					if(!Array.Exists(Game.GetObjectsByArea(coll), o => !(o is IPlayer) && o.GetCollisionFilter().MaskBits == 0xEFED && o.GetSize().Y >= 16)) {
						slender.SetWorldPosition(slender.GetWorldPosition() + new Vector2(0, 80));
						slender.SetLinearVelocity(Vector2.Zero);
						PlayerModifiers mods = slender.GetModifiers();
						mods.CurrentEnergy -= mods.CurrentEnergy > 20 ? 20 : mods.CurrentEnergy;
						slender.SetModifiers(mods);
						Game.PlaySound("LogoSlam", slender.GetAABB().Center, 1/3f);
					}

					moves32[2] = false;
					CreateTimer(500, 1, "SlendermanCD3", true);
				}
				/// TELEPORT: UPWARD - END ///
				break;
			case VirtualKey.AIM_CLIMB_DOWN:
				/// GROUND POUND - START ///
				if(p == mario && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.IsWalking && p.GetLinearVelocity().Y < 8 && moves9[2]) {
					p.SetLinearVelocity(new Vector2(0, -30));
					moves9[2] = false;
				}
				/// GROUND POUND - END ///

				/// PASSIVE: GRAVITAL DROP - START ///
				if(p == grav && p.IsInMidAir && !p.IsWalking && !p.IsDiving && !p.IsDisabled && p.GetLinearVelocity().Y >= -6.5f && p.GetEnergy() > 0) {
					p.SetLinearVelocity(new Vector2(0, -11));

					PlayerModifiers mods = p.GetModifiers();
					mods.CurrentEnergy -= p.GetEnergy() > p.GetMaxEnergy()/15 ? p.GetMaxEnergy()/15 : p.GetEnergy();
					p.SetModifiers(mods);

					Game.PlaySound("PlayerJump", p.GetWorldPosition());
				}
				/// PASSIVE: GRAVITAL DROP - END ///

				/// STOMP - START ///
				if(p == stomper && p.IsInMidAir && !p.IsDiving && !p.IsDisabled && p.IsWalking && p.GetLinearVelocity().Y < 10 && moves17[2]) {
					p.SetLinearVelocity(new Vector2(0, -30));

					moves17[2] = false;
					Game.PlayEffect("CFTXT", stomper.GetAABB().Center, "5 seconds until use.");
					CreateTimer(5000, 1, "StomperCD3", true);
				}
				/// STOMP - END ///
				break;
			case VirtualKey.ATTACK:
				/// PASSIVE: AFTER-PUNCH - START ///
				if(p == quicksilver && (p.IsMeleeAttacking || p.IsJumpAttacking) && afterimage == null) {
					Area a = quicksilver.GetAABB();
					a.Grow(24, 4);
			
					IPlayer target = null;
					IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), _p => {
						float d = Vector2.Distance(_p.GetAABB().Center, p.GetAABB().Center);
						return !IsOnSameTeam(_p, p) && d >= 20 && d <= 40;
					});

					if(foes.Length != 0)
						target = Enumerable.OrderByDescending(foes, _p => Vector2.Distance(_p.GetAABB().Center, p.GetAABB().Center)).Last();

					if(target != null) {
						int direction = Math.Sign(target.GetWorldPosition().X - p.GetWorldPosition().X);
						afterimage = Game.CreatePlayer(target.GetWorldPosition() + new Vector2(8*direction, 0));
						afterimage.SetTeam(p.GetTeam());
						afterimage.SetProfile(prfQuicksilver);
						afterimage.SetModifiers(p.GetModifiers());
						afterimageColl.AddTargetObject(afterimage);

						afterimage.AddCommand(new PlayerCommand(PlayerCommandType.AttackOnce, (PlayerCommandFaceDirection)(direction*-1)));
						CreateTimer(500, 1, "RemoveAfterimage", true);
					}
				}
				/// PASSIVE: AFTER-PUNCH - END ///
				
				/// PASSIVE: VAMPIRISM - START ///
				if(p == vampire && p.IsMeleeAttacking && moves31[1]) {
					Area hitbox = vampire.GetAABB();
					hitbox.Grow(vampRange);

					foreach(IPlayer _p in Game.GetObjectsByArea<IPlayer>(hitbox)) {
						if(!IsOnSameTeam(_p, p)) {
							PlayerModifiers mods = p.GetModifiers();
							mods.CurrentHealth += mods.MeleeDamageDealtModifier*8.5f / 3;
							p.SetModifiers(mods);

							_p.DealDamage(mods.MeleeDamageDealtModifier*8.5f / 3, vampire.UniqueID);
							Game.PlayEffect("BLD", _p.GetAABB().Center);
							Game.PlayEffect("BLD", hitbox.Center + new Vector2(8*p.FacingDirection, 2));
							Game.PlaySound("ImpactFlesh", hitbox.Center, 0.5f);
						}
					}

					moves31[1] = false;
					CreateTimer(500, 1, "VampireCD2", true);
				}
				/// PASSIVE: VAMPIRISM - END ///
				break;
			case VirtualKey.KICK:
				/// PASSIVE: AFTER-KICK - START ///
				if(p == quicksilver && (p.IsKicking || p.IsJumpKicking) && afterimage == null) {
					Area a = quicksilver.GetAABB();
					a.Grow(24, 4);
			
					IPlayer target = null;
					IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), _p => {
						float d = Vector2.Distance(_p.GetAABB().Center, p.GetAABB().Center);
						return !IsOnSameTeam(_p, p) && d >= 20 && d <= 40;
					});

					if(foes.Length != 0)
						target = Enumerable.OrderByDescending(foes, _p => Vector2.Distance(_p.GetAABB().Center, p.GetAABB().Center)).Last();

					if(target != null) {
						int direction = Math.Sign(target.GetWorldPosition().X - p.GetWorldPosition().X);
						afterimage = Game.CreatePlayer(target.GetWorldPosition() + new Vector2(8*direction, 0));
						afterimage.SetTeam(p.GetTeam());
						afterimage.SetProfile(prfQuicksilver);
						afterimage.SetModifiers(p.GetModifiers());
						afterimageColl.AddTargetObject(afterimage);

						afterimage.AddCommand(new PlayerCommand(PlayerCommandType.Kick, (PlayerCommandFaceDirection)(direction*-1)));
						CreateTimer(500, 1, "RemoveAfterimage", true);
					}
				}
				/// PASSIVE: AFTER-KICK - END ///
				break;
		}

		int k = (int)arg.Key;
		/// BLUE SOUL: ACTION ///
		if(p == sans && blue != null && k >= 0 && k <= 3)
			blueKey = arg.Key;
	}

	
}

public void OnWeaponRemoval(IPlayer p, PlayerWeaponRemovedArg arg) {
	/// PASSIVE: STRONG THROW - START ///
	if(p == predator && arg.Thrown && arg.WeaponItemType == WeaponItemType.Melee) {
		IObjectWeaponItem wpn = (IObjectWeaponItem)Game.GetObject(arg.TargetObjectID);
		wpn.SetLinearVelocity(new Vector2(wpn.GetLinearVelocity().X, wpn.GetLinearVelocity().Y - 3.5f) * 15);
	}
	/// PASSIVE: STRONG THROW - END ///

	/// AUTO-EQUIP: DROP BREAK ///
	if(autoEquipped.Contains(p) && arg.WeaponItemType == WeaponItemType.Melee) {
		if(Game.GetObject(arg.TargetObjectID) != null) {
			IObjectWeaponItem wpn = (IObjectWeaponItem)Game.GetObject(arg.TargetObjectID);
			wpn.SetBreakOnDrop(true);
		}
	}
}

public void CommandPrompt(UserMessageCallbackArgs args) {
	if(args.IsCommand) {
		string s = args.CommandArguments;
		switch(args.Command.ToUpper()) {
			case "NF_HELP":
				if(s == "") {
					Game.ShowChatMessage("Type \"/nf_help\" with a command below to learn more!", args.User.UserIdentifier);
					foreach(string cmd in helpInfo.Keys)
						Game.ShowChatMessage(cmd, args.User.UserIdentifier);
				} else {
					if(helpInfo.ContainsKey(s = s.ToUpper()))
						Game.ShowChatMessage(s + " : " + helpInfo[s], args.User.UserIdentifier);
					else
						Game.ShowChatMessage(s + " is not a command. Provide a valid command.", args.User.UserIdentifier);
				}
				break;
			case "NF_INTRO":
				titleCard = !titleCard;
				Game.SessionStorage.SetItem("ToggleIntro", titleCard);
				Game.ShowChatMessage("The title card intro has been toggled " + (titleCard ? "ON." : "OFF."), args.User.UserIdentifier);
				break;
			case "NF_MOVES":
				int index = activeCharacters[args.User.GetPlayer().UniqueID];
				for(int i=0;i<controls[index].Length;i++) {
					if(String.IsNullOrEmpty(moveInfo[index][i]))
						Game.ShowChatMessage(controls[index][i].Replace("\n", " | "), args.User.UserIdentifier);
					else
						Game.ShowChatMessage(controls[index][i].Replace("\n", " ") + " -> " + moveInfo[index][i], args.User.UserIdentifier);
				}
				break;
			case "NF_RANDOM":
				randAssign = !randAssign;
				Game.SessionStorage.SetItem("ToggleRandAssignment", randAssign);
				Game.ShowChatMessage("All-random character assignment has been toggled " + (randAssign ? "ON" : "OFF") + " for the next round.", args.User.UserIdentifier);
				break;
			case "NF_TRAIT":
				if(traitInfo.ContainsKey(s))
					Game.ShowChatMessage(s + " : " + traitInfo[s], args.User.UserIdentifier);
				else
					Game.ShowChatMessage(s + " is not a trait. Provide a valid trait.", args.User.UserIdentifier);
				break;
		}
	}
}




















	///////                         ///////
	///////  CROWD CONTROL METHODS  ///////
	///////                         ///////

					///// ROOT /////

List<IPlayer> rooted = new List<IPlayer>();
List<IObjectTimerTrigger> rootTimers = new List<IObjectTimerTrigger>();
List<Vector2> rootPos = new List<Vector2>();
List<int> removeRoot = new List<int>();

public void RootPlayer(IPlayer p, int repeat) {
	rooted.Add(p);
	rootPos.Add(p.GetWorldPosition());
	removeRoot.Add(5);
	rootTimers.Add(CreateTimer(50, repeat, "RootTick", true));
	Game.PlaySound("PlayerGrabCatch", p.GetWorldPosition());
	Game.PlayEffect("CFTXT", p.GetWorldPosition(), "ROOTED! (" +(repeat*50/1000f).ToString("R")+ "s)");
}

public void RootTick(TriggerArgs args) {
	int i = 0;
	for(int x=0;x<rootTimers.Count;x++) {
		if(rootTimers.Contains((IObjectTimerTrigger)((IObject)args.Sender)))
			i = x;
	}

	rooted[i].SetWorldPosition(rootPos[i]);
	rooted[i].SetLinearVelocity(Vector2.Zero);
	if(rooted[i].IsInMidAir && !rooted[i].IsCaughtByPlayerInDive && !rooted[i].IsCaughtByPlayerInGrab)
		removeRoot[i] -= 1;
	
	if(removeRoot[i] == 0 || !rootTimers[i].IsTimerRunning) {
		if(rootTimers[i].IsTimerRunning) 
			Game.PlayEffect("CFTXT", rooted[i].GetWorldPosition(), "ROOT BROKE!");
		rooted.Remove(rooted[i]);
		rootPos.Remove(rootPos[i]);
		removeRoot.Remove(removeRoot[i]);
		rootTimers[i].Remove();
		rootTimers.Remove(rootTimers[i]);
	}
}





					///// STUN /////

List<IPlayer> stunned = new List<IPlayer>();
List<IObjectTimerTrigger> stunTimers = new List<IObjectTimerTrigger>();

public void StunPlayer(IPlayer p, int dura, bool effect=true) {
	stunned.Add(p);
	p.SetInputEnabled(false);
	stunTimers.Add(CreateTimer(dura, 1, "RemoveStun", true));
	if(effect)
		Game.PlayEffect("CFTXT", p.GetWorldPosition(), "STUNNED! (" +(dura/1000f).ToString("R")+ "s)");
}

public void RemoveStun(TriggerArgs args) {
	stunned[0].SetInputEnabled(true);
	stunned.Remove(stunned[0]);
	stunTimers[0].Remove();
	stunTimers.Remove(stunTimers[0]);
}





					///// LAUNCH /////

List<IPlayer> airborne = new List<IPlayer>();
List<IObjectTimerTrigger> airTimers = new List<IObjectTimerTrigger>();

public void LaunchPlayer(IPlayer p, Vector2 trajectory) {
	airborne.Add(p);
	p.SetInputEnabled(false);
	if(p.IsOnGround)
		p.SetWorldPosition(p.GetWorldPosition() + new Vector2(0, 4));
	p.AddCommand(new PlayerCommand(PlayerCommandType.Stagger));
	p.SetLinearVelocity(trajectory);
	airTimers.Add(CreateTimer(100, 1, "RemoveLaunch", true));
}

public void RemoveLaunch(TriggerArgs args) {
	airborne[0].SetInputEnabled(true);
	airborne.Remove(airborne[0]);
	airTimers[0].Remove();
	airTimers.Remove(airTimers[0]);
}




















	/////// HELPER METHODS ///////

public void CreateProfiles() {
	/// 1A - ANT MAN ///
	prfAntman.Name = "Ant-Man";
	prfAntman.Gender = Gender.Male;
	prfAntman.Skin = new IProfileClothingItem("Normal", "Skin3", "ClothingLightGray");
	prfAntman.Head = new IProfileClothingItem("MetroLawGasMask", "ClothingGray", "ClothingLightRed");
	prfAntman.ChestOver = new IProfileClothingItem("KevlarVest", "ClothingRed");
	prfAntman.ChestUnder = new IProfileClothingItem("BodyArmor", "ClothingLightRed");
	prfAntman.Hands = new IProfileClothingItem("SafetyGlovesBlack", "ClothingGray");
	prfAntman.Waist = new IProfileClothingItem("Belt", "ClothingGray", "ClothingLightRed");
	prfAntman.Legs = new IProfileClothingItem("Pants", "ClothingGray");
	prfAntman.Feet = new IProfileClothingItem("Boots", "ClothingDarkGray");
	profiles[0] = prfAntman;
	controls[0] = new string[]{"Alt + A", "Alt + D", "Alt + Up-A", "Alt + Crouch", "Alt + Grab/Dive"};
	moveInfo[0] = new string[]{"Grow in size, increasing melee damage but lowering speed.", "Shrink in size, increasing speed but lowering melee damage.", "Summon ants to fight. Use this on cooldown to recall them.", "Return to original size and reset stats.", "Shrink the grabbed opponent."};
	
	/// 1B - ANT ///
	prfAnt.Name = "Ant";
	prfAnt.Gender = Gender.Male;
	prfAnt.Skin = new IProfileClothingItem("Normal", "Skin1", "ClothingLightGray");
	prfAnt.Head = new IProfileClothingItem("MetroLawGasMask", "ClothingBrown", "ClothingLightGray");
	prfAnt.ChestUnder = new IProfileClothingItem("HawaiiShirt", "ClothingBrown", "ClothingBrown");
	prfAnt.Hands = new IProfileClothingItem("SafetyGlovesBlack", "ClothingBrown");
