public IObject CreateHitbox(Vector2 pos, Point size, string color="LightRed") {
	IObject hitbox = Game.CreateObject("BgWindow00A", pos);
	hitbox.SetSizeFactor(size);
	hitbox.SetColor2(color);

	return hitbox;
}

public bool IsWall(IObject o, int height=2) {
	CollisionFilter cf = o.GetCollisionFilter();
	Point size = o.GetSize();
	float angle = o.GetAngle();
	height *= 8;

	bool cond1 = o.GetBodyType() == BodyType.Static && (cf.MaskBits == 61421 || cf.MaskBits == 53193) && !o.Name.Contains("Plat");
	bool cond2 = (size.Y >= height && ((angle <= 0.393f && angle >= 5.895f) || (angle >= 2.751f && angle <= 3.537f))) || (size.X >= height && ((angle >= 1.179f && angle <= 1.965f) || (angle >= 4.323f && angle <= 5.109f)));

	return cond1 && cond2;
}

public bool IsCeiling(IObject o, int length=2) {
	CollisionFilter cf = o.GetCollisionFilter();
	Point size = o.GetSize();
	float angle = o.GetAngle();
	length *= 8;

	bool cond1 = o.GetBodyType() == BodyType.Static && (cf.MaskBits == 61421 || cf.MaskBits == 53193) && !o.Name.Contains("Plat");
	bool cond2 = (size.X >= length && ((angle <= 0.393f && angle >= 5.895f) || (angle >= 2.751f && angle <= 3.537f))) || (size.Y >= length && ((angle >= 1.179f && angle <= 1.965f) || (angle >= 4.323f && angle <= 5.109f)));

	return cond1 && cond2;
}

public bool IsWallbound(IPlayer p, int bound=0) {
	Area a = p.GetAABB();
	a.Grow(0, -6);

	IObject wall = Array.Find(Game.GetObjectsByArea<IObject>(a), o => IsWall(o));

	if(wall != null) {
		bool leftbound = wall.GetAABB().Contains(a.TopLeft) && wall.GetAABB().Contains(a.BottomLeft);
		bool rightbound = wall.GetAABB().Contains(a.TopRight) && wall.GetAABB().Contains(a.BottomRight);

		if(bound == -1)
			return leftbound;
		else if(bound == 1)
			return rightbound;
		else
			return leftbound || rightbound;
	} else
		return false;
}

public bool IsHostile(IPlayer p) {
	return p.IsMeleeAttacking || p.IsJumpAttacking || p.IsKicking || p.IsJumpKicking || p.IsGrabbing || p.IsThrowing || p.IsHipFiring || p.IsRocketRiding;
}

public bool IsVulnerable(IPlayer p) {
	return p.IsDisabled || p.IsStaggering || rooted.Contains(p) || stunned.Contains(p) || p.IsRecoveryKneeling || p.IsLayingOnGround || p.IsStunned || p.IsCaughtByPlayerInDive || p.IsCaughtByPlayerInGrab;
}




















