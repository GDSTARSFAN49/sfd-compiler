	portalDelay = 5;
	moves10[1] = true;
	Game.PlayEffect("CFTXT", enderman.GetAABB().Center, "Drop Portal is ready!");
	((IObject)args.Caller).Remove();
}

public void EndermanCD3(TriggerArgs args) {
	moves10[2] = true;
	((IObject)args.Caller).Remove();
}










/////  WOOD MAGE  /////

IPlayer wood = null;
IProfile prfWood = new IProfile();
IObject[] towerObj = new IObject[14], crateObj = new IObject[2];
bool[] moves11 = {true, true, true, true};

public void SpawnWoodM(IPlayer p) {
	wood = p;
	wood.SetProfile(prfWood);
	CreateTimer(50, 0, "WoodTick", true);
}

public void WoodTick(TriggerArgs args) {
	/// BARREL - START ///
	if(wood.IsMeleeAttacking && wood.IsWalking && moves11[0]) {
		IObject o = Game.CreateObject("WoodBarrel01", wood.GetAABB().Center + new Vector2(16*wood.FacingDirection, 2));
		o.SetLinearVelocity(new Vector2(18*wood.FacingDirection, 0));
		o.DealDamage(o.GetMaxHealth()*9/10f);

		moves11[0] = false;
		Game.PlayEffect("CFTXT", wood.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "WoodCD1", true);
	}
	/// BARREL - END ///

	/// TOWER - START ///
	if(wood.IsKicking && wood.IsWalking && moves11[1]) {
		CreateTower();

		moves11[1] = false;
		Game.PlayEffect("CFTXT", wood.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "WoodCD2", true);
	}
	/// TOWER - END ///

	/// WALL - START ///
	if(wood.IsBlocking && wood.IsWalking && moves11[2]) {
		IObject[] wallObj = new IObject[6];
		for(int i=0;i<wallObj.Length;i++)
			wallObj[i] = Game.CreateObject("Wood06Weak", wood.GetWorldPosition() + new Vector2((24 + 8*(i%2))*wood.FacingDirection, 4 + 8*(i/2)));

		moves11[2] = false;
		Game.PlayEffect("CFTXT", wood.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "WoodCD3", true);
	}
	/// WALL - END ///

	/// SMASHING CRATES - START ///
	if(wood.IsJumpAttacking && wood.IsWalking && moves11[3]) {
		for(int i=0;i<crateObj.Length;i++)
			crateObj[i] = Game.CreateObject("HangingCrate01", wood.GetWorldPosition() + new Vector2((48 + (32*i))*wood.FacingDirection, 100));

		moves11[3] = false;
		Game.PlayEffect("CFTXT", wood.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "WoodCD4", true);
	}
	/// SMASHING CRATES - END ///
}

public void CreateTower() {
	Vector2 pos = wood.GetWorldPosition();

	for(int i=0;i<2;i++) 
		towerObj[i] = Game.CreateObject("Wood06Weak", pos + new Vector2(20*wood.FacingDirection, 76 + (16*i)));

	for(int i=0;i<4;i++)
		towerObj[i+2] = Game.CreateObject("Wood06Weak", pos + new Vector2(28*wood.FacingDirection, 28 + (16*i)));

	for(int i=0;i<4;i++)
		towerObj[i+6] = Game.CreateObject("Wood06Weak", pos + new Vector2(52*wood.FacingDirection, 28 + (16*i)));

	for(int i=0;i<2;i++) 
		towerObj[i+10] = Game.CreateObject("Wood06Weak", pos + new Vector2(60*wood.FacingDirection, 76 + (16*i)));

	towerObj[12] = Game.CreateObject("WoodLadder00A", pos + new Vector2(40*wood.FacingDirection, 80));
	towerObj[12].SetSizeFactor(new Point(1, 10));

	towerObj[13] = Game.CreateObject("WoodPlat01WeakB", pos + new Vector2(40*wood.FacingDirection, 80));
}

public void WoodCD1(TriggerArgs args) {
	moves11[0] = true;
	Game.PlayEffect("CFTXT", wood.GetAABB().Center, "Barrel is ready!");
	((IObject)args.Caller).Remove();
}

public void WoodCD2(TriggerArgs args) {
	for(int i=0;i<towerObj.Length;i++)
		towerObj[i].Remove();

	moves11[1] = true;
	Game.PlayEffect("CFTXT", wood.GetAABB().Center, "Tower is ready!");
	((IObject)args.Caller).Remove();
}

public void WoodCD3(TriggerArgs args) {
	moves11[2] = true;
	Game.PlayEffect("CFTXT", wood.GetAABB().Center, "Wall is ready!");
	((IObject)args.Caller).Remove();
}

public void WoodCD4(TriggerArgs args) {
	for(int i=0;i<crateObj.Length;i++)
		crateObj[i].Remove();

	moves11[3] = true;
	Game.PlayEffect("CFTXT", wood.GetAABB().Center, "Smashing Crates is ready!");
	((IObject)args.Caller).Remove();
}










