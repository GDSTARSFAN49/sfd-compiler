///// STOMPER /////

IPlayer stomper;
IProfile prfStomper = new IProfile();
IObjectText tableTxt;
int tableTick = 5;
bool[] moves17 = {true, true, true};

public void SpawnStomper(IPlayer p) {
	stomper = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ImpactDamageTakenModifier = 0;

	stomper.SetProfile(prfStomper);
	stomper.SetModifiers(mods);
	CreateTimer(50, 0, "StomperTick", true);
}

public void StomperTick(TriggerArgs args) {
	/// TABLE FLIP - START ///
	if(stomper.IsKicking && stomper.IsWalking && moves17[0]) {
		Vector2 pos = stomper.GetWorldPosition() + new Vector2(0, 8);
		tableTxt = CreateText(pos, "[  !  ]", Color.Red, 8/3f, (TextAlignment)(1-stomper.FacingDirection));
		moves17[0] = false;
	} else if(tableTick > 0 && !moves17[0]) {
		tableTxt.SetWorldPosition(stomper.GetWorldPosition() + new Vector2(0, 8));
		tableTxt.SetTextAlignment((TextAlignment)(1-stomper.FacingDirection));

		tableTick--;
		if(tableTick == 0 || stomper.IsDead) {
			Area a = stomper.GetAABB();
			a.Grow(12, 0);
			a.Move(new Vector2(20*stomper.FacingDirection, 0));

			IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, stomper));
			foreach(IPlayer p in foes)
				LaunchPlayer(p, new Vector2(0, 16));

			for(int x=0;x<5;x++) {
				Game.PlayEffect("DIG", a.BottomLeft + new Vector2((8*x), 4));
				Game.PlaySound("Dig", a.BottomLeft + new Vector2((8*x), 4));
			}
			tableTxt.Remove();

			Game.PlayEffect("CFTXT", stomper.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "StomperCD1", true);
		}
	}
	/// TABLE FLIP - END ///

	/// SUPER JUMP - START ///
	if(stomper.IsCrouching && stomper.IsWalking && moves17[1]) {
		Area a = stomper.GetAABB();
		a.Grow(8, 0);

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, stomper) && p.IsOnGround);
		foreach(IPlayer p in foes) {
			p.DealDamage(5*p.GetModifiers().ImpactDamageTakenModifier, stomper.UniqueID);
			LaunchPlayer(p, Vector2.Zero);
			Game.PlaySound("PlayerLandKnockdown", p.GetAABB().Center, 0.75f);
		}
		stomper.SetLinearVelocity(new Vector2(0, 16));		

		Game.PlayEffect("H_T", stomper.GetWorldPosition());
		for(int i=0;i<4;i++)
			Game.PlayEffect("DIG", stomper.GetWorldPosition() + new Vector2(-12 + (i*8), 0));
		Game.PlaySound("PlayerJump", stomper.GetWorldPosition());

		moves17[1] = false;
		Game.PlayEffect("CFTXT", stomper.GetAABB().Center, "5 seconds until use.");
		CreateTimer(5000, 1, "StomperCD2", true);
	}
	/// SUPER JUMP - END ///
}

public void StomperCD1(TriggerArgs args) {
	tableTick = 5;
	moves17[0] = true;
	Game.PlayEffect("CFTXT", stomper.GetAABB().Center, "Table Flip is ready!");
	((IObject)args.Caller).Remove();
}

public void StomperCD2(TriggerArgs args) {
	moves17[1] = true;
	Game.PlayEffect("CFTXT", stomper.GetAABB().Center, "Super Jump is ready!");
	((IObject)args.Caller).Remove();
}

