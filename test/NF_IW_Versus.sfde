///// GRENADIER /////

IPlayer grenadier;
IProfile prfGrenadier = new IProfile();
bool[] moves19 = {true, true};

public void SpawnGrenadier(IPlayer p) {
	grenadier = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier = 0;

	grenadier.SetProfile(prfGrenadier);
	grenadier.SetModifiers(mods);
	CreateTimer(50, 0, "GrenadierTick", true);
}

public void GrenadierTick(TriggerArgs args) {
	/// GRENADE TOSS - START ///
	if(grenadier.IsKicking && grenadier.IsWalking && moves19[0]) {
		for(int x=0;x<3;x++) {
			IProjectile pr = Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER, grenadier.GetWorldPosition() + new Vector2(8*grenadier.FacingDirection, 0), new Vector2(grenadier.FacingDirection, 0.2f + (0.3f*x)));
			pr.Velocity /= 2;
			Game.PlaySound("GLauncher", grenadier.GetAABB().Center);
		}

		moves19[0] = false;
		Game.PlayEffect("CFTXT", grenadier.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "GrenadierCD1", true);
	}
	/// GRENADE TOSS - END ///

	/// BOMBARDMENT - START ///
	if(grenadier.IsJumpAttacking && grenadier.IsWalking && moves19[1]) {
		grenadier.SetLinearVelocity(new Vector2(0, 6));
		for(int x=1;x<=6;x++) {
			float dirX = (float)Math.Cos((Math.PI/7)*x);
			float dirY = (float)Math.Sin((Math.PI/7)*x);
			IProjectile pr = Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER, grenadier.GetAABB().Center + new Vector2(dirX, dirY)*16, new Vector2(dirX, dirY), ProjectilePowerup.Bouncing);
			pr.Velocity /= 3;
			Game.PlaySound("GLauncher", grenadier.GetAABB().Center);
		}
			
		moves19[1] = false;
		Game.PlayEffect("CFTXT", grenadier.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "GrenadierCD2", true);
	}
	/// BOMBARDMENT - END ///
}

public void GrenadierCD1(TriggerArgs args) {
	moves19[0] = true;
	Game.PlayEffect("CFTXT", grenadier.GetAABB().Center, "Grenade Toss is ready!");
	((IObject)args.Caller).Remove();
}

