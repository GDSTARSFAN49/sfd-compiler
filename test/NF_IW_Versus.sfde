	moves19[1] = true;
	Game.PlayEffect("CFTXT", grenadier.GetAABB().Center, "Bombardment is ready!");
	((IObject)args.Caller).Remove();
}










///// MEDIC /////

IPlayer medic;
IProfile prfMedic = new IProfile(), prfPlague = new IProfile();
IObject healBox;
IObject[] acidObj = new IObject[3];
IObjectText acidTxt;
int acidDelay = 5, healDelay = 5;
bool[] moves20 = {true, true, true};

public void SpawnMedic(IPlayer p) {
	medic = p;
	medic.SetProfile(prfMedic);
	CreateTimer(50, 0, "MedicTick", true);
}

public void MedicTick(TriggerArgs args) {
	/// ACID BATH - START ///
	if(medic.IsMeleeAttacking && medic.IsWalking && moves20[0]) {
		Vector2 pos = medic.GetWorldPosition() + new Vector2(0, 8);
		acidTxt = CreateText(pos, "[   !   ]", Color.Red, 8/3f, (TextAlignment)(1-medic.FacingDirection));
		acidDelay = 5;

		moves20[0] = false;
	} else if(acidDelay > 0 && !moves20[0]) {
		acidTxt.SetWorldPosition(medic.GetWorldPosition() + new Vector2(0, 8));
		acidTxt.SetTextAlignment((TextAlignment)(1-medic.FacingDirection));

		acidDelay--;
		if(acidDelay == 0 || medic.IsDead) { // FIXME: Add Death Clause
			Vector2 pos = medic.GetWorldPosition();
			acidObj[0] = Game.CreateObject("AcidVat00A", pos + new Vector2(48*medic.FacingDirection, 8));
			acidObj[1] = Game.CreateObject("AcidVat00Top", pos + new Vector2(48*medic.FacingDirection, 16));
			acidObj[2] = Game.CreateObject("InvisiblePlatform", pos + new Vector2(20*medic.FacingDirection, -8));
			acidObj[2].SetSizeFactor(new Point(8, 1));

			Area a = medic.GetAABB();
			a.Grow(4, 0);
			a.Move(new Vector2(24*medic.FacingDirection, 0));

			IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, medic));
			foreach(IPlayer p in foes)
				p.SetWorldPosition(acidObj[0].GetAABB().Center);

			medic.SetProfile(prfPlague);
			CreateTimer(50, 100, "AcidTick", true);

			acidTxt.Remove();
			acidTxt = null;
			Game.PlayEffect("CFTXT", medic.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "MedicCD1", true);
		}
	}
	/// ACID BATH - END ///

	/// FIRST-AID - START ///
	if(medic.IsBlocking && medic.IsWalking && moves20[1]) {
		medic.GiveWeaponItem(WeaponItem.MEDKIT); 

		moves20[1] = false;
		Game.PlayEffect("CFTXT", medic.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "MedicCD2", true);
	}
	/// FIRST-AID - END ///

	/// EMERGENCY CARE - START ///
	if(medic.IsJumpAttacking && medic.IsWalking && moves20[2]) {
		healBox = CreateHitbox(medic.GetAABB().Center + new Vector2(-24, 24), new Point(7, 7), "LightGreen");
		moves20[2] = false;
	} else if(healDelay > 0 && !moves20[2]) {
		healBox.SetWorldPosition(medic.GetAABB().Center + new Vector2(-24, 24));
		
		healDelay--;
		if(healDelay == 0) {
			IPlayer[] allies = Array.FindAll(Game.GetObjectsByArea<IPlayer>(healBox.GetAABB()), p => IsOnSameTeam(p, medic));
			foreach(IPlayer p in allies)
				p.GiveWeaponItem(WeaponItem.MEDKIT);
			medic.GiveWeaponItem(WeaponItem.PILLS);

			healBox.Remove();
			Game.PlayEffect("CFTXT", medic.GetAABB().Center, "40 seconds until use.");
			CreateTimer(40000, 1, "MedicCD3", true);
		}
	}
	/// EMERGENCY CARE - END ///

	/// PASSIVE: REGENERATION I ///
	if(!medic.IsDead && medic.GetHealth() < medic.GetMaxHealth()) {
		PlayerModifiers mods = medic.GetModifiers();
		mods.CurrentHealth += REGEN_1;
		medic.SetModifiers(mods);
	}
}

public void AcidTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	Area a = acidObj[0].GetAABB();
	a.Grow(0, 6);
	a.Move(new Vector2(0, -6));

	IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, medic) && p.IsOnGround);
	foreach(IPlayer p in foes) {
		p.DealDamage(5, medic.UniqueID);
		if(!p.IsDisabled) {
			p.SetLinearVelocity(new Vector2(0, 4));
			Game.PlayEffect("ACS", new Vector2(p.GetWorldPosition().X, a.Top));
			Game.PlaySound("Splash", new Vector2(p.GetWorldPosition().X, a.Top));
		}
	}

	if(!timer.IsTimerRunning || medic == null) {
		for(int i=0;i<acidObj.Length;i++)
			acidObj[i].Remove();
	
		if(medic != null)
			medic.SetProfile(prfMedic);

		timer.Remove();
	}
}

public void MedicCD1(TriggerArgs args) {
	moves20[0] = true;
	Game.PlayEffect("CFTXT", medic.GetAABB().Center, "Acid Bath is ready!");
	((IObject)args.Caller).Remove();
}

public void MedicCD2(TriggerArgs args) {
	moves20[1] = true;
	Game.PlayEffect("CFTXT", medic.GetAABB().Center, "First-Aid is ready!");
	((IObject)args.Caller).Remove();
}

public void MedicCD3(TriggerArgs args) {
	healDelay = 5;
	moves20[2] = true;
	Game.PlayEffect("CFTXT", medic.GetAABB().Center, "Emergency Care is ready!");
	((IObject)args.Caller).Remove();
}










///// CANNIBAL /////

IPlayer cannibal;
IProfile prfCannibal = new IProfile();
bool moves21 = true;

public void SpawnCannibal(IPlayer p) {
	cannibal = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.MeleeDamageDealtModifier *= STRENGTH_1;

	cannibal.SetProfile(prfCannibal);
	cannibal.SetModifiers(mods);
	CreateTimer(50, 0, "CannibalTick", true);
}

public void CannibalTick(TriggerArgs args) {
	/// FLIP - START ///
	if(cannibal.IsRolling && cannibal.IsWalking && cannibal.GetEnergy() >= 10 && moves21) {
		cannibal.SetLinearVelocity(new Vector2(4.5f*cannibal.FacingDirection, 9));

		PlayerModifiers mods = cannibal.GetModifiers();
		mods.CurrentEnergy -= mods.CurrentEnergy > 15 ? 15 : mods.CurrentEnergy;
		cannibal.SetModifiers(mods);

		moves21 = false;
		CreateTimer(500, 1, "CannibalCD1", true);
	}
	/// FLIP - END ///

	/// PASSIVE: CANNIBALISM ///
	if(cannibal.IsHoldingPlayerInGrab && Game.GetPlayer(cannibal.HoldingPlayerInGrabID).IsDead) {
		PlayerModifiers mods = cannibal.GetModifiers();
		mods.CurrentHealth += 30;
		cannibal.SetModifiers(mods);
		
		Game.GetPlayer(cannibal.HoldingPlayerInGrabID).Gib();
	} else if(cannibal.IsHoldingPlayerInGrab) {
		PlayerModifiers mods = cannibal.GetModifiers();
		mods.CurrentHealth += 0.375f;
		cannibal.SetModifiers(mods);

		IPlayer p = Game.GetPlayer(cannibal.HoldingPlayerInGrabID);
		p.DealDamage(0.75f*p.GetModifiers().MeleeDamageTakenModifier, cannibal.UniqueID);
		Game.PlayEffect("BLD", p.GetAABB().Center);
	}
}

public void CannibalCD1(TriggerArgs args) {
	moves21 = true;
	((IObject)args.Caller).Remove();
}










///// RAMBO /////

IPlayer rambo;
IProfile prfRambo = new IProfile(), prfRamboR = new IProfile();
List<IObject> traps = new List<IObject>();
bool[] moves22 = {true, true};

public void SpawnRambo(IPlayer p) {
	rambo = p;
	autoEquipped.Add(rambo);
	rambo.SetProfile(prfRambo);
	rambo.GiveWeaponItem(WeaponItem.MACHETE);
	rambo.GiveWeaponItem(WeaponItem.TOMMYGUN);
	CreateTimer(50, 0, "RamboTick", true);
}

public void RamboTick(TriggerArgs args) {
	MeleeWeaponItem melee = rambo.CurrentMeleeWeapon;

	/// COMMANDO'S SALVO - START ///
	if((rambo.IsMeleeAttacking || rambo.IsManualAiming) && rambo.IsWalking && moves22[0]) {
		PlayerModifiers mods = rambo.GetModifiers();
		mods.MeleeDamageDealtModifier *= STRENGTH_1;
		mods.ProjectileDamageDealtModifier *= STRONG_GUN_1;
		mods.ProjectileCritChanceDealtModifier *= STRONG_GUN_1;
		RangedWeaponItem rifle = rambo.CurrentPrimaryRangedWeapon;

		rambo.SetProfile(prfRamboR);
		rambo.SetModifiers(mods);
		rambo.GiveWeaponItem(rifle.WeaponItem == WeaponItem.NONE ? WeaponItem.TOMMYGUN : rifle.WeaponItem);
		rambo.GiveWeaponItem(WeaponItem.FIREAMMO);
		Game.PlaySound("Flamethrower", rambo.GetAABB().Center);
		Game.PlaySound("StrengthBoostStart", rambo.GetAABB().Center, 0.5f);
		CreateTimer(15000, 1, "EndCommando", true);

		moves22[0] = false;
	}
	/// COMMANDO'S SALVO - END ///

	/// TRAP - START ///
	if(rambo.IsBlocking && rambo.IsWalking && moves22[1]) {
		IObject trap = Game.CreateObject("BgBullsSkull00", rambo.GetWorldPosition() + new Vector2(rambo.FacingDirection == 1 ? 24 : -56, -4));
		trap.SetFaceDirection(rambo.FacingDirection);
		trap.SetSizeFactor(new Point(3, 1));
		Game.PlaySound("KatanaDraw", trap.GetAABB().Center);
		traps.Add(trap);

		moves22[1] = false;
		Game.PlayEffect("CFTXT", rambo.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "RamboCD2", true);
	}
	/// TRAP - END ///

	/// TRAP: STANDBY ///
	for(int i=0;i<traps.Count;i++) {
		IPlayer p = Array.Find(Game.GetObjectsByArea<IPlayer>(traps[i].GetAABB()), _p => !IsOnSameTeam(_p, rambo) && !_p.IsRolling && !_p.IsDiving);
		if(p != null) {
			p.DealDamage(30*p.GetModifiers().MeleeDamageTakenModifier, rambo.UniqueID);
			RootPlayer(p, 40);

			Game.PlayEffect("BLD", p.GetAABB().Center);
			Game.PlaySound("Whip", p.GetAABB().Center, 0.5f);
			Game.PlaySound("BulletHitFlesh", p.GetAABB().Center);
			traps[i].Remove();
		}
	}

	/// TRAP: REMOVAL ///
	traps.RemoveAll(e => e.IsRemoved);

	/// PASSIVE: AUTO-EQUIP ///
	if(melee.WeaponItem == WeaponItem.NONE && !rambo.IsDead)
		rambo.GiveWeaponItem(WeaponItem.MACHETE);
}

public void EndCommando(TriggerArgs args) {
	if(!rambo.IsRemoved) {
		PlayerModifiers mods = rambo.GetModifiers();
		mods.MeleeDamageDealtModifier /= STRENGTH_1;
		mods.ProjectileDamageDealtModifier /= STRONG_GUN_1;
		mods.ProjectileCritChanceDealtModifier /= STRONG_GUN_1;

		rambo.SetProfile(prfRambo);
		rambo.SetModifiers(mods);
		Game.PlaySound("StrengthBoostStop", rambo.GetAABB().Center);
	}

	Game.PlayEffect("CFTXT", rambo.GetAABB().Center, "30 seconds until use.");
	CreateTimer(30000, 1, "RamboCD1", true);
	((IObject)args.Caller).Remove();
}

public void RamboCD1(TriggerArgs args) {
	moves22[0] = true;
	Game.PlayEffect("CFTXT", rambo.GetAABB().Center, "Commando's Salvo is ready!");
	((IObject)args.Caller).Remove();
}

public void RamboCD2(TriggerArgs args) {
	moves22[1] = true;
	Game.PlayEffect("CFTXT", rambo.GetAABB().Center, "Trap is ready!");
	((IObject)args.Caller).Remove();
}










///// INSURGENT /////

IPlayer insurgent;
IProfile prfInsurgent = new IProfile();
List<IObjectTimerTrigger> dueTimers = new List<IObjectTimerTrigger>();
List<float> dueDmg = new List<float>();
bool[] moves23 = {true, true, true};

public void SpawnInsurgent(IPlayer p) {
	insurgent = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier *= 0.5f;
	mods.ProjectileDamageTakenModifier *= 0.5f;
	mods.MeleeDamageTakenModifier *= 0.5f;
	mods.ImpactDamageTakenModifier *= 0.5f;

	insurgent.SetProfile(prfInsurgent);
	insurgent.SetModifiers(mods);
	CreateTimer(50, 0, "InsurgentTick", true);
}

public void InsurgentTick(TriggerArgs args) {
	/// MELEE KIT - START ///
	if(insurgent.IsMeleeAttacking && insurgent.IsWalking && moves23[0]) {
		insurgent.GiveWeaponItem(WeaponItem.BAT);
		insurgent.GiveWeaponItem(WeaponItem.BOTTLE);

		if(insurgent.GetHealth() > insurgent.GetMaxHealth()/5f)
			insurgent.DealDamage(insurgent.GetMaxHealth()/5f, insurgent.UniqueID);
		else
			insurgent.DealDamage(insurgent.GetHealth() - 0.5f, insurgent.UniqueID);
		Game.PlayEffect("BLD", insurgent.GetAABB().Center);
		Game.PlaySound("MeleeSlash", insurgent.GetAABB().Center, 0.5f);

		moves23[0] = false;
		Game.PlayEffect("CFTXT", insurgent.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "InsurgentCD1", true);
	}
	/// MELEE KIT - END ///

	/// GUNNER KIT - START ///
	if(insurgent.IsBlocking && insurgent.IsWalking && moves23[1]) {
		insurgent.GiveWeaponItem(WeaponItem.ASSAULT);
		insurgent.GiveWeaponItem(WeaponItem.PISTOL45);

		if(insurgent.GetHealth() > insurgent.GetMaxHealth()/5f)
			insurgent.DealDamage(insurgent.GetMaxHealth()/5f, insurgent.UniqueID);
		else
			insurgent.DealDamage(insurgent.GetHealth() - 0.5f, insurgent.UniqueID);
		Game.PlayEffect("BLD", insurgent.GetAABB().Center);
		Game.PlaySound("MeleeSlash", insurgent.GetAABB().Center, 0.5f);

		moves23[1] = false;
		Game.PlayEffect("CFTXT", insurgent.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "InsurgentCD2", true);
	}
	/// GUNNER KIT - END ///

	/// PASSIVE: REGENERATION II ///
	if(!insurgent.IsDead && insurgent.GetHealth() < insurgent.GetMaxHealth()) {
		PlayerModifiers mods = insurgent.GetModifiers();
		mods.CurrentHealth += REGEN_2;
		insurgent.SetModifiers(mods);
	}
}

public void DevilsDue(TriggerArgs args) {
	if(insurgent != null) {
		insurgent.DealDamage(dueDmg[0], insurgent.UniqueID);
		Game.PlayEffect("GIB", insurgent.GetAABB().Center);
		Game.PlaySound("MeleeSlash", insurgent.GetAABB().Center);
		Game.PlaySound("PlayerGib", insurgent.GetAABB().Center, dueDmg[0]/75);
	}
	dueTimers.Remove(dueTimers[0]);
	dueDmg.Remove(dueDmg[0]);
	((IObject)args.Caller).Remove();
}

public void InsurgentCD1(TriggerArgs args) {
	moves23[0] = true;
	Game.PlayEffect("CFTXT", insurgent.GetAABB().Center, "Melee Kit is ready!");
	((IObject)args.Caller).Remove();
}

public void InsurgentCD2(TriggerArgs args) {
	moves23[1] = true;
	Game.PlayEffect("CFTXT", insurgent.GetAABB().Center, "Gunner Kit is ready!");
	((IObject)args.Caller).Remove();
}










///// SHOOTER /////

IPlayer shooter = null;
IProfile prfShooter = new IProfile(), prfShooterR = new IProfile();
IObject[] netObj = new IObject[5];
IObjectTimerTrigger netTimer;
bool[] moves24 = {true, true};

public void SpawnShooter(IPlayer p) {
	shooter = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ProjectileDamageDealtModifier *= STRONG_GUN_1;
	mods.ProjectileCritChanceDealtModifier *= STRONG_GUN_1;
	mods.InfiniteAmmo = 1;

	shooter.SetProfile(prfShooter);
	shooter.SetModifiers(mods);
	shooter.GiveWeaponItem(WeaponItem.MAGNUM);
	shooter.GiveWeaponItem(WeaponItem.SNIPER);
	CreateTimer(50, 0, "ShooterTick", true);
}

public void ShooterTick(TriggerArgs args) {
	/// CRITICAL SHOT - START ///
	if((shooter.IsMeleeAttacking || shooter.IsManualAiming) && shooter.IsWalking && moves24[0]) {
		PlayerModifiers mods = shooter.GetModifiers();
		mods.ProjectileDamageDealtModifier += 0.5f;
		mods.InfiniteAmmo = 0;

		shooter.GiveWeaponItem(WeaponItem.MAGNUM);
		shooter.GiveWeaponItem(WeaponItem.SNIPER);
		shooter.SetCurrentPrimaryWeaponAmmo(shooter.CurrentPrimaryWeapon.MagSize);
		shooter.SetCurrentSecondaryWeaponAmmo(shooter.CurrentSecondaryWeapon.MagSize);

		shooter.SetProfile(prfShooterR);
		shooter.SetModifiers(mods);
		Game.PlayEffect("CFTXT", shooter.GetAABB().Center, "Make it count!!");
		Game.PlaySound("ChainsawStartup", shooter.GetAABB().Center, 0.5f);
		Game.PlaySound("StrengthBoostStart", shooter.GetAABB().Center);
		CreateTimer(15000, 1, "EndCritical", true);

		moves24[0] = false;
	}
	/// CRITICAL SHOT - END ///

	/// NET - START ///
	if(shooter.IsKicking && shooter.IsWalking && moves24[1]) {
		Vector2 pos = shooter.GetAABB().Center;
		netObj[0] = Game.CreateObject("BgFence00B", pos + new Vector2(-8, 8));
		netObj[0].SetSizeFactor(new Point(3, 3));
		netObj[0].SetColor1("BgLightBrown");
		
		Area a = shooter.GetAABB();
		a.Grow(40, 38);
		a.Move(new Vector2(48*shooter.FacingDirection, 0));
		
		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, shooter) && !p.IsDead);
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, pos)).Last();

		netObj[0].SetBodyType(BodyType.Dynamic);
		if(target != null)
			netObj[0].SetLinearVelocity(Vector2.Divide(target.GetAABB().Center - pos + new Vector2(0, 12), 4));
		else
			netObj[0].SetLinearVelocity(new Vector2(6*shooter.FacingDirection, 12));
		netObj[0].SetAngularVelocity(-6.28f*shooter.FacingDirection);
		netTimer = CreateTimer(3000, 1, "RemoveNet", true);
		
		moves24[1] = false;
		Game.PlayEffect("CFTXT", shooter.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "ShooterCD2", true);
	} else if(!moves24[1] && netObj[0] != null && netObj[0].GetBodyType() == BodyType.Dynamic) { /// NET: ACTIVE ///
		IPlayer target = Array.Find(Game.GetObjectsByArea<IPlayer>(netObj[0].GetAABB()), p => {
			bool cond1 = p != shooter && (shooter.GetTeam() == PlayerTeam.Independent || shooter.GetTeam() != p.GetTeam());
 			bool cond2 = !p.IsDead && !p.IsRolling && !p.IsDiving;
			return cond1 && cond2;
		});

		IObject wall = Array.Find(Game.GetObjectsByArea(netObj[0].GetAABB()), o => IsWall(o, 3));

		if(target != null) {
			Vector2 pos = target.GetAABB().TopLeft;

			netObj[0].SetBodyType(BodyType.Static);
			netObj[0].SetAngle(0);
			netObj[0].SetWorldPosition(pos + new Vector2(-8, 4));
			netObj[0].SetSizeFactor(new Point(4, 5));

			for(int i=1;i<3;i++) {
				netObj[i] = Game.CreateObject("InvisibleBlockObjectsOnly", pos + new Vector2(-4 + (24*(i-1)), 4));
				netObj[i].SetSizeFactor(new Point(1, 5));
				netObj[i+2] = Game.CreateObject("InvisibleBlockObjectsOnly", pos + new Vector2(4, 4 + (-32*(i-1))));
				netObj[i+2].SetSizeFactor(new Point(2, 1));
			}

			RootPlayer(target, 60);
			netTimer.Remove();
			netTimer = CreateTimer(3000, 1, "RemoveNet", true);
		} else if(wall != null) {
			netTimer.Remove();
			netTimer = CreateTimer(50, 1, "RemoveNet", true);
		}
	}
	/// NET - END ///
}

public void EndCritical(TriggerArgs args) {
	if(!shooter.IsRemoved) {
		PlayerModifiers mods = shooter.GetModifiers();
		mods.ProjectileDamageDealtModifier -= 0.5f;
		mods.InfiniteAmmo = 1;

		shooter.SetProfile(prfShooter);
		shooter.SetModifiers(mods);
		shooter.GiveWeaponItem(WeaponItem.MAGNUM);
		shooter.GiveWeaponItem(WeaponItem.SNIPER);
		Game.PlaySound("StrengthBoostStop", shooter.GetAABB().Center);
	}

	Game.PlayEffect("CFTXT", shooter.GetAABB().Center, "30 seconds until use.");
	CreateTimer(30000, 1, "ShooterCD1", true);
	((IObject)args.Caller).Remove();
}

public void RemoveNet(TriggerArgs args) {
	for(int i=0;i<5;i++) {
		if(netObj[i] != null)
			netObj[i].Remove();
		netObj[i] = null;
	}
	
	((IObject)args.Caller).Remove();
}

public void ShooterCD1(TriggerArgs args) {
	moves24[0] = true;
	Game.PlayEffect("CFTXT", shooter.GetAABB().Center, "Critical Shot is ready!");
	((IObject)args.Caller).Remove();
}

public void ShooterCD2(TriggerArgs args) {
	moves24[1] = true;
	Game.PlayEffect("CFTXT", shooter.GetAABB().Center, "Net is ready!");
	((IObject)args.Caller).Remove();
}










///// ALIEN /////

IPlayer alien;
List<IPlayer> children = new List<IPlayer>();
IProfile prfAlien = new IProfile();

public void SpawnAlien(IPlayer p) {
	alien = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier *= FRAGILE;
	mods.ProjectileDamageTakenModifier *= FRAGILE;
	mods.ProjectileCritChanceTakenModifier *= FRAGILE;
	mods.FireDamageTakenModifier *= FRAGILE;
	mods.MeleeDamageTakenModifier *= FRAGILE;
	mods.ImpactDamageTakenModifier *= FRAGILE;
	mods.MeleeDamageDealtModifier *= STRENGTH_2;
	mods.RunSpeedModifier += FAST_2;
	mods.SprintSpeedModifier += FAST_2;

	alien.SetProfile(prfAlien);
	alien.SetModifiers(mods);
	alien.SetTeam(alien.GetTeam() == PlayerTeam.Independent ? PlayerTeam.Team3 : alien.GetTeam());
	CreateTimer(50, 0, "AlienTick", true);
}

public void AlienTick(TriggerArgs args) {
	/// PASSIVE: HATCH EGGS - START ///
	if(alien.IsHoldingPlayerInGrab && Game.GetPlayer(alien.HoldingPlayerInGrabID).IsDead) {
		IPlayer victim = Game.GetPlayer(alien.HoldingPlayerInGrabID);
		Vector2 pos = victim.GetWorldPosition();
		
		IPlayer child = Game.CreatePlayer(pos);
		child.SetProfile(prfAlien);
		child.SetModifiers(alien.GetModifiers());
		child.SetTeam(alien.GetTeam());
		children.Add(child);

		child.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
		child.SetGuardTarget(alien);
		child.SetBotBehaviorActive(true);

		victim.Gib();
	}
	/// PASSIVE: HATCH EGGS - END ///

	if(children.Count > 0 && children[0].GetTeam() != alien.GetTeam())
		children.ForEach(p => p.SetTeam(alien.GetTeam()));
}










///// PREDATOR /////

IPlayer predator;
IProfile prfPredator = new IProfile();
bool moves26 = true;

public void SpawnPredator(IPlayer p) {
	predator = p;
	autoEquipped.Add(predator);
	predator.SetProfile(prfPredator);
	predator.GiveWeaponItem(WeaponItem.KNIFE);
	CreateTimer(50, 0, "PredatorTick", true);
}

public void PredatorTick(TriggerArgs args) {
	MeleeWeaponItem melee = predator.CurrentMeleeWeapon;

	/// FLAME GRENADE - START ///
	if((predator.IsMeleeAttacking || predator.IsJumpAttacking) && predator.IsWalking && moves26) {
		IProjectile pr = Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER, predator.GetWorldPosition() + new Vector2(8*predator.FacingDirection, 8), new Vector2(predator.FacingDirection, 0.05f), ProjectilePowerup.Fire);

		moves26 = false;
		Game.PlayEffect("CFTXT", predator.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "PredatorCD1", true);
	}
	/// FLAME GRENADE - END ///

	/// PASSIVE: AUTO-EQUIP - START ///
	if(melee.WeaponItem == WeaponItem.NONE && !predator.IsDead)
		predator.GiveWeaponItem(WeaponItem.KNIFE);
	/// PASSIVE: AUTO-EQUIP - END ///

	/// PASSIVE: KAMIKAZE - START ///
	if(predator.IsDead && !predator.IsRemoved) {
		Vector2 pos = predator.GetWorldPosition();
		for(int x=0;x<3;x++)
			Game.TriggerExplosion(pos);
	}
	/// PASSIVE: KAMIKAZE - END ///
}

