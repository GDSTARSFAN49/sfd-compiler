///// ICE MAGE /////

IPlayer ice;
List<IPlayer> frozen = new List<IPlayer>();
IProfile prfIce = new IProfile(), prfFrozenM = new IProfile(), prfFrozenF = new IProfile();
List<IProfile> frozenPrfs = new List<IProfile>();
IObject cubeObj;
IObjectSoundArea[] blizzardAud = new IObjectSoundArea[2];
IObjectText blizzardTxt;
List<IObject> iceObj = new List<IObject>();
int blizzardTick = 160;
bool[] moves13 = {true, true, true, true};

public void SpawnIceM(IPlayer p) {
	ice = p;
	ice.SetProfile(prfIce);
	CreateTimer(50, 0, "IceTick", true);
}

public void IceTick(TriggerArgs args) {
	/// CUBE - START ///
	if((ice.IsMeleeAttacking || ice.IsJumpAttacking) && ice.IsWalking && cubeObj == null && moves13[0]) {
		cubeObj = Game.CreateObject("Snow00C", ice.GetAABB().Center + new Vector2(16*ice.FacingDirection, 2));

		CollisionFilter coll = cubeObj.GetCollisionFilter();
		coll.CategoryBits = 0;
		coll.MaskBits = 0; // Prev = 65512
		cubeObj.SetCollisionFilter(coll);

		moves13[0] = false;
		CreateTimer(500, 1, "CubeDelay", true);
	} else if((ice.IsMeleeAttacking || ice.IsJumpAttacking) && ice.IsWalking && cubeObj != null && cubeObj.GetBodyType() == BodyType.Static && moves13[0]) {
		Area a = ice.GetAABB();
		a.Grow(32, 30);
		a.Move(new Vector2(40*ice.FacingDirection, 0));

		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, ice));
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, a.Center)).Last();

		cubeObj.SetBodyType(BodyType.Dynamic);
		if(target != null)
			cubeObj.SetLinearVelocity((target.GetAABB().Center - cubeObj.GetAABB().Center + new Vector2(0, 8)) / 4);
		else
			cubeObj.SetLinearVelocity(new Vector2(16*ice.FacingDirection, 3));
	} else if(cubeObj != null && cubeObj.GetBodyType() == BodyType.Dynamic && moves13[0]) {
		Area a = cubeObj.GetAABB();

		bool cond1 = Array.Exists(Game.GetObjectsByArea(a), o => o.GetBodyType() == BodyType.Static && (o.GetCollisionFilter().MaskBits == 53193 || o.GetCollisionFilter().MaskBits == 61421) && o.GetAABB().Contains(a.Center));
		bool cond2 = Array.Exists(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, ice) && !p.IsRolling && !p.IsDiving);

		if(cond1 || cond2) {
			a.Grow(8, 8);

			IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, ice) && !p.IsRolling && !p.IsDiving);
			foreach(IPlayer p in foes) {
				Vector2 velo = p.GetAABB().Center - a.Center;
				p.DealDamage(25*p.GetModifiers().ProjectileDamageTakenModifier, ice.UniqueID);
				LaunchPlayer(p, (velo / velo.Length()) * 5);
			}

			IObject[] objects = Array.FindAll(Game.GetObjectsByArea(a), o => !(o is IPlayer));
			foreach(IObject o in objects)
				o.DealDamage(o.GetMaxHealth()*0.25f);

			Vector2[] circle = V2Circle(4, 11.3137f, MathHelper.PIOver4);
			for(int i=0;i<4;i++)
				Game.PlayEffect("DestroyDefault", a.Center + circle[i]);
			Game.PlayEffect("DestroyDefault", a.Center);
			Game.PlaySound("DestoryGlass", a.Center);
			Game.PlaySound("ShellBounce", a.Center);

			cubeObj.Destroy();
			cubeObj = null;

			moves13[0] = false;
			Game.PlayEffect("CFTXT", ice.GetAABB().Center, "5 seconds until use.");
			CreateTimer(5000, 1, "IceCD1", true);
		}
	}
	/// CUBE - END ///

	/// IGLOO - START ///
	if(ice.IsKicking && ice.IsWalking && moves13[1]) {
		IObject[] iglooObj = new IObject[4];
		Vector2 pos = ice.GetWorldPosition();

		iglooObj[0] = Game.CreateObject("Snow00A", pos + new Vector2(24*ice.FacingDirection, 8));
		iglooObj[0].SetSizeFactor(new Point(1, 2));

		for(int i=0;i<3;i+=2)
			iglooObj[i+1] = Game.CreateObject("Snow00A", pos + new Vector2((32 + (24*i))*ice.FacingDirection, 16));

		iglooObj[2] = Game.CreateObject("Snow00A", pos + new Vector2(ice.FacingDirection == 1 ? 40 : -72, 24));
		iglooObj[2].SetSizeFactor(new Point(3, 1));

		iceObj.AddRange(iglooObj);
		for(int x=0;x<iglooObj.Length;x++)
			CreateTimer(15000, 1, "ExpireIce", true);

		moves13[1] = false;
		Game.PlayEffect("CFTXT", ice.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "IceCD2", true);
	}
	/// IGLOO - END ///

	/// WALL - START ///
	if(ice.IsBlocking && ice.IsWalking && moves13[2]) {
		IObject wallObj = Game.CreateObject("Snow00A", ice.GetWorldPosition() + new Vector2(24*ice.FacingDirection, 24));
		wallObj.SetSizeFactor(new Point(1, 4));

		iceObj.Add(wallObj);
		CreateTimer(15000, 1, "ExpireIce", true);

		Game.PlaySound("SniperDraw", ice.GetAABB().Center, 0.25f); 
		Game.PlaySound("ShellBounce", ice.GetAABB().Center);

		moves13[2] = false;
		Game.PlayEffect("CFTXT", ice.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "IceCD3", true);
	}
	/// WALL - END ///

	/// BLIZZARD - START ///
	if(ice.IsCrouching && ice.IsWalking && moves13[3]) {
		Vector2 pos = ice.GetAABB().Center;
		blizzardTick = 160;
		
		blizzardTxt = (IObjectText)Game.CreateObject("BgText", pos);
		for(int i=0;i<7;i++)
			blizzardTxt.SetText(blizzardTxt.GetText() + (i%2 == 0 ? "* * * * * * * * * * *\n" : "  * * * * * * * * * *\n"));
		blizzardTxt.SetTextColor(new Color(191, 255, 255));
		blizzardTxt.SetTextAlignment(TextAlignment.Middle);

		for(int i=0;i<2;i++) {
			blizzardAud[i] = (IObjectSoundArea)Game.CreateObject("SoundArea", pos + new Vector2(-40, 20));
			blizzardAud[i].SetSizeFactor(new Point(11, 6));
			blizzardAud[i].SetAmbientSound("Wind" + (3+i).ToString());
			blizzardAud[i].SetVolume(75);
			blizzardAud[i].SetFadeInTime(200);
		}
		CreateTimer(50, blizzardTick, "BlizzardTick", true);

		moves13[3] = false;
		Game.PlayEffect("CFTXT", ice.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "IceCD4", true);
	}
	/// BLIZZARD - END ///

	/// PASSIVE: FREEZING HANDS ///
	if(ice.IsHoldingPlayerInGrab) {
		IPlayer p = Game.GetPlayer(ice.HoldingPlayerInGrabID);
		if(!p.IsDead && !frozen.Contains(p)) {
			PlayerModifiers mods = p.GetModifiers();
			mods.RunSpeedModifier -= 0.2f;
			mods.SprintSpeedModifier -= 0.2f;
			
			frozen.Add(p);
			p.SetProfile(p.GetProfile().Gender == Gender.Male ? prfFrozenM : prfFrozenF);
			p.SetModifiers(mods);

			Game.PlayEffect("CFTXT", p.GetAABB().Center, "FROZEN!!");
			Game.PlaySound("SniperDraw", p.GetAABB().Center, 0.25f); 
			Game.PlaySound("ShellBounce", p.GetAABB().Center); 
		}
	}
}

public void CubeDelay(TriggerArgs args) {
	moves13[0] = true;
}

public void BlizzardTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	if(ice != null) {
		Area a = ice.GetAABB();
		a.Grow(36, 14);
		blizzardTick--;

		blizzardTxt.SetWorldPosition(a.Center);
		for(int i=0;i<2;i++)
			blizzardAud[i].SetWorldPosition(a.Center + new Vector2(-40, 20));

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, ice));
		foreach(IPlayer p in foes) {
			p.DealDamage(0.5f*p.GetModifiers().ProjectileDamageTakenModifier, ice.UniqueID);
			if(blizzardTick % 5 == 0) {
				Game.PlayEffect("H_T", p.GetAABB().Center);
				Game.PlaySound("ShellBounce", p.GetAABB().Center, 0.1f);
				Game.PlaySound("DestroyGlassSmall", p.GetAABB().Center, 0.075f);
			}
		}
	}

	if(!timer.IsTimerRunning || ice == null) {
		blizzardTick = 0;
		blizzardTxt.Remove();
		for(int i=0;i<2;i++)
			blizzardAud[i].Remove();
		timer.Remove();
	}
}

public void ExpireIce(TriggerArgs args) {
	iceObj[0].Remove();
	iceObj.Remove(iceObj[0]);
}

public void IceCD1(TriggerArgs args) {
	moves13[0] = true;
	Game.PlayEffect("CFTXT", ice.GetAABB().Center, "Cube is ready!");
	((IObject)args.Caller).Remove();
}

public void IceCD2(TriggerArgs args) {
	moves13[1] = true;
	Game.PlayEffect("CFTXT", ice.GetAABB().Center, "Igloo is ready!");
	((IObject)args.Caller).Remove();
}

public void IceCD3(TriggerArgs args) {
	moves13[2] = true;
	Game.PlayEffect("CFTXT", ice.GetAABB().Center, "Wall is ready!");
	((IObject)args.Caller).Remove();
}

public void IceCD4(TriggerArgs args) {
	moves13[3] = true;
	Game.PlayEffect("CFTXT", ice.GetAABB().Center, "Blizzard is ready!");
	((IObject)args.Caller).Remove();
}










///// WIND MAGE /////

IPlayer wind = null;
List<IPlayer> launchedWI = new List<IPlayer>(), hitWI = new List<IPlayer>();
IProfile prfWind = new IProfile();
IObject[] galeObj = new IObject[2], wallObj = new IObject[6], auraObj = new IObject[4], windObj = new IObject[6];
IObjectSoundArea vortexAud;
int galeCycle = 1, tempWI;
bool[] moves14 = {true, true, true, true};

public void SpawnWindM(IPlayer p) {
	wind = p;
	wind.SetProfile(prfWind);
	CreateTimer(50, 0, "WindTick", true);
}

public void WindTick(TriggerArgs args) {
	/// GALE - START ///
	if((wind.IsMeleeAttacking || wind.IsJumpAttacking) && wind.IsWalking && moves14[0]) {
		for(int i=0;i<galeObj.Length;i++) {
			galeObj[i] = Game.CreateObject("BgGlass00A", wind.GetWorldPosition() + new Vector2((i*2)*wind.FacingDirection, wind.IsCrouching ? 4 : 8));
			galeObj[i].SetAngle(wind.FacingDirection == 1 ? 3.93f : 0.79f);
		}
		galeObj[0].SetColor1("BgGray");
		Game.PlaySound("Wings", wind.GetAABB().Center, 1/3f);
		CreateTimer(50, 16, "GaleTick", true);
		
		moves14[0] = false;
		Game.PlayEffect("CFTXT", wind.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "WindCD1", true);
	}
	/// GALE - END ///

	/// WIND AURA - START ///
	if(wind.IsCrouching && wind.IsWalking && moves14[1]) {
		for(int i=0;i<4;i++)
			auraObj[i] = Game.CreateObject("SteamSpawner", wind.GetAABB().Center);

		wind.SetSpeedBoostTime(9999999);
		
		moves14[1] = false;
		CreateTimer(50, 200, "AuraTick", true);
	}
	/// WIND AURA - END ///

	/// WINDWALL - START ///
	if(wind.IsBlocking && wind.IsWalking && moves14[2]) {
		Vector2 origin = wind.GetWorldPosition();
		if(wind.IsInMidAir)
			origin += new Vector2(0, -24);

		for(int x=0;x<5;x++)
			wallObj[x] = Game.CreateObject("BgSteamSpawner", origin + new Vector2(24*wind.FacingDirection, 12*x));

		wallObj[5] = Game.CreateObject("InvisibleBlock", wallObj[4].GetWorldPosition());
		wallObj[5].SetSizeFactor(new Point(1, 7));

		CollisionFilter cf = wallObj[5].GetCollisionFilter();
		cf.BlockExplosions = true;
		cf.CategoryBits = 0; // Previous -> 4
		cf.MaskBits = 53193; // Previous -> 4114
		wallObj[5].SetCollisionFilter(cf);
		CreateTimer(5000, 1, "RemoveWindwall", true);

		moves14[2] = false;
		Game.PlayEffect("CFTXT", wind.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "WindCD3", true);
	}
	/// WINDWALL - END ///

	/// TWISTER - START ///
	if(wind.IsKicking && wind.IsWalking && moves14[3]) {
		tempWI = wind.FacingDirection;
		for(int x=0;x<5;x++) {
			windObj[x] = Game.CreateObject("BgAdobe00E", wind.GetWorldPosition() + new Vector2(8*tempWI+(-4*x), (8*x)));
			windObj[x].SetSizeFactor(new Point(2+x, 1));
			if((x-1)%2 == 0)
				windObj[x].SetColor1("BgGray");
		}
		windObj[5] = Game.CreateObject("InvisibleBlockNoCollision", windObj[0].GetWorldPosition() + new Vector2(0, 32));
		windObj[5].SetSizeFactor(new Point(2, 5));

		vortexAud = (IObjectSoundArea)Game.CreateObject("SoundArea", windObj[3].GetWorldPosition() + new Vector2(-32, 2));
		vortexAud.SetSizeFactor(new Point(12, 5));
		vortexAud.SetAmbientSound("Wind1");
		vortexAud.SetFadeInTime(500);
		vortexAud.SetVolume(100);
		CreateTimer(50, 80, "TwisterTick", true);

		moves14[3] = false;
		Game.PlayEffect("CFTXT", wind.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "WindCD4", true);
	}
	/// TWISTER - END ///
}

public void GaleTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	for(int x=0;x<galeCycle;x++) {
		Area a = galeObj[1].GetAABB();
		a.Grow(-2, -2);
		Game.PlayEffect("STM", galeObj[0].GetWorldPosition());

		IPlayer[] foes =  Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, wind) && !p.IsDiving && !p.IsRolling && !hitWI.Contains(p));
		foreach(IPlayer p in foes) {
			hitWI.Add(p);
			p.DealDamage(25*p.GetModifiers().ProjectileDamageTakenModifier, wind.UniqueID);
			Game.PlayEffect("Smack", a.Center);
			Game.PlaySound("Wings", p.GetAABB().Center, 0.5f);
			Game.PlaySound("MeleeHitBlunt", p.GetAABB().Center);
		}
	
		foreach(IObject o in Game.GetObjectsByArea(a)) {
			if(!(o is IPlayer) && o.Destructable) {
				o.DealDamage(o.GetMaxHealth()*0.1f);
				Game.PlayEffect("Smack", o.GetWorldPosition());
				Game.PlaySound("Wings", o.GetWorldPosition(), 0.1f);
			} else if(o.GetCollisionFilter().MaskBits == 61421 && o.GetAABB().Contains(a.Center)) {
				timer.StopTimer();
			} else if(galeCycle == 1 && o.GetCollisionFilter().MaskBits == 53193)
				galeCycle = 2;
		}

		for(int i=0;i<galeObj.Length;i++)
			galeObj[i].SetWorldPosition(galeObj[i].GetWorldPosition() + new Vector2(8*(galeObj[i].GetAngle() == 3.93f ? 1 : -1), 0));
	}

	if(!timer.IsTimerRunning || wind == null) {
		for(int i=0;i<galeObj.Length;i++)
			galeObj[i].Remove();
		hitWI.Clear();
		timer.Remove();
	}
}

public void TwisterTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(windObj[5].GetAABB()), p => !IsOnSameTeam(p, wind) && !launchedWI.Contains(p));
	foreach(IPlayer p in foes) {
		LaunchPlayer(p, new Vector2(0, 18));
		launchedWI.Add(p);
		Game.PlayEffect("TR_SPR", p.GetWorldPosition(), p.UniqueID, "TR_D", 1);
		Game.PlaySound("Wings", p.GetWorldPosition());	
	}

	IObject[] objects = Array.FindAll(Game.GetObjectsByArea(windObj[5].GetAABB()), o => !(o is IPlayer) && o.GetBodyType() == BodyType.Dynamic);
	foreach(IObject o in objects) {
		o.DealDamage(o.GetMaxHealth()*0.05f);
		o.SetLinearVelocity(new Vector2(0, 6));
		Game.PlaySound("Wings", o.GetWorldPosition(), 0.05f);
	}

	for(int x=0;x<windObj.Length;x++)
		windObj[x].SetWorldPosition(windObj[x].GetWorldPosition() + new Vector2(3.5f*tempWI, 0));
	vortexAud.SetWorldPosition(windObj[3].GetWorldPosition() + new Vector2(-32, 2));

	if(!timer.IsTimerRunning || wind == null) {
		for(int x=0;x<windObj.Length;x++)
			windObj[x].Remove();
		vortexAud.Remove();

		launchedWI.Clear();
		tempWI = 0;

		timer.Remove();
	}
}

public void RemoveWindwall(TriggerArgs args) {
	for(int x=0;x<wallObj.Length;x++)
		wallObj[x].Remove();
	((IObject)args.Caller).Remove();
}

public void AuraTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	
	if(wind != null) {
		Area a = wind.GetAABB();
		a.Grow(-2, 0);

		Vector2[] circle = V2Circle(4, 5.6569f, MathHelper.PIOver4);
		for(int i=0;i<4;i++)
			auraObj[i].SetWorldPosition(a.Center + circle[i]);
		Game.PlayEffect("STM", a.Center);

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, wind));
		foreach(IPlayer p in foes) {
			if((p.IsDisabled && p.IsInMidAir && !p.IsCaughtByPlayerInDive && !p.IsCaughtByPlayerInGrab) || p.IsStaggering) {
				Vector2 velo = p.GetAABB().Center - a.Center;
				p.SetLinearVelocity(new Vector2(Math.Sign(velo.X), 1) * 8);
				Game.PlaySound("Wings", p.GetWorldPosition(), 1/3f);
			} else
				p.DealDamage(0.375f*p.GetModifiers().MeleeDamageTakenModifier, wind.UniqueID);
		}
	}

	if(!timer.IsTimerRunning || wind == null || wind.IsDead) {
		for(int x=0;x<auraObj.Length;x++)
			auraObj[x].Remove();
			
		if(!wind.IsRemoved && !wind.IsDead)
			wind.SetSpeedBoostTime(0);

		timer.Remove();
		CreateTimer(20000, 1, "WindCD2", true);
		Game.PlayEffect("CFTXT", wind.GetAABB().Center, "20 seconds until use.");
	}
}

public void WindCD1(TriggerArgs args) {
	galeCycle = 1;
	moves14[0] = true;
	Game.PlayEffect("CFTXT", wind.GetAABB().Center, "Gale is ready!");
	((IObject)args.Caller).Remove();
}

