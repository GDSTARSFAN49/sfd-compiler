public void SpawnRedHulk(IPlayer p) {
	redHulk = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth += GIANT;
	mods.CurrentHealth = mods.MaxHealth;
	mods.FireDamageTakenModifier = 0;
	mods.ImpactDamageTakenModifier = 0;
	mods.MeleeDamageDealtModifier *= STRENGTH_2;
	mods.MeleeForceModifier *= STRENGTH_1;
	mods.CanBurn = 0;
	mods.RunSpeedModifier += SLOW;
	mods.SprintSpeedModifier += SLOW;
	mods.SizeModifier = 1.25f;

	redHulk.SetProfile(prfRedHulk);
	redHulk.SetModifiers(mods);
