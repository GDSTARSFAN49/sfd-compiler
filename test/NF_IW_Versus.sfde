	stone.SetProfile(prfStone);
	CreateTimer(50, 0, "StoneTick", true);
}

public void StoneTick(TriggerArgs args) {
	/// BLOCK - START ///
	if(stone.IsMeleeAttacking && stone.IsWalking && moves12[0]) {
		IObject blockObj = Game.CreateObject("StoneWeak00C", stone.GetAABB().Center + new Vector2(14*stone.FacingDirection, 2));
		blockObj.SetBodyType(BodyType.Dynamic);
		blockObj.SetLinearVelocity(new Vector2(20*stone.FacingDirection, 1));
		blockObj.DealDamage(blockObj.GetMaxHealth()*9/10f);

		moves12[0] = false;
		Game.PlayEffect("CFTXT", stone.GetAABB().Center, "3 seconds until use.");
		CreateTimer(3000, 1, "StoneCD1", true);
	}
	/// BLOCK - END ///

	/// CAGE - START ///
	if(stone.IsKicking && stone.IsWalking && moves12[1]) {
		for(int x=0;x<6;x++)
			Game.CreateObject("Concrete01Weak", stone.GetWorldPosition() + new Vector2((28 + (56*(x/3)))*stone.FacingDirection, 4 + (16*(x%3))));

		moves12[1] = false;
		Game.PlayEffect("CFTXT", stone.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "StoneCD2", true);
	}
	/// CAGE - END ///

	/// WALL - START ///
	if(stone.IsBlocking && stone.IsWalking && moves12[2]) {
		for(int x=0;x<2;x++)
			Game.CreateObject("Concrete01Weak", stone.GetWorldPosition() + new Vector2(20*stone.FacingDirection, 4 + (16*x)));

		moves12[2] = false;
		Game.PlayEffect("CFTXT", stone.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "StoneCD3", true);
	}
	/// WALL - END ///

	/// WRECKING BALL - START ///
	if(stone.IsJumpAttacking && stone.IsWalking && moves12[3]) {
		ballObj = Game.CreateObject("ConcretePipe01", stone.GetWorldPosition() + new Vector2(48*stone.FacingDirection, 100));
		ballObj.SetAngularVelocity(MathHelper.PI*-4*stone.FacingDirection);

		moves12[3] = false;
		Game.PlayEffect("CFTXT", stone.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "StoneCD4", true);
