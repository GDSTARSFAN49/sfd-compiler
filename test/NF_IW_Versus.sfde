	moves14[1] = true;
	Game.PlayEffect("CFTXT", wind.GetAABB().Center, "Wind Aura is ready!");
	((IObject)args.Caller).Remove();
}

public void WindCD3(TriggerArgs args) {
	moves14[2] = true;
	Game.PlayEffect("CFTXT", wind.GetAABB().Center, "Windwall is ready!");
	((IObject)args.Caller).Remove();
}

public void WindCD4(TriggerArgs args) {
	moves14[3] = true;
	Game.PlayEffect("CFTXT", wind.GetAABB().Center, "Twister is ready!");
	((IObject)args.Caller).Remove();
}










///// FIRE MAGE /////

IPlayer fire = null;
IProfile prfFire = new IProfile();
IObject volcano, magma;
IObjectSoundArea magmaSound;
Vector2 eruptPos;
int eruptTick = 30, buildErupt = 4, burnTick = 300, magmaTick = 60;
float eruptDist = 80, burnHP = 30;
bool[] moves15 = {true, true, true, true};

public void SpawnFireM(IPlayer p) {
	fire = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.FireDamageTakenModifier = 0;
	mods.CanBurn = 0;
	
	fire.SetProfile(prfFire);
	fire.SetModifiers(mods);
	CreateTimer(50, 0, "FireTick", true);
}

public void FireTick(TriggerArgs args) {
	/// FIREBALL - START ///
	if((fire.IsMeleeAttacking || fire.IsJumpAttacking) && fire.IsWalking && moves15[0]) {
		Game.SpawnFireNodes(fire.GetWorldPosition() + new Vector2(8*fire.FacingDirection, 6), 30, new Vector2(12*fire.FacingDirection, 0.5f), 1, 0, FireNodeType.Flamethrower);
		Game.TriggerFireplosion(fire.GetWorldPosition() + new Vector2(8*fire.FacingDirection, 6), 12);
		Game.PlaySound("Flamethrower", fire.GetAABB().Center);

		moves15[0] = false;
		Game.PlayEffect("CFTXT", fire.GetAABB().Center, "5 seconds until use.");
		CreateTimer(5000, 1, "FireCD1", true);
	}
	/// FIREBALL - END ///

	/// ERUPTION - START ///
	if(fire.IsKicking && fire.IsWalking && moves15[1]) {
		Area a = fire.GetAABB();
		a.Grow(72, -4);
		Vector2 pos = fire.GetAABB().Center;

		eruptPos = fire.GetWorldPosition();
		eruptTick = 30;
		buildErupt = 4;

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, fire) && Math.Abs(p.GetAABB().Center.X - pos.X) < eruptDist);
		if(foes.Length != 0) {
			IPlayer target = Enumerable.OrderByDescending(foes, p => Math.Abs(p.GetAABB().Center.X - pos.X)).Last();
			eruptDist = target.GetWorldPosition().X - pos.X;
		} else
			eruptDist = 80*fire.FacingDirection;

		CreateTimer(100, 4, "Erupt", true);
		Game.PlaySound("Flamethrower", fire.GetAABB().Center);

		moves15[1] = false;
		Game.PlayEffect("CFTXT", fire.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "FireCD2", true);
	} else if(buildErupt == 0 && eruptTick > 0 && !moves15[1]) {
		if(eruptTick % 4 == 0)
			Game.SpawnFireNodes(volcano.GetWorldPosition() + new Vector2(0, 12), 10, new Vector2(0, 4.5f), 1.5f, 4.5f, FireNodeType.Flamethrower); 

		eruptTick--;
		if(eruptTick == 0 || fire.IsDead) {
			volcano.Remove();
			eruptTick = 0;
		}
	}
	/// ERUPTION - END ///

	/// HEART OF FLAME - START ///
	if(fire.IsBlocking && fire.IsWalking && moves15[2]) {
		PlayerModifiers mods = fire.GetModifiers();
		mods.CanBurn = 1;
		fire.SetModifiers(mods);

		fire.SetMaxFire();
		CreateTimer(50, burnTick, "Heartbeat", true);
		Game.PlaySound("Flamethrower", fire.GetAABB().Center);

		moves15[2] = false;
	}
	/// HEART OF FLAME - END ///

	/// HELLSCAPE - START ///
	if(fire.IsJumpKicking && fire.IsWalking && moves15[3]) {
		Vector2[] circle = V2Circle(4, 16);
		for(int i=0;i<4;i++)
			Game.SpawnFireNodes(fire.GetAABB().Center, 25, circle[i], 2, 1, FireNodeType.Flamethrower);

		Area a = fire.GetAABB();
		a.Grow(32, 30);
		
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, fire));
		foreach(IPlayer p in foes) {
			p.DealDamage(25*p.GetModifiers().CanBurn, fire.UniqueID);
			p.SetMaxFire();
			Game.PlayEffect("EXP", p.GetAABB().Center);
			Game.PlaySound("Flaregun", p.GetAABB().Center);
			Game.PlaySound("Explosion", p.GetAABB().Center, 0.75f);
		}
		Game.PlaySound("Flamethrower", fire.GetAABB().Center);

		magma = Game.CreateObject("BgDirt00B", fire.GetAABB().Center + new Vector2(-24, 28));
		magma.SetSizeFactor(new Point(4, 8));
		magma.SetColor1("BgLightRed");

		magmaSound = (IObjectSoundArea)Game.CreateObject("SoundArea", fire.GetAABB().Center + new Vector2(-28, 28));
		magmaSound.SetSizeFactor(new Point(8, 8));
		magmaSound.SetAmbientSound("Burning1");
		magmaSound.SetVolume(15);
		magmaSound.SetFadeInTime(500);

		magmaTick = 60;
		CreateTimer(50, magmaTick, "MagmaTick", true);
		
		moves15[3] = false;
		Game.PlayEffect("CFTXT", fire.GetAABB().Center, "40 seconds until use.");
		CreateTimer(40000, 1, "FireCD4", true);
	}
	/// HELLSCAPE - START ///
}

public void Erupt(TriggerArgs args) {
	if(fire == null || fire.IsDead)
		return;

	buildErupt--;
	switch(buildErupt) {
		case 0:
			volcano = Game.CreateObject("BgCarnivalTent01B", eruptPos + new Vector2(eruptDist, 0));
			volcano.SetColor1("BgLightBrown");
			Game.PlayEffect("CAM_S", volcano.GetWorldPosition(), 2.5f, 1000, true);
			Game.PlayEffect("CFTXT", volcano.GetWorldPosition() + new Vector2(0, 8), "BOOOOOOM!");
			Game.PlaySound("BarrelExplode", volcano.GetWorldPosition());
			Game.PlaySound("Explosion", volcano.GetWorldPosition());

			IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(volcano.GetAABB()), p => !IsOnSameTeam(p, fire));
			foreach(IPlayer p in foes)
				LaunchPlayer(p, new Vector2((p.GetAABB().Center.X - volcano.GetAABB().Center.X)/4, 16));

			IObject[] objects = Array.FindAll(Game.GetObjectsByArea(volcano.GetAABB()), o => !(o is IPlayer));
			foreach(IObject o in objects) {
				o.SetLinearVelocity(new Vector2((o.GetAABB().Center.X - volcano.GetAABB().Center.X)/4, 7.5f));
				o.SetAngularVelocity(MathHelper.PI);
				o.DealDamage(o.GetMaxHealth(), fire.UniqueID);
			}

			((IObject)args.Caller).Remove();
			break;
		case 1:
			for(int x=0;x<5;x++) 
				Game.SpawnFireNodes(eruptPos + new Vector2((eruptDist + (2 * (x - 2))) * 0.6f, 0), 3, new Vector2(0, 5), 0, 0.25f, FireNodeType.Flamethrower);
			Game.PlayEffect("CFTXT", eruptPos + new Vector2(eruptDist * 0.6f, 0), "1...");
			break;
		case 2:
			for(int x=0;x<5;x++) 
				Game.SpawnFireNodes(eruptPos + new Vector2((eruptDist + (2 * (x - 2))) * 0.3f, 0), 2, new Vector2(0, 3), 0, 0.1f, FireNodeType.Flamethrower);
			Game.PlayEffect("CFTXT", eruptPos + new Vector2(eruptDist * 0.3f, 0), "2...");
			break;
		case 3:
			for(int x=0;x<3;x++) 
				Game.SpawnFireNodes(eruptPos + new Vector2((eruptDist + (2 * (x - 1))) * 0.15f, 0), 2, new Vector2(0, 3), 0, 0, FireNodeType.Flamethrower);
			Game.PlayEffect("CFTXT", eruptPos + new Vector2(eruptDist * 0.15f, 0), "3...");
			break;
	}
}

public void Heartbeat(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	PlayerModifiers mods = fire.GetModifiers();
	mods.CurrentHealth = fire.GetModifiers().CurrentHealth + burnHP/burnTick; // HEALTH REGEN (MAX: 50 HP)
	fire.SetModifiers(mods);

	if(!timer.IsTimerRunning || fire == null || !fire.IsBurning || fire.IsDead) {
		fire.ClearFire();
		mods.CanBurn = 0;
		fire.SetModifiers(mods);

		if(!timer.IsTimerRunning) {
			Game.SpawnFireNodes(fire.GetWorldPosition(), 40, 7.5f, FireNodeType.Flamethrower);
			Game.TriggerFireplosion(fire.GetWorldPosition() + new Vector2(0, 6), 16);
		}

		Game.PlayEffect("CFTXT", fire.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "FireCD3", true);
		timer.Remove();
	}
}

public void MagmaTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(magma.GetAABB()), p => !IsOnSameTeam(p, fire));
	foreach(IPlayer p in foes) {
		p.DealDamage(1*p.GetModifiers().FireDamageTakenModifier, fire.UniqueID);
		Game.PlayEffect("STM", p.GetAABB().Center);
	}

	if(--magmaTick % 20 == 0) {
		magma.SetSizeFactor(new Point(magma.GetSizeFactor().X-1, magma.GetSizeFactor().Y-2));
		magma.SetWorldPosition(magma.GetWorldPosition() + new Vector2(8, -8));
		magmaSound.SetSizeFactor(new Point(magmaSound.GetSizeFactor().X-2, magmaSound.GetSizeFactor().Y-2));
		magmaSound.SetWorldPosition(magmaSound.GetWorldPosition() + new Vector2(8, -8));
	}

	if(!timer.IsTimerRunning || fire.IsDead) {
		magma.Remove();
		magmaSound.Remove();
		timer.Remove();
	}
}

public void FireCD1(TriggerArgs args) {
	moves15[0] = true;
	Game.PlayEffect("CFTXT", fire.GetAABB().Center, "Fireball is ready!");
	((IObject)args.Caller).Remove();
}

public void FireCD2(TriggerArgs args) {
	moves15[1] = true;
	Game.PlayEffect("CFTXT", fire.GetAABB().Center, "Eruption is ready!");
	((IObject)args.Caller).Remove();
}

public void FireCD3(TriggerArgs args) {
	moves15[2] = true;
	Game.PlayEffect("CFTXT", fire.GetAABB().Center, "Heart of Fire is ready!");
	((IObject)args.Caller).Remove();
}

public void FireCD4(TriggerArgs args) {
	moves15[3] = true;
	Game.PlayEffect("CFTXT", fire.GetAABB().Center, "Hellscape is ready!");
	((IObject)args.Caller).Remove();
}










///// GRAVITY MAGE /////

IPlayer grav = null;
List<IPlayer> fliers = new List<IPlayer>(), grounded = new List<IPlayer>();
IProfile prfGrav = new IProfile();
IObject gravHitbox; 
IObject[] groundObj;
IObjectAreaTrigger grounder;
IObjectText repelHitbox = null, pullHitbox = null, downHitbox = null;
int repelDelay, pullDelay;
bool[] moves16 = {true, true, true, true};

public void SpawnGravityM(IPlayer p) {
	grav = p;
	grav.SetProfile(prfGrav);
	CreateTimer(50, 0, "GravityTick", true);
}

public void GravityTick(TriggerArgs args) {
	/// REPEL - START ///
	if(grav.IsWalking && (grav.IsMeleeAttacking || grav.IsJumpAttacking) && gravHitbox == null && downHitbox == null && moves16[0]) {
		gravHitbox = CreateHitbox(grav.GetAABB().Center + new Vector2(-24, 24), new Point(7, 7));
		repelDelay = 5;
		moves16[0] = false;
	} else if(!moves16[0] && repelDelay-- > 0) {
		gravHitbox.SetWorldPosition(grav.GetAABB().Center + new Vector2(-24, grav.IsCrouching ? 20 : 24));
		
		if(repelDelay == 0 || grav.IsDead) {
			if(repelDelay == 0) {
				Area a = gravHitbox.GetAABB();

				IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, grav));
				foreach(IPlayer p in foes) {
					if(fliers.Contains(p))
						fliers.Remove(p);

					Vector2 velo = p.GetAABB().Center - a.Center;
					p.DealDamage(7.5f*p.GetModifiers().ImpactDamageTakenModifier, grav.UniqueID);
					LaunchPlayer(p, (velo / velo.Length()) * 8);
					Game.PlaySound("PlayerLandKnockdown", p.GetAABB().Center, 0.5f);
				}

				IObject[] objects = Array.FindAll(Game.GetObjectsByArea(a), o => !(o is IPlayer) && o.Destructable);
				foreach(IObject o in objects) {
					Vector2 velo = o.GetAABB().Center - a.Center;
					o.SetLinearVelocity((velo / velo.Length()) * 8);
					o.DealDamage(o.GetMaxHealth()/3f);
				}
			} else
				repelDelay = 0;

			gravHitbox.Remove();
			gravHitbox = null;
			Game.PlayEffect("CFTXT", grav.GetAABB().Center, "10 seconds until use.");
			CreateTimer(10000, 1, "GravityCD1", true);
		}
	}
	/// REPEL - END ///

	/// PULL - START ///
	if(grav.IsWalking && grav.IsBlocking && moves16[1] && gravHitbox == null && downHitbox == null) {
		gravHitbox = CreateHitbox(grav.GetAABB().Center + new Vector2(-40, grav.IsCrouching ? 36 : 40), new Point(11, 11));
		pullDelay = 5;
		moves16[1] = false;
	} else if(!moves16[1] && pullDelay-- > 0) {
		gravHitbox.SetWorldPosition(grav.GetAABB().Center + new Vector2(-40, grav.IsCrouching ? 36 : 40));

		if(pullDelay == 0 || grav.IsDead) {
			if(pullDelay == 0) {
				Area a = gravHitbox.GetAABB();

				IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, grav));
				foreach(IPlayer p in foes) {
					Vector2 velo = p.GetAABB().Center - a.Center;

					if(fliers.Contains(p))
						fliers.Remove(p);

					p.DealDamage(7.5f*p.GetModifiers().ImpactDamageTakenModifier, grav.UniqueID);
					LaunchPlayer(p, velo / -5);
					Game.PlaySound("PlayerLandKnockdown", p.GetAABB().Center, 0.5f);
				}
			} else
				pullDelay = 0;

			gravHitbox.Remove();
			gravHitbox = null;
			Game.PlayEffect("CFTXT", grav.GetAABB().Center, "5 seconds until use.");
			CreateTimer(5000, 1, "GravityCD2", true);
		} 
	}
	/// PULL - END ///

	/// ANTI-GRAVITY - START ///
	if(grav.IsWalking && grav.IsJumpKicking && gravHitbox == null && downHitbox == null && moves16[2])
		downHitbox = CreateText(grav.GetAABB().Center, "[     !     ]", Color.Red, 8/3f, TextAlignment.Middle);
	else if(downHitbox != null && grav.IsInMidAir)
		downHitbox.SetWorldPosition(grav.GetAABB().Center);
	else if(downHitbox != null && (grav.IsLedgeGrabbing || grav.IsClimbing || grav.IsDead)) {
		downHitbox.Remove();
		downHitbox = null;
	} else if(downHitbox != null && grav.IsOnGround) { 
		Area a = grav.GetAABB();
		a.Grow(20, 0);

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, grav) && !grounded.Contains(p));
		foreach(IPlayer p in foes) {
			p.SetLinearVelocity(new Vector2(0, 3));
			fliers.Add(p);
		}
		downHitbox.Remove();
		downHitbox = null;

		moves16[2] = false;
		CreateTimer(50, 100, "AntiTick", true);
	}
	/// ANTI-GRAVITY - END ///

	/// AMPED GRAVITY - START ///
	if(grav.IsWalking && grav.IsKicking && moves16[3]) {
		Vector2 pos = grav.GetAABB().Center + new Vector2(32, grav.IsCrouching ? 28 : 32);

		groundObj = new IObject[5];
		for(int i=0;i<groundObj.Length;i++) {
			groundObj[i] = Game.CreateObject("BgSymbol00Arrow", pos + new Vector2(0, -16*i));
			groundObj[i].SetAngle(4.71f);
			groundObj[i].SetSizeFactor(new Point(1, 9));
			groundObj[i].SetColor1("BgLightRed");
		}
		grounder = CreateArea(pos + new Vector2(-64, 0), new Point(9, 9), "ApplyGround", "RemoveGround");

		moves16[3] = false;
		CreateTimer(50, 200, "GroundTick", true);
	}
	/// AMPED GRAVITY - START ///

	/// HOVER - START ///
	if(grav.IsWalking && !grav.IsKicking && !grav.IsDisabled && grav.GetLinearVelocity().Y < 1 && grav.GetEnergy() > 0 && downHitbox == null) {
		grav.SetLinearVelocity(new Vector2(1.5f*grav.FacingDirection, 7.5f/8.5f));
		PlayerModifiers tempMods = grav.GetModifiers();
		tempMods.CurrentEnergy = grav.GetEnergy() > 0.5f ? grav.GetEnergy() - 0.5f : 0;
		grav.SetModifiers(tempMods);
	}
	/// HOVER - END ///

	/// PASSIVE: SLOWFALL ///
	if(!grav.IsDisabled && grav.GetLinearVelocity().Y <= -6)
		grav.SetLinearVelocity(new Vector2(0, -6));
}

public void AntiTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	foreach(IPlayer p in fliers)
		p.SetLinearVelocity(new Vector2(0, 3));

	if(fliers.Count == 0)
		timer.StopTimer();

	if(!timer.IsTimerRunning || grav == null || grav.IsDead) {
		fliers.Clear();
		timer.Remove();
		Game.PlayEffect("CFTXT", grav.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "GravityCD3", true);
	}
}

public void GroundTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;
	if(grav != null) {
		Vector2 pos = grav.GetAABB().Center + new Vector2(32, 32);

		for(int i=0;i<groundObj.Length;i++)
			groundObj[i].SetWorldPosition(pos + new Vector2(0, -16*i));
		grounder.SetWorldPosition(pos + new Vector2(-64, 0));
	}
	
	foreach(IPlayer p in grounded) {
		Vector2 velo = p.GetLinearVelocity();
		if(velo.Y >= 0)
			p.SetLinearVelocity(velo/1.5f + new Vector2(0, -1));
		else if(velo.Y < 0 && velo.Y > -20)
			p.SetLinearVelocity(new Vector2(0, velo.Y*4/3f));
		else if(velo.Y <= -20)
			LaunchPlayer(p, new Vector2(0, -24));
	}

	Area a = grounder.GetAABB();
	foreach(IProjectile pr in Game.GetProjectiles()) {
		if(a.Contains(pr.Position)) {
			pr.Direction = new Vector2(0, -1);
			pr.Velocity = new Vector2(0, -1000);
		}
	}

	if(!timer.IsTimerRunning || grav == null || grav.IsDead) {
		grounded.Clear();
		for(int i=0;i<groundObj.Length;i++)
			groundObj[i].Remove();
		grounder.Remove();
		grounder = null;

		timer.Remove();
		Game.PlayEffect("CFTXT", grav.GetAABB().Center, "30 seconds until use.");
		CreateTimer(30000, 1, "GravityCD4", true);
	}
}

public void ApplyGround(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(!IsOnSameTeam(p, grav)) {
		grounded.Add(p);
		if(fliers.Contains(p)) {
			LaunchPlayer(p, new Vector2(0, -2));
			fliers.Remove(p);
			Game.PlaySound("PlayerLandKnockdown", p.GetWorldPosition());
		}
		Game.PlayEffect("CFTXT", p.GetWorldPosition(), "GROUNDED!");
	}
}

public void RemoveGround(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;
	if(grounded.Contains(p))
		grounded.Remove(p);
}

public void GravityCD1(TriggerArgs args) {
	moves16[0] = true;
	Game.PlayEffect("CFTXT", grav.GetAABB().Center, "Repel is ready!");
	((IObject)args.Caller).Remove();
}

