public IObjectAreaTrigger CreateArea(Vector2 pos, Point size, string inMethod="", string outMethod="") {
	IObjectAreaTrigger area = (IObjectAreaTrigger)Game.CreateObject("AreaTrigger", pos);
	area.SetSizeFactor(size);
	area.SetEnabledObjects(AreaTriggerEnabledObjects.Players);
	area.SetOnEnterMethod(inMethod);
	area.SetOnLeaveMethod(outMethod);

	return area;
}

public IObjectText CreateText(Vector2 pos, string str, Color color, float scale=1, TextAlignment alignment=TextAlignment.Middle) {
	IObjectText text = (IObjectText)Game.CreateObject("Text", pos);
	text.SetText(str);
	text.SetTextColor(color);
	text.SetTextScale(scale);
	text.SetTextAlignment(alignment);
	
	return text;
}

public IObjectTimerTrigger CreateTimer(int interval, int count, string method, bool start=false) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
	timer.SetIntervalTime(interval);
	timer.SetRepeatCount(count);
	timer.SetScriptMethod(method);
	if(start)
		timer.Trigger();
		
	return timer;
}

public Vector2[] V2Circle(int num, float radius, float initial=0) {
	Vector2[] circle = new Vector2[num];
	float angle = MathHelper.TwoPI/num;

	for(int x=0;x<num;x++)
		circle[x] = new Vector2((float)(radius*Math.Cos(initial + angle*x)), (float)(radius*Math.Sin(initial + angle*x)));

	return circle;
}

public bool IsInArea(IObject o1, IObject o2) {
	Area a1 = o1.GetAABB(), a2 = o2.GetAABB();
	float angle = o1.GetAngle() % MathHelper.TwoPI;
	angle += angle < 0 ? MathHelper.TwoPI : 0;

	if(a1.Intersects(a2)) {
		if(angle % MathHelper.PIOver2 <= 0.018) {
			return true;
		} else {
			Point size = o1.GetSizeFactor();
			bool isHorz = size.X >= size.Y;

			Vector2 origin;
			if(isHorz)
				origin = angle % MathHelper.PI < MathHelper.PIOver2 ? a1.BottomLeft : a1.TopLeft;
			else
				origin = angle % MathHelper.PI < MathHelper.PIOver2 ? a1.TopLeft : a1.BottomLeft;

			float v = origin.Y == a1.Bottom ? 1 : -1, m = a1.Height/a1.Width * v;
			float x1 = (v == 1 ? a2.Left : a2.Right) - origin.X, x2 = (v == 1 ? a2.Right : a2.Left) - origin.X;
			float y1 = a2.Top - origin.Y, y2 = a2.Bottom - origin.Y;

			float sin = (float)Math.Sin(angle % MathHelper.PI), cos = (float)Math.Abs(Math.Cos(angle % MathHelper.PI));
			float h = 8 * (isHorz ? size.Y : size.X) * (isHorz ? sin : cos);
			float k = 8 * (isHorz ? size.Y : size.X) * (isHorz ? cos : sin);

			float upperY = v == 1 ? m*x2 + k : m*(x2 - h);
			float lowerY = v == 1 ? m*(x1 - h) : m*x1 - k;
		
			return y1 >= lowerY && y2 <= upperY;
		}
	}

	return false;
}

public bool IsOnSameTeam(IPlayer p1, IPlayer p2) {
	return p1 == p2 || (p1.GetTeam() != PlayerTeam.Independent && p1.GetTeam() == p2.GetTeam());
}

public void RemoveTrigger(TriggerArgs args) {
	((IObject)args.Caller).Remove();
}