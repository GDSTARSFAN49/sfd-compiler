}










///// JUGGERNAUT /////

IPlayer juggernaut;
IProfile prfJuggernaut = new IProfile(), prfJuggernautR = new IProfile();
bool moves4 = true;

public void SpawnJuggernaut(IPlayer p) {
	juggernaut = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth += GIANT;
	mods.CurrentHealth = mods.MaxHealth;
	mods.MeleeDamageDealtModifier *= STRENGTH_2;
	mods.MeleeForceModifier *= STRENGTH_1;
	mods.RunSpeedModifier += SLOW;
	mods.SprintSpeedModifier += SLOW;
	mods.SizeModifier = 1.25f;

	juggernaut.SetProfile(prfJuggernaut);
	juggernaut.SetModifiers(mods);
	CreateTimer(50, 0, "JuggernautTick", true);
}

public void JuggernautTick(TriggerArgs args) {
	/// RUMBLE DASH - START ///
	if(juggernaut.IsMeleeAttacking && juggernaut.IsWalking && moves4) {
		PlayerModifiers mods = juggernaut.GetModifiers();
		mods.EnergyConsumptionModifier -= 2/3f;
		mods.RunSpeedModifier += 0.6f;
		mods.SprintSpeedModifier += 0.6f;

		juggernaut.SetProfile(prfJuggernautR);
		juggernaut.SetModifiers(mods);
		CreateTimer(50, 150, "RumbleTick", true);

		moves4 = false;
	}
	/// RUMBLE DASH - END ///
}

public void RumbleTick(TriggerArgs args) {
	IObjectTimerTrigger timer = (IObjectTimerTrigger)args.Caller;

	if(!juggernaut.IsRemoved && juggernaut.IsSprinting && juggernaut.IsOnGround) {
		Area a = juggernaut.GetAABB();
		a.Grow(12, 10);

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => p != juggernaut);
		foreach(IPlayer p in foes) {
			Vector2 velo = p.GetAABB().Center - a.Center;
			p.DealDamage(2*p.GetModifiers().MeleeDamageTakenModifier, juggernaut.UniqueID);
			LaunchPlayer(p, (velo / velo.Length()) * 5);
		}

		Game.PlayEffect("EXP", a.Center);
		Game.PlaySound("Explosion", a.Center, 2/3f);
	}

	if(!timer.IsTimerRunning || juggernaut.IsDead) {
		PlayerModifiers mods = juggernaut.GetModifiers();
		mods.EnergyConsumptionModifier += 2/3f;
		mods.RunSpeedModifier -= 0.6f;
		mods.SprintSpeedModifier -= 0.6f;

		juggernaut.SetProfile(prfJuggernaut);
		juggernaut.SetModifiers(mods);
		Game.PlayEffect("CFTXT", juggernaut.GetAABB().Center, "20 seconds until use.");
		CreateTimer(20000, 1, "JuggernautCD1", true);
		timer.Remove();
	}
}

public void JuggernautCD1(TriggerArgs args) {
	moves4 = true;
	Game.PlayEffect("CFTXT", juggernaut.GetAABB().Center, "Raging Dash is ready!");
	((IObject)args.Caller).Remove();
}










