public void RedHulkTick(TriggerArgs args) {
	/// EXPEL FLAMES - START //
	if((redHulk.IsMeleeAttacking || redHulk.IsJumpAttacking) && redHulk.IsWalking && moves3[0]) {
		Game.SpawnFireNodes(redHulk.GetAABB().Center, 60, new Vector2(8*redHulk.FacingDirection, 0), 0, 4, FireNodeType.Flamethrower);
		Game.TriggerFireplosion(redHulk.GetAABB().Center, 12);

		Game.CreateDialogue("LIKE A VULCAN!!", Color.Red, redHulk, "", 1500, false);
		Game.PlaySound("Flamethrower", redHulk.GetAABB().Center);

		moves3[0] = false;
		Game.PlayEffect("CFTXT", redHulk.GetAABB().Center, "10 seconds until use.");
		CreateTimer(10000, 1, "RedHulkCD1", true);
	}
	/// EXPEL FLAMES - END ///

	/// HULK JUMP - START ///
	if(redHulk.IsCrouching && redHulk.IsWalking && moves3[1]) {
		redHulk.SetWorldPosition(redHulk.GetWorldPosition() + new Vector2(0, 4));
		redHulk.SetLinearVelocity(new Vector2(6*redHulk.FacingDirection, 12));
		Game.PlaySound("PlayerJump", redHulk.GetAABB().Center);
		Game.PlaySound("Impact", redHulk.GetAABB().Center);

		moves3[1] = false;
	} else if(redHulk.IsOnGround && !moves3[1])
		moves3[1] = true;
	/// HULK JUMP - END ///
}

