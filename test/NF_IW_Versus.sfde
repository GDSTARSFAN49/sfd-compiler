///// FLASH /////

IPlayer flash;
List<IPlayer> spdStolen = new List<IPlayer>();
IProfile prfFlash = new IProfile();
int spdIndex = -1;
bool[] moves6 = {true, true};

public void SpawnFlash(IPlayer p) {
	flash = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.RunSpeedModifier += FAST_3;
	mods.SprintSpeedModifier += FAST_3;
	
	flash.SetProfile(prfFlash);
	flash.SetModifiers(mods);
	CreateTimer(50, 0, "FlashTick", true);
}

public void FlashTick(TriggerArgs args) {
	/// SPEED THIEF - START ///
	if(flash.IsMeleeAttacking && flash.IsWalking && moves6[0]) {
		Area a = flash.GetAABB();
		a.Grow(24, 22);

		IPlayer target = null;
		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, flash) && !p.IsDead && !spdStolen.Contains(p));
		if(foes.Length != 0)
			target = Enumerable.OrderByDescending(foes, p => Vector2.Distance(p.GetAABB().Center, flash.GetAABB().Center)).Last();

		if(target != null) {
			PlayerModifiers mods = target.GetModifiers();
			mods.RunSpeedModifier -= 0.1f;
			mods.SprintSpeedModifier -= 0.1f;
			target.SetModifiers(mods);

			spdStolen.Add(target);
			Game.PlayEffect("CFTXT", target.GetAABB().Center, "SPEED DECREASED!!");
			CreateTimer(10000, 1, "ReturnSpeed", true);
			CreateTimer(20000, 1, "RemoveSpdStolen", true);

			flash.SetStrengthBoostTime(5000);
			flash.SetSpeedBoostTime(5000);
			Game.PlayEffect("Electric", flash.GetAABB().Center);

			moves6[0] = false;
			Game.PlayEffect("CFTXT", flash.GetAABB().Center, "10 seconds until use.");
			CreateTimer(10000, 1, "FlashCD1", true);
		}
	}
	/// SPEED THIEF - END ///

	/// SLOW MOTION - START ///
	if(flash.IsBlocking && flash.IsWalking && moves6[1]) {
		flash.GiveWeaponItem(WeaponItem.SLOWMO_5);

		moves6[1] = false;
		Game.PlayEffect("CFTXT", flash.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "FlashCD2", true);
	}
	/// SLOW MOTION - END ///

	/// PASSIVE: REGENERATION I ///
	if(!flash.IsDead && flash.GetHealth() < flash.GetMaxHealth()) {
		PlayerModifiers mods = flash.GetModifiers();
		mods.CurrentHealth += REGEN_1;
		flash.SetModifiers(mods);
	}
}

public void ReturnSpeed(TriggerArgs args) {
	PlayerModifiers mods = spdStolen[++spdIndex].GetModifiers();
	mods.RunSpeedModifier -= 0.1f;
	mods.SprintSpeedModifier -= 0.1f;
	spdStolen[spdIndex].SetModifiers(mods);

	Game.PlayEffect("Electric", spdStolen[spdIndex].GetAABB().Center);
	((IObject)args.Caller).Remove();
}

public void RemoveSpdStolen(TriggerArgs args) {
	Game.PlayEffect("CFTXT", spdStolen[0].GetAABB().Center, "!!!");
	spdStolen.RemoveAt(0);
	spdIndex--;
	((IObject)args.Caller).Remove();
}

public void FlashCD1(TriggerArgs args) {
	moves6[0] = true;
	Game.PlayEffect("CFTXT", flash.GetAABB().Center, "Speed Thief is ready!");
	((IObject)args.Caller).Remove();
}

public void FlashCD2(TriggerArgs args) {
	moves6[1] = true;
	Game.PlayEffect("CFTXT", flash.GetAABB().Center, "Slow Motion is ready!");
	((IObject)args.Caller).Remove();
}










///// QUICKSILVER /////

IPlayer quicksilver, afterimage;
IProfile prfQuicksilver = new IProfile();
IObjectAlterCollisionTile afterimageColl;
bool moves7 = true;

public void SpawnQuicksilver(IPlayer p) {
	quicksilver = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.RunSpeedModifier += FAST_3;
	mods.SprintSpeedModifier += FAST_3;

	afterimageColl = (IObjectAlterCollisionTile)Game.CreateObject("AlterCollisionTile", Vector2.Zero);
	afterimageColl.SetDisableCollisionTargetObjects(true);
	afterimageColl.SetDisablePlayerMelee(true);
	afterimageColl.SetDisableProjectileHit(true);
	afterimageColl.SetDisabledCategoryBits(4);
	afterimageColl.SetDisabledMaskBits(8);

	quicksilver.SetProfile(prfQuicksilver);
	quicksilver.SetModifiers(mods);
	CreateTimer(50, 0, "QuicksilverTick", true);
}

public void QuicksilverTick(TriggerArgs args) {
	/// SLOW MOTION - START ///
	if(quicksilver.IsBlocking && quicksilver.IsWalking && moves7) {
		quicksilver.GiveWeaponItem(WeaponItem.SLOWMO_5);

		moves7 = false;
		Game.PlayEffect("CFTXT", quicksilver.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "QuicksilverCD1", true);
	}
	/// SLOW MOTION - END ///

	/// PASSIVE: TOSS UP ///
	if(quicksilver.IsSprinting) {
		Area a = quicksilver.GetAABB();
		a.Grow(4, 0);
		a.Move(new Vector2(-24*quicksilver.FacingDirection, 0));

		IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, quicksilver));
		foreach(IPlayer p in foes)
			p.SetLinearVelocity(new Vector2(0, 16));
	}

	/// PASSIVE: REGENERATION I ///
	if(!quicksilver.IsDead && quicksilver.GetHealth() < quicksilver.GetMaxHealth()) {
		PlayerModifiers mods = quicksilver.GetModifiers();
		mods.CurrentHealth += REGEN_1;
		quicksilver.SetModifiers(mods);
	}
}

public void RemoveAfterimage(TriggerArgs args) {
	afterimageColl.RemoveTargetObject(afterimage);
	afterimage.Remove();
	afterimage = null;
	((IObject)args.Caller).Remove();
}

public void QuicksilverCD1(TriggerArgs args) {
	moves7 = true;
	Game.PlayEffect("CFTXT", quicksilver.GetAABB().Center, "Slow Motion is ready!");
	((IObject)args.Caller).Remove();
}










///// DEADPOOL /////

IPlayer deadpool;
IProfile prfDeadpool = new IProfile();
bool[] moves8 = {true, true};

public void SpawnDeadpool(IPlayer p) {
	deadpool = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier *= FRAGILE;
	mods.FireDamageTakenModifier *= FRAGILE;
	mods.MeleeDamageTakenModifier *= FRAGILE;
	mods.ImpactDamageTakenModifier *= FRAGILE;
	mods.ProjectileDamageTakenModifier *= FRAGILE;
	mods.ProjectileCritChanceTakenModifier *= FRAGILE;
	mods.MeleeDamageDealtModifier *= STRENGTH_1;
	autoEquipped.Add(deadpool);

	deadpool.SetProfile(prfDeadpool);
	deadpool.SetModifiers(mods);
	deadpool.GiveWeaponItem(WeaponItem.KATANA);
	deadpool.GiveWeaponItem(WeaponItem.PISTOL);
	CreateTimer(50, 0, "DeadpoolTick", true);
}

public void DeadpoolTick(TriggerArgs args) {
	MeleeWeaponItem melee = deadpool.CurrentMeleeWeapon;

	/// TELEPORT - START ///
	if(deadpool.IsBlocking && deadpool.GetEnergy() >= 15 && deadpool.IsWalking && moves8[0]) {
		Area a = deadpool.GetAABB();
		a.Grow(-4, -6);
		a.Move(new Vector2(40*deadpool.FacingDirection, 0));
		
		if(!Array.Exists(Game.GetObjectsByArea(a), o => !(o is IPlayer) && o.GetCollisionFilter().MaskBits == 0xEFED && o.GetSize().Y >= 16)) {
			deadpool.SetWorldPosition(deadpool.GetWorldPosition() + new Vector2(40*deadpool.FacingDirection, 0));
			PlayerModifiers mods = deadpool.GetModifiers();
			mods.CurrentEnergy -= mods.CurrentEnergy > 20 ? 20 : mods.CurrentEnergy;
			deadpool.SetModifiers(mods);
			Game.PlaySound("LogoSlam", deadpool.GetAABB().Center, 1/3f);
		}

		moves8[0] = false;
		CreateTimer(500, 1, "DeadpoolCD1", true);
	}
	/// TELEPORT - END ///

	/// FLIP - START ///
	if(deadpool.IsRolling && deadpool.GetEnergy() >= 10 && deadpool.IsWalking && moves8[1]) {
		deadpool.SetLinearVelocity(new Vector2(4.5f*deadpool.FacingDirection, 9));

		PlayerModifiers mods = deadpool.GetModifiers();
		mods.CurrentEnergy -= mods.CurrentEnergy > 15 ? 15 : mods.CurrentEnergy;
		deadpool.SetModifiers(mods);
	
		moves8[1] = false;
		CreateTimer(500, 1, "DeadpoolCD2", true);
	}
	/// FLIP - END ///

	/// PASSIVE: REGENERATION III ///
	if(!deadpool.IsDead && deadpool.GetHealth() < deadpool.GetMaxHealth()) {
		PlayerModifiers mods = deadpool.GetModifiers();
		mods.CurrentHealth += REGEN_3;
		deadpool.SetModifiers(mods);
	}

	/// PASSIVE: AUTO-EQUIP ///
	if(melee.WeaponItem == WeaponItem.NONE && !deadpool.IsDead)
		deadpool.GiveWeaponItem(WeaponItem.KATANA);
}

public void DeadpoolCD1(TriggerArgs args) {
	moves8[0] = true;
	((IObject)args.Caller).Remove();
}

public void DeadpoolCD2(TriggerArgs args) {
	moves8[1] = true;
	((IObject)args.Caller).Remove();
}










///// MARIO /////

IPlayer mario;
IProfile prfMario = new IProfile(), prfLuigi = new IProfile();
IObjectText handTxt;
int handDelay = 5;
bool isLuigi = false;
bool[] moves9 = {true, true, true};

public void SpawnMario(IPlayer p) {
	mario = p;
	isLuigi = p.IsCrouching || isLuigi; /// EASTER EGG 2 - "L IS REAL" ///

	if(!eggsFound[1] && isLuigi) {
		eggsFound[1] = true;
		Game.ShowChatMessage("Easter Egg 2 Found! - L IS REAL", new Color(255, 226, 97), p.GetUser().UserIdentifier);
		Game.SessionStorage.SetItem("EasterEggs", eggsFound);
	}
	
	PlayerModifiers mods = p.GetModifiers();
	mods.ExplosionDamageTakenModifier = 0;
	mods.FireDamageTakenModifier *= FRAGILE;
	mods.MeleeDamageTakenModifier *= FRAGILE;
	mods.ImpactDamageTakenModifier = 0;
	mods.ProjectileDamageTakenModifier *= FRAGILE;
	mods.ProjectileCritChanceTakenModifier *= FRAGILE;

	mario.SetProfile(!isLuigi? prfMario : prfLuigi);
	mario.SetModifiers(mods);
	if(isLuigi)
		Game.ShowChatMessage("\"Luigi time!\"", new Color(24, 162, 24), p.GetUser().UserIdentifier);
	CreateTimer(50, 0, "MarioTick", true);
}

public void MarioTick(TriggerArgs args) {
	/// HAND - START ///
	if(mario.IsMeleeAttacking && mario.IsWalking && moves9[0]) {
		Vector2 pos = mario.GetWorldPosition() + new Vector2(0, 8);
		handTxt = CreateText(pos, "[ ! ]", Color.Red, 8/3f, (TextAlignment)(1-mario.FacingDirection));
		moves9[0] = false;	
	} else if(!moves9[0] && handDelay > 0) {
		handTxt.SetTextAlignment((TextAlignment)(1-mario.FacingDirection));

		handDelay--;
		if(handDelay == 0 || mario.IsDead) {
			Area a = mario.GetAABB();
			a.Grow(8, 0);
			a.Move(new Vector2(16*mario.FacingDirection, 0));

			if(!mario.IsDead) {
				IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !IsOnSameTeam(p, mario));
				foreach(IPlayer p in foes) {
					if(!isLuigi) {
						p.DealDamage(25*p.GetModifiers().FireDamageTakenModifier, mario.UniqueID);
						p.SetMaxFire();
						Game.PlayEffect("EXP", p.GetAABB().Center);
						Game.PlaySound("FlareGun", p.GetAABB().Center);
					} else {
						p.DealDamage(25*p.GetModifiers().ProjectileDamageTakenModifier, mario.UniqueID);
						StunPlayer(p, 1500);
						Game.PlayEffect("Electric", p.GetAABB().Center);
						Game.PlayEffect("S_P", p.GetAABB().Center);
						Game.PlaySound("ElectricSparks", p.GetAABB().Center);
						Game.PlaySound("Explosion", p.GetAABB().Center, 0.75f);
					}
				}
			}

			handTxt.Remove();
			Game.PlayEffect("CFTXT", mario.GetAABB().Center, "10 seconds until use.");
			CreateTimer(10000, 1, "MarioCD1", true);
		}
	}
	/// HAND - END ///

	/// BROS. JUMP: REFRESH ///
	if(!moves9[1] && mario.IsOnGround)
		moves9[1] = true;

	/// GROUND POUND: REFRESH ///
	if(!moves9[2] && mario.IsOnGround)
		moves9[2] = true;
}

public void MarioCD1(TriggerArgs args) {
	handDelay = 5;
	moves9[0] = true;
	Game.PlayEffect("CFTXT", mario.GetAABB().Center, "Hand is ready!");
	((IObject)args.Caller).Remove();
}










///// ENDERMAN /////

IPlayer enderman;
IProfile prfEnderman = new IProfile();
IObjectText portalTxt;
int portalDelay = 5;
bool[] moves10 = {true, true, true};

public void SpawnEnderman(IPlayer p) {
	enderman = p;
	enderman.SetProfile(prfEnderman);
	CreateTimer(50, 0, "EndermanTick", true);
}

public void EndermanTick(TriggerArgs args) {
	/// GLARE - START ///
	if(enderman.IsMeleeAttacking && enderman.IsWalking && moves10[0]) {
		Area a = enderman.GetAABB();
		a.Grow(20, 6);
		a.Move(new Vector2(20*enderman.FacingDirection, 0));

		if(Array.Exists(Game.GetObjectsByArea<IPlayer>(a), p => p != enderman && !p.IsDead && !IsOnSameTeam(p, enderman) && p.FacingDirection != enderman.FacingDirection)) {
			enderman.SetSpeedBoostTime(5000);

			moves10[0] = false;
			Game.PlayEffect("CFTXT", enderman.GetAABB().Center, "20 seconds until use.");
			CreateTimer(20000, 1, "EndermanCD1", true);
		}
	}
	/// GLARE - END ///

	/// DROP PORTAL - START ///
	if(enderman.IsKicking && enderman.IsWalking && moves10[1]) {
		Vector2 pos = enderman.GetWorldPosition() + new Vector2(0, 8);
		portalTxt = CreateText(pos, "[  !  ]", Color.Red, 8/3f, (TextAlignment)(1-enderman.FacingDirection));
		moves10[1] = false;
	} else if(portalDelay > 0 && !moves10[1]) {
		portalTxt.SetTextAlignment((TextAlignment)(1-enderman.FacingDirection));

		portalDelay--;
		if(portalDelay == 0 || enderman.IsDead) {
			Area a = enderman.GetAABB();
			a.Grow(12, 0);
			a.Move(new Vector2(20*enderman.FacingDirection, 0));

			if(!enderman.IsDead) {
				IPlayer[] foes = Array.FindAll(Game.GetObjectsByArea<IPlayer>(a), p => !p.IsDead && !IsOnSameTeam(p, enderman));
				foreach(IPlayer p in foes) {
					Area _a = p.GetAABB();
					_a.Grow(-4, -6);
					_a.Move(new Vector2(0, 120));
		
					if(!Array.Exists(Game.GetObjectsByArea(_a), o => !(o is IPlayer) && o.GetCollisionFilter().MaskBits == 0xEFED && o.GetAABB().Contains(_a))) {
						Game.PlayEffect("Electric", p.GetAABB().Center);
						p.SetWorldPosition(p.GetWorldPosition() + new Vector2(0, 120));
						LaunchPlayer(p, new Vector2(0, -12));
						Game.PlaySound("LogoSlam", enderman.GetAABB().Center, 1/3f);
					}
				}
			}

			portalTxt.Remove();
			Game.PlayEffect("CFTXT", enderman.GetAABB().Center, "10 seconds until use.");
			CreateTimer(10000, 1, "EndermanCD2", true);
		}
	}
	/// DROP PORTAL - END ///

	/// TELEPORT - START ///
	if(enderman.IsBlocking && enderman.GetEnergy() >= 10 && enderman.IsWalking && moves10[2]) {
		Area a = enderman.GetAABB();
		a.Grow(-4, -6);
		a.Move(new Vector2(40*enderman.FacingDirection, 0));
		
		if(!Array.Exists(Game.GetObjectsByArea(a), o => !(o is IPlayer) && o.GetCollisionFilter().MaskBits == 0xEFED && o.GetAABB().Contains(a))) {
			Game.PlayEffect("Electric", enderman.GetAABB().Center);
			enderman.SetWorldPosition(enderman.GetWorldPosition() + new Vector2(40*enderman.FacingDirection, 0));
			PlayerModifiers mods = enderman.GetModifiers();
			mods.CurrentEnergy -= mods.CurrentEnergy > 15 ? 15 : mods.CurrentEnergy;
			enderman.SetModifiers(mods);
			Game.PlaySound("LogoSlam", enderman.GetAABB().Center, 1/3f);
		}

		moves10[2] = false;
		CreateTimer(500, 1, "EndermanCD3", true);
	}
	/// TELEPORT - END ///
}

public void EndermanCD1(TriggerArgs args) {
	moves10[0] = true;
	Game.PlayEffect("CFTXT", enderman.GetAABB().Center, "Glare is ready!");
	((IObject)args.Caller).Remove();
}

