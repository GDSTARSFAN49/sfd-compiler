/////	 ANT-MAN  /////

IPlayer antman, mini;
List<IPlayer> ants = new List<IPlayer>();
IProfile prfAntman = new IProfile(), prfAnt = new IProfile();
PlayerModifiers antMods = new PlayerModifiers(true);
bool[] moves1 = {true, true, true};

public void SpawnAntMan(IPlayer p) {
	antman = p;

	antMods = p.GetModifiers();
	antMods.MaxHealth -= GIANT;
	antMods.CurrentHealth = antMods.MaxHealth;
	antMods.MeleeDamageDealtModifier /= STRENGTH_1;
	antMods.SizeModifier = 0.75f;

	antman.SetProfile(prfAntman);
	antman.SetTeam(antman.GetTeam() == PlayerTeam.Independent ? PlayerTeam.Team4 : antman.GetTeam());
	CreateTimer(50, 0, "AntManTick", true);
}

public void AntManTick(TriggerArgs args) {
	/// SUMMON: ANTS - START ///
	if(antman.IsJumpAttacking && antman.IsWalking && moves1[0]) {
		for(int i=0;i<ants.Count;i++)
			ants[i].SetWorldPosition(antman.GetWorldPosition() + new Vector2(-12+(12*(i%3)), 0));

		for(int x=0;x<3;x++) {
			IPlayer p = Game.CreatePlayer(antman.GetWorldPosition() + new Vector2(-12+(12*x), 0));
			p.SetTeam(antman.GetTeam());
			p.SetBotBehavior(new BotBehavior(true, PredefinedAIType.TutorialMeleeA));
			p.SetGuardTarget(antman);
			p.SetBotBehaviorActive(true);
			p.SetProfile(prfAnt);
			p.SetModifiers(antMods);
			ants.Add(p);
			Game.PlaySound("Dig", p.GetAABB().Center);
		}

		moves1[0] = false;
		Game.PlayEffect("CFTXT", antman.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "AntManCD1", true);
	} else if(antman.IsJumpAttacking && antman.IsWalking && !moves1[0]) {
		for(int i=0;i<ants.Count;i++)
			ants[i].SetWorldPosition(antman.GetWorldPosition() + new Vector2(-12+(12*(i%3)), 0));
	}
	/// SUMMON: ANTS - END ///

	/// GIGANTIFY - START ///
	if(antman.IsMeleeAttacking && antman.IsWalking && antman.GetModifiers().SizeModifier != 1.25f && moves1[1]) {
		Normalize(antman);
		Gigantify(antman);
		Game.PlaySound("StrengthBoostStart", antman.GetAABB().Center);

		moves1[1] = false;
		CreateTimer(500, 1, "AntManCD2", true);
	}
	/// GIGANTIFY - END ///

	/// SHRINK - START ///
	if(antman.IsBlocking && antman.IsWalking && antman.GetModifiers().SizeModifier != 0.75f && moves1[1]) {
		Normalize(antman);
		Shrink(antman);
		Game.PlaySound("StrengthBoostStop", antman.GetAABB().Center);

		moves1[1] = false;
		CreateTimer(500, 1, "AntManCD2", true);
	}
	/// SHRINK - END ///

	/// NORMALIZE - START ///
	if(antman.IsCrouching && antman.IsWalking && antman.GetModifiers().SizeModifier != 1 && moves1[1]) {
		Normalize(antman);
		moves1[1] = false;
		CreateTimer(500, 1, "AntManCD2", true);
	}
	/// NORMALIZE - END ///

	/// MINIMIZE - START ///
	if((antman.IsHoldingPlayerInGrab || antman.IsHoldingPlayerInDive) && antman.IsWalking && moves1[2]) {
		mini = Game.GetPlayer(antman.IsHoldingPlayerInGrab ? antman.HoldingPlayerInGrabID : antman.HoldingPlayerInDiveID);
		if(!mini.IsDead && !IsOnSameTeam(mini, sans)) {
			Shrink(mini);
			CreateTimer(10000, 1, "EndMinimize", true);
			Game.PlayEffect("CFTXT", mini.GetAABB().Center, "MINIMIZED!!");
			Game.PlaySound("StrengthBoostStop", mini.GetAABB().Center);

			moves1[2] = false;
			Game.PlayEffect("CFTXT", antman.GetAABB().Center, "30 seconds until use.");
			CreateTimer(30000, 1, "AntManCD3", true);
		} else
			mini = null;
	}
	/// MINIMIZE - END ///

	if(ants.Count > 0 && ants[0].GetTeam() != antman.GetTeam())
		ants.ForEach(p => p.SetTeam(antman.GetTeam()));
}

public void Gigantify(IPlayer p) {
	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth += GIANT;
	mods.CurrentHealth /= 0.6f;
	mods.MeleeDamageDealtModifier *= STRENGTH_2;
	mods.MeleeForceModifier *= STRENGTH_1;
	mods.RunSpeedModifier -= 0.1f;
	mods.SprintSpeedModifier -= 0.1f;
	mods.MeleeForceModifier = 1.5f;
	mods.SizeModifier += 0.25f;
	p.SetModifiers(mods);
}

public void Shrink(IPlayer p) {
	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth -= GIANT/2;
	mods.CurrentHealth *= 2/3f;
	mods.MeleeDamageDealtModifier /= 2;
	mods.MeleeForceModifier /= 2;
	mods.RunSpeedModifier += 0.5f;
	mods.SprintSpeedModifier += 0.5f;
	mods.SizeModifier -= 0.25f;
	p.SetModifiers(mods);
}

public void Normalize(IPlayer p) {
	PlayerModifiers mods = p.GetModifiers();
	if(mods.SizeModifier != 1) {
		mods.MaxHealth -= mods.MaxHealth - starterMods.MaxHealth;
		mods.CurrentHealth *= mods.SizeModifier == 1.25f ? 0.6f : 3/2f;
		mods.MeleeDamageDealtModifier *= mods.SizeModifier == 1.25f ? 1/STRENGTH_2 : 2;
		mods.MeleeForceModifier *= mods.SizeModifier == 1.25f ? 1/STRENGTH_1 : 2;
		mods.RunSpeedModifier += mods.SizeModifier == 1.25f ? 0.1f : -0.5f;
		mods.SprintSpeedModifier += mods.SizeModifier == 1.25f ? 0.1f : -0.5f;
		mods.SizeModifier -= mods.SizeModifier - 1;
		p.SetModifiers(mods);
	}
}

public void EndMinimize(TriggerArgs args) {
	if(!mini.IsRemoved) {
		PlayerModifiers mods = mini.GetModifiers();
		mods.MaxHealth += GIANT/2;
		mods.CurrentHealth *= 3/2f;
		mods.MeleeDamageDealtModifier *= 2;
		mods.MeleeForceModifier *= 2;
		mods.RunSpeedModifier -= 0.5f;
		mods.SprintSpeedModifier -= 0.5f;
		mods.SizeModifier += 0.25f;
		mini.SetModifiers(mods);
	}
	mini = null;
}

public void AntManCD1(TriggerArgs args) {
	moves1[0] = true;
	Game.PlayEffect("CFTXT", antman.GetAABB().Center, "Summon: Ants is ready!");
	((IObject)args.Caller).Remove();
}

public void AntManCD2(TriggerArgs args) {
	moves1[1] = true;
	((IObject)args.Caller).Remove();
}

public void AntManCD3(TriggerArgs args) {
	moves1[2] = true;
	Game.PlayEffect("CFTXT", antman.GetAABB().Center, "Minimize is ready!");
	((IObject)args.Caller).Remove();
}










/////  HULK  /////

IPlayer hulk;
IProfile prfHulk = new IProfile(), prfBruce = new IProfile();
bool[] moves2 = {true, true};

public void SpawnHulk(IPlayer p) {
	hulk = p;

	PlayerModifiers mods = p.GetModifiers();
	mods.MaxHealth += GIANT;
	mods.CurrentHealth = mods.MaxHealth;
	mods.ImpactDamageTakenModifier = 0;
	mods.MeleeDamageDealtModifier *= STRENGTH_2;
	mods.MeleeForceModifier *= STRENGTH_1;
	mods.RunSpeedModifier += SLOW;
	mods.SprintSpeedModifier += SLOW;
	mods.SizeModifier = 1.25f;

	hulk.SetProfile(prfHulk);
	hulk.SetModifiers(mods);
	CreateTimer(50, 0, "HulkTick", true);
}

public void HulkTick(TriggerArgs args) {
	/// HULK SMASH!!! - START ///
	if(hulk.IsJumpAttacking && hulk.IsWalking && moves2[0]) {
		for(int x=0;x<4;x++)
			Game.TriggerExplosion(hulk.GetAABB().Center + new Vector2((48+(16*x))*hulk.FacingDirection, 0));
			Game.CreateDialogue("HULK SMASH!!", new Color(0, 192, 0), hulk, "", 1500, false);

		moves2[0] = false;
		Game.PlayEffect("CFTXT", hulk.GetAABB().Center, "15 seconds until use.");
		CreateTimer(15000, 1, "HulkCD1", true);
	}
	/// HULK SMASH!!! - END ///

	/// HULK JUMP - START ///
	if(hulk.IsCrouching && hulk.IsWalking && moves2[1]) {
		hulk.SetWorldPosition(hulk.GetWorldPosition() + new Vector2(0, 4));
		hulk.SetLinearVelocity(new Vector2(6*hulk.FacingDirection, 12));
		Game.PlaySound("PlayerJump", hulk.GetAABB().Center);
		Game.PlaySound("Impact", hulk.GetAABB().Center);

		moves2[1] = false;
	} else if(hulk.IsOnGround && !moves2[1])
		moves2[1] = true;
	/// HULK JUMP - END ///

	/// PASSIVE: WEAKENED STATE ///
	if(hulk.GetHealth() < hulk.GetMaxHealth()/8 && !hulk.IsDead) {
		PlayerModifiers mods = hulk.GetModifiers();
		mods.MaxHealth = starterMods.MaxHealth;
		mods.MeleeDamageDealtModifier = starterMods.MeleeDamageDealtModifier;
		mods.SizeModifier = 1;

		hulk.SetProfile(prfBruce);
		hulk.SetModifiers(mods);
		((IObject)args.Caller).Remove();
	} else if(hulk.IsDead)
		((IObject)args.Caller).Remove();
}

public void HulkCD1(TriggerArgs args) {
	moves2[0] = true;
	Game.PlayEffect("CFTXT", hulk.GetAABB().Center, "Hulk Smash!!! is ready!");
	((IObject)args.Caller).Remove();
}










