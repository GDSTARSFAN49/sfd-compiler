				///// PRIMARY VARIABLES /////

Events.PlayerDamageCallback onDamage;
Events.PlayerKeyInputCallback onKey;
Events.PlayerWeaponRemovedActionCallback onWpnRemove;
Events.UserMessageCallback cmdPrompt;

Dictionary<string, string> helpInfo = new Dictionary<string, string>();
Dictionary<string, string> traitInfo = new Dictionary<string, string>();

Dictionary<int, int> activeCharacters = new Dictionary<int, int>();
List<IPlayer> autoEquipped = new List<IPlayer>();

IProfile[] profiles = new IProfile[37];
string[][] controls = new string[37][];
string[][] moveInfo = new string[37][];
bool[] eggsFound = {false, false};

PlayerModifiers starterMods = new PlayerModifiers(true);
Random rand = new Random();


				///// ATTRIBUTE MODIFIERS /////

const float STRENGTH_1 = 1.75f, STRENGTH_2 = 2.5f, STRONG_GUN_1 = 1.5f, TANK = 2/3f, FRAGILE = 2; // Multipliers
const int GIANT = 100; // Additive (Integers)
const float FAST_1 = 1/3f, FAST_2 = 1/2f, FAST_3 = 3/4f, SLOW = -0.1f, REGEN_1 = 0.15f, REGEN_2 = 0.3f, REGEN_3 = 0.6f; // Additive (Floats)



















				///////             ///////
				///////   STARTUP   ///////
				///////             ///////

List<IObject> spawnpoints = new List<IObject>();
List<IPlayer> selectingPlayers = new List<IPlayer>();

IObjectActivateTrigger[] buttons = new IObjectActivateTrigger[37];
IPlayer[] displayPlayers = new IPlayer[37];

IObjectCameraAreaTrigger mapCam, stageCam, titleCam;
IObjectText countdownTxt;
int countdown = 30; 
float transform;
bool titleCard = true, randAssign = false;

public void OnStartup() {
	CreateProfiles();
	SetupCommands();

	starterMods.MaxHealth = 150;
	starterMods.CurrentHealth = starterMods.MaxHealth;
	starterMods.ExplosionDamageTakenModifier = 1/2f;
	starterMods.ProjectileDamageTakenModifier = 7/8f;
	starterMods.FireDamageTakenModifier = 1/3f;
	starterMods.MeleeDamageDealtModifier = 10/8.5f;

	onDamage = Events.PlayerDamageCallback.Start(OnDamage);
	onKey = Events.PlayerKeyInputCallback.Start(OnKeyMoves);
	onWpnRemove = Events.PlayerWeaponRemovedActionCallback.Start(OnWeaponRemoval);
	cmdPrompt = Events.UserMessageCallback.Start(CommandPrompt);
	
	if(Game.SessionStorage.ContainsKey("ToggleIntro"))
		Game.SessionStorage.TryGetItemBool("ToggleIntro", out titleCard);
	
	if(Game.SessionStorage.ContainsKey("ToggleRandAssignment"))
		Game.SessionStorage.TryGetItemBool("ToggleRandAssignment", out randAssign);

	if(Game.SessionStorage.ContainsKey("EasterEggs"))
		Game.SessionStorage.TryGetItemBoolArr("EasterEggs", out eggsFound);

	if(Array.Exists(Game.GetObjects<IObjectCameraAreaTrigger>(), cam => cam.ActivateOnStartup)) {
		mapCam = Array.Find(Game.GetObjects<IObjectCameraAreaTrigger>(), cam => cam.ActivateOnStartup);
		mapCam.SetActivateOnStartup(false);
	}
	spawnpoints.AddRange(Game.GetObjectsByName("SpawnPlayer"));

	/// DEBUG STARTUP ///
	if(Game.IsEditorTest)
		;
	Game.StartupSequenceEnabled = false;

	if(titleCard) { 
		transform = Game.GetCameraMaxArea().Top + 1000;
		
		titleCam = (IObjectCameraAreaTrigger)Game.CreateObject("CameraAreaTrigger", new Vector2(-164, transform-4));
		titleCam.SetSizeFactor(new Point(42, 18));
		titleCam.SetCameraSnapping(true);
		titleCam.SetCameraAreaMode(CameraAreaMode.ForceStatic);

		CreateText(new Vector2(0, transform-44), " NF-IW:", Color.White, 3);
		CreateText(new Vector2(0, transform-68), "== VERSUS ==", new Color(0, 0, 155), 5);
		CreateText(new Vector2(-20, transform-92), "By: DaFierceRaider", new Color(228, 159, 252), 1.5f, TextAlignment.Right);

		foreach(IPlayer p in Game.GetPlayers()) {
			p.SetNametagVisible(false);
			p.SetInputEnabled(false);
		}

		titleCam.Trigger();
		CreateTimer(3500, 1, "RemoveTitleCard", true);
	} else {	
		if(!randAssign)
			SelectAssignment();
		else
			RandomAssignment();
	}
}

public void RemoveTitleCard(TriggerArgs args) {
	IObjectRemoveAreaTrigger removeArea = (IObjectRemoveAreaTrigger)Game.CreateObject("RemoveAreaTrigger", titleCam.GetWorldPosition());
	removeArea.SetSizeFactor(titleCam.GetSizeFactor());
	removeArea.Trigger();

	titleCam.Remove();
	foreach(IPlayer p in Game.GetPlayers()) {
		p.SetNametagVisible(true);
		p.SetInputEnabled(true);
	}

	if(!randAssign)
		SelectAssignment();
	else
		RandomAssignment();

	((IObject)args.Caller).Remove();
}





				///// RANDOM ASSIGNMENT /////

public void RandomAssignment(TriggerArgs args=null) {
	List<int> ids = new List<int>(Enumerable.Range(0, 36));
	IPlayer[] players = Game.GetActiveUsers().Select(u => u.GetPlayer()).Reverse().ToArray();

	Array.ForEach(players, p => {
		int i = rand.Next(ids.Count);

		p.SetModifiers(starterMods);
		activeCharacters.Add(p.UniqueID, ids[i]);
		SpawnCharacter(ids[i], p);

		ids.RemoveAt(i);
	});

	if(mapCam != null)
		mapCam.Trigger();
}





				///// SELECT ASSIGNMENT /////
 
public void SelectAssignment(TriggerArgs args=null) {
	transform = Game.GetCameraMaxArea().Top + 800;

	stageCam = (IObjectCameraAreaTrigger)Game.CreateObject("CameraAreaTrigger", new Vector2(-284, transform-4));
	stageCam.SetSizeFactor(new Point(72, 35));
	stageCam.SetCameraSnapping(true);
	stageCam.SetCameraAreaMode(CameraAreaMode.ForceStatic);
	ConstructStage();

	// Constructing Character Displays
	for(int i=0;i<profiles.Length-1;i++) {
		Vector2 pos = new Vector2(-216 + (32*(i%6)) + (272*(i/18)), transform-52 + (float)(-72*((i%18)/6)));

		IObject[] displayObj = new IObject[3];
		for(int j=0;j<2;j++) {
			displayObj[j] = Game.CreateObject("InvisibleBlock", pos + new Vector2(-12 + (24*j), 8));
			displayObj[j].SetSizeFactor(new Point(1, 3));
		}
		displayObj[2] = Game.CreateObject("InvisibleBlock", pos + new Vector2(-12, -16));
		displayObj[2].SetSizeFactor(new Point(4, 1));

		IObject buttonObj = Game.CreateObject("BgMachine01C", pos + new Vector2(0, -32));
		buttonObj.SetColor1("BgLightGreen");

		IObjectActivateTrigger button = (IObjectActivateTrigger)Game.CreateObject("ActivateTrigger", pos + new Vector2(0, -32));
		button.CustomID = i.ToString();
		button.SetScriptMethod("PressButton");
		button.SetHighlightObject(buttonObj);
		button.SetUseCount(1);
		button.SetUseType(ActivateTriggerUseType.Global);
		buttons[i] = button;

		IPlayer displayPly = Game.CreatePlayer(pos + new Vector2(0, -8));
		displayPly.SetNametagVisible(false);
		displayPly.SetProfile(profiles[i]);
		displayPlayers[i] = displayPly;

		CreateText(pos + new Vector2(0, -16), profiles[i].Name, Color.White, 0.6f, TextAlignment.Middle); // Display text
	}

	countdownTxt = CreateText(new Vector2(0, transform-24), "Time Left: " + countdown, Color.White, 3, TextAlignment.Middle);
	CreateText(new Vector2(0, transform-256), "Press a button to select!", Color.White, 3, TextAlignment.Middle);

	List<Vector2> stagePos = new List<Vector2>(8);
	stagePos.AddRange(new Vector2[]{new Vector2(-72, transform-164),  new Vector2(72, transform-164), 
                                   new Vector2(-104, transform-164), new Vector2(104, transform-164), 
                                   new Vector2(-168, transform-164), new Vector2(168, transform-164), 
                                   new Vector2(-200, transform-164), new Vector2(200, transform-164)});

	IPlayer[] players = Game.GetActiveUsers().Select(u => u.GetPlayer()).Reverse().ToArray();
	for(int i=0;i<players.Length;i++) {
		int x = rand.Next(stagePos.Count);
		players[i].SetWorldPosition(stagePos[x]);
		selectingPlayers.Add(players[i]);
		stagePos.RemoveAt(x);
	}

	Game.RunCommand("/ih 1");
	Game.RunCommand("/ie 1");
	Game.HidePopupMessage();
	stageCam.Trigger();

	CreateTimer(1000, countdown, "Countdown", true);
}

public void Countdown(TriggerArgs args) {
	countdownTxt.SetText("Time Left: " + --countdown);
	if(countdown <= 3)
		Game.PlaySound("TimerTick", countdownTxt.GetWorldPosition());

	if(selectingPlayers.Count == 0 || countdown == 0) {
		countdownTxt.SetText("Starting Game...");
		Game.RunCommand("/ih 0");
		Game.RunCommand("/ie 0");

		foreach(IPlayer p in Game.GetPlayers())
			p.SetInputEnabled(false);

		CreateTimer(3000, 1, "StartGame", true);
		((IObject)args.Caller).Remove();
	}
}

public void StartGame(TriggerArgs args) {
	IObjectRemoveAreaTrigger removeArea = (IObjectRemoveAreaTrigger)Game.CreateObject("RemoveAreaTrigger", stageCam.GetWorldPosition());
	removeArea.SetSizeFactor(stageCam.GetSizeFactor());
	removeArea.Trigger();

	stageCam.Remove();
	if(mapCam != null)
		mapCam.Trigger();

	foreach(IPlayer p in Game.GetPlayers()) {
		p.SetNametagVisible(true);
		p.SetInputEnabled(true);
	}
}

public void PressButton(TriggerArgs args) {
	IPlayer p = (IPlayer)args.Sender;

	// For Assholes :P
	if(p.IsHoldingPlayerInGrab || p.IsHoldingPlayerInDive) {
		IPlayer victim = Game.GetPlayer(p.IsHoldingPlayerInGrab ? p.HoldingPlayerInGrabID : p.HoldingPlayerInDiveID);
		p.Remove();
		selectingPlayers.Remove(p);
		p = victim;
	}

	int index = 0;
	if(((IObject)args.Caller).CustomID.Equals("Random")) {
		IObjectActivateTrigger[] unused = Array.FindAll(buttons, b => b != null && b.CustomID != "36");
		index = Int32.Parse(unused[rand.Next(unused.Length)].CustomID);
	} else
		index = Int32.Parse(((IObject)args.Caller).CustomID);

	OnSelect(p, index);
}

public void OnSelect(IPlayer p, int i) {
	StringBuilder sb = new StringBuilder("");
	for(int j=0;j<controls[i].Length;j++)
		sb.Append(controls[i][j] + "\n");

	if(displayPlayers[i] != null) {
		Vector2 pos = displayPlayers[i].GetWorldPosition() + new Vector2(0, 8);
		displayPlayers[i].Remove();
		CreateText(pos, Game.ReplaceTextTags(sb.ToString()), Color.White, 0.5f, TextAlignment.Middle);
	}

	if(buttons[i].GetHighlightObject() != null)
		buttons[i].GetHighlightObject().SetColor1("BgRed");
	buttons[i] = null;

	if(spawnpoints.Count > 0) {
		IObject o = spawnpoints[rand.Next(spawnpoints.Count)];
		p.SetWorldPosition(o.GetWorldPosition());
		spawnpoints.Remove(o);
		o.Remove();
	} else
		p.SetWorldPosition(Vector2.Zero);

	p.SetModifiers(starterMods);
	activeCharacters.Add(p.UniqueID, i);
	SpawnCharacter(i, p);

	p.SetNametagVisible(false);
	p.SetInputEnabled(false);
	selectingPlayers.Remove(p);
}

