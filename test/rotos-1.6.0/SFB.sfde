,1,255,255,255|");
static Image img_SmashBall;

public class Fighter{
	IPlayer Player;
	IUser User;	
	double Damage = 0;
	IObjectText Hud;
	bool IsHit = false;
	bool WasRocketRiding = false;
	int ResFrames = D_RESPAWN_FRAMES;
	int InvFrames = 0;
	int Lives = D_LIVES;
	bool IsSmashed = false;
	int effectTimer = 0;

	public Fighter(IPlayer input_player){
		Player = input_player;	
		User = input_player.GetUser();	

		Player.SetStatusBarsVisible(false);

		PlayerModifiers stats = Player.GetModifiers();
		stats.MaxHealth = 9999;
		stats.CurrentHealth = (stats.MaxHealth - 100);
		Player.SetModifiers(stats);

		Hud = (IObjectText)Game.CreateObject("Text");
		Hud.SetTextAlignment(TextAlignment.Middle);
		Hud.SetTextScale(0.5f);
	}
	public void Step(){
		if(User != null){
			chkNULL();
		}
		if(Player != null && !Player.IsDead && !Player.IsRemoved){
			PlayerModifiers stats = Player.GetModifiers();
			if(stats.CurrentHealth < stats.MaxHealth - 100 && InvFrames <= 0){
				Damage += ((stats.MaxHealth - 100) - stats.CurrentHealth) * D_MULTIPLIER;
			}else if(stats.CurrentHealth > stats.MaxHealth - 100){
				Damage -= (stats.CurrentHealth - (stats.MaxHealth - 100));
				if(Damage < 0){
					Damage = 0;
				}
			}else if(InvFrames > 0){
				InvFrames --;
			}
			if(Damage > D_MAX_DAMAGE){
				Damage = D_MAX_DAMAGE;
			}
			stats.CurrentHealth = stats.MaxHealth - 100;
			
			//Smash Ballance
			stats.ProjectileDamageTakenModifier = 0.5f;
			
			WeaponItem Item = WeaponItem.NONE;
			if(Player.CurrentWeaponDrawn == WeaponItemType.Handgun){
				Item = Player.CurrentSecondaryWeapon.WeaponItem;
			}else{
				Item = Player.CurrentPrimaryWeapon.WeaponItem;
			}
			int MyItem = (int)Item;
			if(MyItem == 5 || MyItem == 6 || MyItem == 12 || MyItem == 30 || MyItem == 53 || MyItem == 40 || MyItem == 19 || MyItem == 13 || MyItem == 53 || MyItem == 55){
				stats.ProjectileCritChanceDealtModifier = 0.5f;
			}else{
				stats.ProjectileCritChanceDealtModifier = 100f;
			}
			
			Player.SetModifiers(stats);

			if(IsSmashed){
				effectTimer --;
				if(effectTimer <= 0){
					Game.PlayEffect("Electric",Player.GetWorldPosition());
					effectTimer = (int)rnd.Next(30,90);
				}

				if(Player.IsWalking && (Player.IsMeleeAttacking || Player.IsJumpAttacking)){
					/*
					*  Not Very Original Final Smash Here
					*/		
			
					Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER,Player.GetWorldPosition() + new Vector2(Player.GetFaceDirection() * 8,0),new Vector2(Player.GetFaceDirection(),Player.GetLinearVelocity().Y/4 + 0.125f));
					Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER,Player.GetWorldPosition() + new Vector2(Player.GetFaceDirection() * 8,0),new Vector2(Player.GetFaceDirection(),Player.GetLinearVelocity().Y/4 + 0.25f));
					Game.SpawnProjectile(ProjectileItem.GRENADE_LAUNCHER,Player.GetWorldPosition() + new Vector2(Player.GetFaceDirection() * 8,0),new Vector2(Player.GetFaceDirection(),Player.GetLinearVelocity().Y/4 + 0.375f));

					_Smash_ = false;
					IsSmashed = false;
					SetupSmashBall();
				}
			}

			if(Player.IsDisabled && Player.IsFalling && !IsHit){
				IsHit = true;
				Vector2 v = Player.GetLinearVelocity();
				v *= 1 + (float)(Damage/100);
				Player.SetLinearVelocity(v);
			}else if(!Player.IsDisabled && !Player.IsFalling && Player.IsOnGround && IsHit){
				IsHit = false;
			}

			int alt_col = (int)Math.Round(Damage);
			if(Damage > 255){
				alt_col = 255;
			}
			if(InvFrames <= 0){
				Hud.SetTextColor(new Color(255,(byte)(255 - alt_col),(byte)(255 - alt_col)));
				Hud.SetText(Math.Round(Damage) + "%");
				Hud.SetWorldPosition(Player.GetWorldPosition() + new Vector2(0,24));
			}else{
				Hud.SetTextColor(new Color(255,255,255));
				Hud.SetText("Lives: " + Lives);
				Hud.SetWorldPosition(Player.GetWorldPosition() + new Vector2(0,24));
			}
	
			if(Player.GetWorldPosition().Y > Top + 48){
				Player.Remove();
			}else{
				if(Player.IsRocketRiding){
					WasRocketRiding = true;
				}else if(WasRocketRiding){
					ResetPlayer();
				}
			}
		}else{
			Hud.SetText("");
			if(IsSmashed){
				_Smash_ = false;
				IsSmashed = false;
				SetupSmashBall();
			}
		}
		if(Player != null && User != null && !Player.IsRemoved && Player.IsDead){
			ResetPlayer();
		}
		if(User != null && Player.IsRemoved && Lives > 0){
			if(Lives > 1){
				if(ResFrames <= 0){
					SpawnPlayer();
				}else{
					ResFrames --;
				}
			}else{
				Lives = 0;
			}	
		}
		if(User == null){
			Lives = 0;	
			Player.Remove();
			if(IsSmashed){
				_Smash_ = false;
				IsSmashed = false;
				SetupSmashBall();
			}
		}
	}
	public void giveSmash(){
		_Smash_ = true;
		IsSmashed = true;
	}
	public void chkNULL(){
		bool success = false;
		foreach(IUser usr in Game.GetActiveUsers()){
			if(User == usr){
				success = true;
			}
		}
		if(!success){
			User = null;
			if(IsSmashed){
				_Smash_ = false;
				IsSmashed = false;
				SetupSmashBall();
			}
		}
	}
	public void ResetPlayer(){
		Game.WriteToConsole("Reset " + User.Name);
		IPlayer temp = Game.CreatePlayer(Player.GetWorldPosition());
		temp.SetAngularVelocity(Player.GetAngularVelocity());
		temp.SetLinearVelocity(Player.GetLinearVelocity());
		temp.SetProfile(Player.GetProfile());
		temp.SetModifiers(Player.GetModifiers());
		temp.SetTeam(Player.GetTeam());
		Player.Remove();
		User.SetPlayer(temp);
		Player = temp;
		WasRocketRiding = false;
		Player.SetStatusBarsVisible(false);
		PlayerModifiers stats = Player.GetModifiers();
		stats.MaxHealth = 9999;
		stats.CurrentHealth = (stats.MaxHealth - 100);
		Player.SetModifiers(stats);
	}
	public void SpawnPlayer(){
		Game.WriteToConsole("Respawned " + User.Name);
		IObject[] Spawns = Game.GetObjectsByName("SpawnPlayer");
		int index = rnd.Next(0,Spawns.Length);
		IPlayer temp = Game.CreatePlayer(Spawns[index].GetWorldPosition());
		temp.SetFaceDirection(Spawns[index].GetFaceDirection());
		temp.SetProfile(User.GetProfile());
		temp.SetTeam(User.GetTeam());
		User.SetPlayer(temp);
		Player = temp;
		Damage = 0;
		IsHit = false;
		Lives --;
		ResFrames = D_RESPAWN_FRAMES;
		InvFrames = D_INVINCIBLE_FRAMES;
		Player.SetStatusBarsVisible(false);
		PlayerModifiers stats = Player.GetModifiers();
		stats.MaxHealth = 9999;
		stats.CurrentHealth = (stats.MaxHealth - 100);
		Player.SetModifiers(stats);
		if(IsSmashed){
			_Smash_ = false;
			IsSmashed = false;
			SetupSmashBall();
		}
	}
	public int GetLives(){
		return Lives;
	}
	public IPlayer GetPlayer(){
		return Player;
	}
	public IUser GetUser(){
		return User;
	}
}


bool updatemsg = true;
public void OnUserMessage(UserMessageCallbackArgs args) {
	if(args.User.IsHost || args.User.IsModerator){
		if(args.IsCommand){
			int val = 0;
			switch(args.Command){
				case "D_LIVES":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val > 0){
							UpdateSetting(0,val,args.Command);
						}
					}
				break;
				case "D_MULTIPLIER":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val > 0){
							UpdateSetting(1,val,args.Command);
						}
					}
				break;
				case "D_MAX_DAMAGE":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val >= 0){
							UpdateSetting(2,val,args.Command);
						}
					}
				break;
				case "D_RESPAWN_FRAMES":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val > 0){
							UpdateSetting(3,val,args.Command);
						}
					}
				break;
				case "D_INVINCIBLE_FRAMES":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val > 0){
							UpdateSetting(4,val,args.Command);
						}
					}
				break;
				case "D_FINAL_SMASHES":
					if(Int32.TryParse(args.CommandArguments,out val)){
						if(val == 0 || val == 1){
							UpdateSetting(5,val,args.Command);
						}
					}
				break;
			}
		}
	}
}

public void UpdateSetting(int index,int val,string Command_Name){
	options[index] = val;
	Game.RunCommand("/msg " + Command_Name + " was updated to " + val);

	Game.Data = "";
	int z = 0;
	foreach(int x in options){
		if(z != 0){
			Game.Data += "|" + x.ToString();
		}else{
			Game.Data += x.ToString();
		}
		z ++;
	}
}

public void LoadSetting(){
	if(Game.Data == ""){
		Game.Data = D_LIVES + "|" + D_MULTIPLIER + "|" + D_MAX_DAMAGE + "|" + D_RESPAWN_FRAMES + "|" + D_INVINCIBLE_FRAMES + "|" + D_FINAL_SMASHES;
	}
	string[] data = Game.Data.Split('|');
	for(int x = 0;x < data.Length;x ++){
		Int32.TryParse(data[x],out options[x]);
	}
	D_LIVES = options[0];
	D_MULTIPLIER = options[1];
	D_MAX_DAMAGE = options[2];
	D_RESPAWN_FRAMES = options[3];
	D_INVINCIBLE_FRAMES = options[4];
	D_FINAL_SMASHES = options[5];
}

int[] options = new int[6];
public void OnStartup(){
	LoadSetting();

	m_userMessageCallback = Events.UserMessageCallback.Start(OnUserMessage);
	img_SmashBall = getImage(spr_SmashBall);
	img_SmashBall.RemoveColor(new Color(255,255,255));
	smashObj = (IObjectActivateTrigger)Game.CreateObject("ActivateTrigger");
	smashObj.SetScriptMethod("CollectSmash");

	Game.RunCommand("/msg -----------------|");
	Game.RunCommand("/msg Super Fighter Bros.");
	Game.RunCommand("/msg -----------------|");
	Game.RunCommand("/msg Game Options:");
	Game.RunCommand("/msg Lives: " + D_LIVES);
	if (D_FINAL_SMASHES == 1){ Game.RunCommand("/msg Final Smashes: Enabled"); }else{ Game.RunCommand("/msg Final Smashes: Disabled"); }
	if (D_MULTIPLIER != 1){ Game.RunCommand("/msg Multiplier: " + D_MULTIPLIER + "x"); }
	if (D_MAX_DAMAGE != 999){ Game.RunCommand("/msg Max Damage: " + D_MAX_DAMAGE + "%"); }
	if (D_RESPAWN_FRAMES != 300){ Game.RunCommand("/msg Respawn Time: " + D_RESPAWN_FRAMES); }
	if (D_INVINCIBLE_FRAMES != 120){ Game.RunCommand("/msg Invincible Time: " + D_INVINCIBLE_FRAMES); }
	Game.RunCommand("/msg -----------------|");

	Top = Game.GetCameraArea().Top;
	Bottom = Game.GetCameraArea().Bottom;
	Right = Game.GetCameraArea().Right;
	Left = Game.GetCameraArea().Left;
	if(Game.GetObjectsByName("CameraAreaTrigger").Length > 0){
		Top = Game.GetObjectsByName("CameraAreaTrigger")[0].GetAABB().Top;
		Bottom = Game.GetObjectsByName("CameraAreaTrigger")[0].GetAABB().Bottom;
		Right = Game.GetObjectsByName("CameraAreaTrigger")[0].GetAABB().Right;
		Left = Game.GetObjectsByName("CameraAreaTrigger")[0].GetAABB().Left;
	}
	
	Game.SetAllowedCameraModes(CameraMode.Static);
	Game.AutoVictoryConditionEnabled = false;
	foreach(IPlayer ply in Game.GetPlayers()){
		Fighters.Add(new Fighter(ply));
	}

	//IDLE Blocks
	Game.CreateObject("Concrete00A",new Vector2(0,2000));
	IObject block = Game.CreateObject("Concrete00A",new Vector2(-8,Top + 64));
	block.SetSizeFactor(new Point(3,0));
	IObject block2 = Game.CreateObject("Concrete00A",new Vector2(-8,Top + 96));
	block2.SetSizeFactor(new Point(3,0));
	Game.CreateObject("Concrete00A",new Vector2(0,2000));
	IObject block3 = Game.CreateObject("Concrete00A",new Vector2(-16,Top + 96));
	block3.SetSizeFactor(new Point(1,5));
	IObject block4 = Game.CreateObject("Concrete00A",new Vector2(16,Top + 96));
	block4.SetSizeFactor(new Point(1,5));
	IPlayer temp = Game.CreatePlayer(new Vector2(0,Top + 80));
	temp.SetStatusBarsVisible(false);
	temp.SetNametagVisible(false);

	IObjectTimerTrigger stepper = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
	stepper.SetScriptMethod("GameStep");
	stepper.SetIntervalTime(0);
	stepper.SetRepeatCount(0);
	stepper.Trigger();

	SetupSmashBall();
}

public void GameStep(TriggerArgs args){

	//SMASH BALL FUNCTIONS
	if(smashWaitTime > 0){
		smashWaitTime --;
	}else if (smashWaitTime == 0){
		smashWaitTime = -1;
		switch(rnd.Next(0,2)){
			case 0:
				smashPos = new Vector2(Right + 32,rnd.Next((int)Bottom + 50,(int)Top - 50));
				smash_y = smashPos.Y;
				smashSpeed = -0.5f;
			break;
			case 1:
				smashPos = new Vector2(Left - 32,rnd.Next((int)Bottom + 50,(int)Top - 50));
				smash_y = smashPos.Y;
				smashSpeed = 0.5f;
			break;
		}
	}else{
		smashPos.X += smashSpeed;
		smashPos.Y = smash_y + (float)Math.Sin(smashPos.X / 50) * 50;
		img_SmashBall.SetPosition(smashPos);
		smashObj.SetWorldPosition(new Vector2(smashPos.X + 8,smashPos.Y + 8));
		if(smashPos.X < Left - 156){
			SetupSmashBall();
		}
		if(smashPos.X > Right + 156){
			SetupSmashBall();
		}
	}

	int[] teams = new int[5];

	foreach(Fighter o in Fighters){
		o.Step();
		if(o.GetLives() > 0){
			teams[(int)o.GetUser().GetTeam()] ++;
		}	
	}
	if(teams[0] == 1 && teams[1] + teams[2] + teams[3] + teams[4] == 0){
		foreach(Fighter o in Fighters){
			if(o.GetLives() > 0 && !o.GetPlayer().IsDead){
				Game.SetGameOver(o.GetUser().Name + "\nWins!");
			}
		}
	}
	if(teams[1] >= 1 && teams[0] + teams[2] + teams[3] + teams[4] == 0){
		string Names = "";
		foreach(Fighter o in Fighters){
			if((int)o.GetUser().GetTeam() == 1){
				Names += o.GetUser().Name + "\n";
			}
		}
		Game.SetGameOver(Names + "Wins!");
	}
	if(teams[2] >= 1 && teams[0] + teams[1] + teams[3] + teams[4] == 0){
		string Names = "";
		foreach(Fighter o in Fighters){
			if((int)o.GetUser().GetTeam() == 2){
				Names += o.GetUser().Name + "\n";
			}
		}
		Game.SetGameOver(Names + "Wins!");
	}
	if(teams[3] >= 1 && teams[0] + teams[2] + teams[1] + teams[4] == 0){
		string Names = "";
		foreach(Fighter o in Fighters){
			if((int)o.GetUser().GetTeam() == 3){
				Names += o.GetUser().Name + "\n";
			}
		}
		Game.SetGameOver(Names + "Wins!");
	}
	if(teams[4] >= 1 && teams[0] + teams[2] + teams[3] + teams[1] == 0){
		string Names = "";
		foreach(Fighter o in Fighters){
			if((int)o.GetUser().GetTeam() == 4){
				Names += o.GetUser().Name + "\n";
			}
		}
		Game.SetGameOver(Names + "Wins!");
	}
}

static bool _Smash_ = false;	
static Vector2 smashPos;
static float smashSpeed = 0;
static int smashWaitTime = -1;
static IObjectActivateTrigger smashObj;
static float smash_y = 0;
public static void SetupSmashBall(){
	smash_y = 10000;
	if(D_FINAL_SMASHES == 1){
		smashWaitTime = rnd.Next(600,2000);	
	}
	smashPos.Y = smash_y;
	img_SmashBall.SetPosition(smashPos);
	smashObj.SetWorldPosition(new Vector2(smashPos.X + 8,smashPos.Y + 8));
}

public void CollectSmash(TriggerArgs args){
	if(args.Sender is IPlayer){
		foreach(Fighter o in Fighters){
			if(o.GetPlayer() == (args.Sender as IPlayer)){
				o.giveSmash();
			}
		}
		Game.PlayEffect("CFTXT",(args.Sender as IObject).GetWorldPosition(),"Press ALT + A\nTo Final Smash");
		smash_y = 10000;
		smashSpeed = 0;
		smashWaitTime = -1;
		smashPos.Y = smash_y;
		img_SmashBall.SetPosition(smashPos);
		smashObj.SetWorldPosition(new Vector2(smashPos.X + 8,smashPos.Y + 8));
	}
}

//Made by Ebomb09 - January 14, 2019
//You can make sprites inside of the map editor but it is easier to convert your image files with the included application

//Default Constructors
/*		Sprite spr = new Sprite("NAME","DATA");
 *		Image img = getImage(SPRITE);
*/
//Script Notes:
/* 		-Origin of the sprite is bottom left (0,0)
 *
 *		-Larger images will take longer to load, using this script I would recommend 
 *		 16x16 images or less higher can work but higher will be unoptimized
 *
 *		-The image converter was made in GameMaker 2 if you were wondering
 *
 *		-To make sprites inside the mapeditor you need to set the RGB values as the 
 * 		 CustomID of object BgAdobe00E and set mode to 1, origin is also(0,0) in editor
*/
//Image Functions:
/*		GetPosition() 			- Returns position of the image
 *		SetPosition(Vector2)	- Sets the position of the image
 *		Move(Vector2) 			- Move the sprite by the Vector2
 *		Scale(flaot)			- Scale up/down the image
 *		FlipHorrizontal()		- Flip the image along the y axis
 *		FlipVertical()			- Flip the image along the x axis
 *		RemoveColour(Color)		- Remove a color from the image, can be used to remove background
 *		RemoveColour(Color)		- Remove a color from the image, can be used to remove background
 *		ReplaceImage(Sprite)	- Switches the Sprite for a new Sprite
 *		FreeSurface()			- Clears the image and stored data
*/

//HOLDS IMAGE DATA
public struct Sprite{
	public string Name;
	public string data;

	public Sprite(string in_name,string in_data){
		Name = in_name;
		data = in_data;
	}
}

//USES IMAGE DATA
public struct Image{
	List<IObject> contents;
	List<Vector2> coords;
	Vector2 Position;
	float scale;	

	public Image(List<IObject> pp, List<Vector2> locs){
		contents = pp;
		coords = locs;
		Position = new Vector2(0,0);
		scale = 1;
		SetPosition(Position);
	}
	public Vector2 GetPosition(){
		return Position;
	}
	public void Move(Vector2 mov){
		SetPosition(new Vector2(Position.X + mov.X, Position.Y + mov.Y));
	}
	public void SetPosition(Vector2 pos){
		Position = new Vector2(pos.X,pos.Y);
		pos.X -= 1 * scale;
		pos.Y += 2 * scale;
		int index = 0;
		foreach(IObject obj in contents){
			obj.SetWorldPosition(pos + coords[index]);
			index ++;
		}
	}
	public void Scale(float value){
		int index = 0;
		foreach(IObject obj in contents){
			coords[index] *= value/scale;
			((IObjectText)obj).SetTextScale(value);
			index ++;
		}	
		scale = value;
		SetPosition(Position);
	}
	public void FlipHorrizontal(){
		int index = 0;
		foreach(IObject obj in contents){
			coords[index] = new Vector2(coords[index].X * -1,coords[index].Y);
			index ++;
		}		
		SetPosition(Position);	
	}
	public void FlipVertical(){
		int index = 0;
		foreach(IObject obj in contents){
			coords[index] = new Vector2(coords[index].X,coords[index].Y * -1);
			index ++;
		}		
		SetPosition(Position);	
	}
	public void RemoveColour(Color c_picker){
		int index = 0;	
		List<IObject> temp = contents;
		foreach(IObject obj in temp){
			if( ((IObjectText)obj).GetTextColor().Equals(c_picker)){
				obj.Remove();
				index ++;
			}
		}
	}
	public void RemoveColor(Color c_picker){
		RemoveColour(c_picker);
	}
	public void FreeSurface(){
		foreach(IObject obj in contents){
			obj.Remove();
		}
		contents = null;
		coords = null;
	}
	public void ReplaceImage(Sprite sprite){
		FreeSurface();
		string[] format = sprite.data.Split('|');
		contents = new List<IObject>();
		coords = new List<Vector2>();	

		foreach(string pixel in format){
			string[] data_section = pixel.Split(',');
			if(data_section[0] != ""){
				int x = Int32.Parse(data_section[0]);
				int y = Int32.Parse(data_section[1]);
				Color col = new Color((byte)Int32.Parse(data_section[2]),(byte)Int32.Parse(data_section[3]),(byte)Int32.Parse(data_section[4]));
				IObjectText pp = (IObjectText)Game.CreateObject("BgText",new Vector2(x * scale,y * scale));
				pp.SetText(".");
				pp.SetTextColor(col);
				contents.Add(pp);
				coords.Add(pp.GetWorldPosition());
			}
		}
		Scale(scale);
		SetPosition(Position);
	}
}

//DRAW FUNCTIONS
public static Image getImage(Sprite sprite){
	string[] format = sprite.data.Split('|');
	List<IObject> contents = new List<IObject>();
	List<Vector2> coords = new List<Vector2>();	

	foreach(string pixel in format){
		string[] data_section = pixel.Split(',');
		if(data_section[0] != ""){
			int x = Int32.Parse(data_section[0]);
			int y = Int32.Parse(data_section[1]);
			Color col = new Color((byte)Int32.Parse(data_section[2]),(byte)Int32.Parse(data_section[3]),(byte)Int32.Parse(data_section[4]));
			IObjectText pp = (IObjectText)Game.CreateObject("Text",new Vector2(x,y));
			pp.SetText(".");
			pp.SetTextColor(col);
			contents.Add(pp);
			coords.Add(pp.GetWorldPosition());
		}
	}

	return new Image(contents,coords);
}