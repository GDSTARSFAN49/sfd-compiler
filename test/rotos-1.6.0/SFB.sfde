//TIME BEFORE PLAYERS CAN BE DAMAGED
//														DEFAULT:120
static int D_INVINCIBLE_FRAMES 				= 120;

//FINAL SMASHES ENABLED?
//														DEFAULT:0
static int D_FINAL_SMASHES					= 0;


static float Top = 0;
static float Bottom = 0;
static float Left = 0;
static float Right = 0;
static Random rnd = new Random();
IList<Fighter> Fighters = new List<Fighter>();

Events.UserMessageCallback m_userMessageCallback = null;

