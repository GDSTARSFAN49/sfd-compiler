//Players
static List<Fighter> Police = new List<Fighter>();
static List<Fighter> Terrorist = new List<Fighter>();

static List<IObject> policeSpawns = new List<IObject>();
static List<IObject> terroristSpawns = new List<IObject>();

//Bomb
static Area bombZone;
static IPlayer bombTarget;
static int bombStatus = 0;
static int bombTimer = 0;
static int bombExTimer = 0;

//Match Settings
static bool GameOver = false;

//Objects
static IObject Button;
static List<IObjectText> bombHud = new List<IObjectText>();
static List<IObjectText> bombHud2 = new List<IObjectText>();

static Random rnd = new Random();

public void OnStartup(){

	Game.AutoVictoryConditionEnabled = false;
	Game.AutoScoreConditionEnabled = false;

	foreach(IPlayer ply in Game.GetPlayers()){
		ply.Remove();
	}

	SetBombSite();
	
	FindSpawns();
	SetTeams();

	IObjectTimerTrigger stepper = (IObjectTimerTrigger)Game.CreateObject("TimerTrigger");
	stepper.SetIntervalTime(0);
	stepper.SetRepeatCount(0);
	stepper.SetScriptMethod("GameTick");
	stepper.Trigger();
}

public void SetTeams(){
	//Max Team Sizes
	int gameSize = Game.GetActiveUsers().Length;
	int pSize = gameSize / 2;
	int tSize = gameSize / 2;

	//Uneven Teams
	if(gameSize % 2 != 0){
		if(rnd.Next(0,2) == 0){
			pSize ++;
		}else{
			tSize ++;
		}
	}

	//Randomize and Set Teams
	foreach(IUser usr in Game.GetActiveUsers()){

		//Pick Team
		int Team = rnd.Next(0,2);

		//Check if Not Full
		if(Team == 0){
			if(pSize == 0){
				Team = 1;
			}
		}else{
			if(tSize == 0){
				Team = 0;
			}	
		}

		//Add to Team
		if(Team == 0){
			Police.Add(new Fighter(usr, PlayerTeam.Team1));
			pSize --;
		}else{
			Terrorist.Add(new Fighter(usr, PlayerTeam.Team2));
			tSize --;
		}

	}

}

public void SetBombSite(){
	double Distance = -1;
	Vector2 Pos = new Vector2(0,0);
	foreach(IObject obj in Game.GetObjectsByName("SpawnPlayer")){
		Vector2 tempPos = obj.GetWorldPosition();
		double tempDistance = Math.Sqrt(Math.Pow(tempPos.X,2) + Math.Pow(tempPos.Y,2) );

		if((Distance == -1 || tempDistance < Distance) && obj.GetWorldPosition().X <= 0){
			Distance = tempDistance;
			Pos = obj.GetWorldPosition();
		}

	}

	bool Check = true;

	do{	//Wow first time I use do / while
		bombZone = new Area(Pos.Y + 16, Pos.X - 16, Pos.Y - 16, Pos.X + 16);

		foreach(IObject obj in Game.GetObjectsByArea(bombZone)){

			if(obj.GetCollisionFilter().CategoryBits != 0 && obj.GetCollisionFilter().CategoryBits != 65535){
				Check = false;
			}

			//DEBUG//Game.RunCommand("/msg " + obj.GetCollisionFilter().CategoryBits);
		}

		if(Check){
			Pos += new Vector2(0,-8 );
		}

	}while(Check);

	IObject Safe = Game.CreateObject("Safe00", Pos - new Vector2(0,4));
	Safe.SetBodyType(BodyType.Static);
	Safe.CustomID = "Safe";

	IObjectActivateTrigger Button = (IObjectActivateTrigger)Game.CreateObject("ActivateTrigger", Pos);
	Button.SetScriptMethod("BombUpdate");
	Button.SetHighlightObject(Safe);

	//Make Sure Text Is Visible
	IObjectText temp;

	temp = (IObjectText)Game.CreateObject("Text", Pos - new Vector2(0,16));
	temp.SetTextAlignment(TextAlignment.Middle);
	temp.SetTextColor(new Color(0,0,0));
	temp.SetText("Bomb Site");

	temp = (IObjectText)Game.CreateObject("Text", Pos - new Vector2(1,15));
	temp.SetTextAlignment(TextAlignment.Middle);
	temp.SetTextColor(new Color(0,0,0));
	temp.SetText("Bomb Site");

	temp = (IObjectText)Game.CreateObject("Text", Pos - new Vector2(-1,15));
	temp.SetTextAlignment(TextAlignment.Middle);
	temp.SetTextColor(new Color(0,0,0));
	temp.SetText("Bomb Site");

	temp = (IObjectText)Game.CreateObject("Text", Pos - new Vector2(0,14));
	temp.SetTextAlignment(TextAlignment.Middle);
	temp.SetTextColor(new Color(0,0,0));
	temp.SetText("Bomb Site");


	temp = (IObjectText)Game.CreateObject("Text", Pos - new Vector2(0,15));
	temp.SetTextAlignment(TextAlignment.Middle);
	temp.SetTextColor(new Color(200,0,0));
	temp.SetText("Bomb Site");

	//Show Bomb Hud

	bombHud.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(1,16)));
	bombHud.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(-1,16)));
	bombHud.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,15)));
	bombHud.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,17)));
	bombHud.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,16)));

	bombHud2.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(-1,8)));
	bombHud2.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(1,8)));
	bombHud2.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,7)));
	bombHud2.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,9)));
	bombHud2.Add((IObjectText)Game.CreateObject("Text", Pos + new Vector2(0,8)));

}

public void FindSpawns(){
	Area area = Game.GetCameraMaxArea();
	
	List<IObject> temp = SortObjectsByDistance(new Vector2(area.Left,0));
	List<IObject> temp2 = SortObjectsByDistance(new Vector2(area.Right,0));

	for(int i = 0;i < 2;i ++){
		policeSpawns.Add(temp[i]);
		terroristSpawns.Add(temp2[i]);
	}
}

public void GameTick(TriggerArgs args){

	//Debug//Game.RunCommand("/msg " + bombTimer + ":" + bombExTimer);

	foreach(IPlayer ply in Game.GetPlayers()){

		if(ply.IsBot && !ply.IsDead && ply.GetLinearVelocity() == new Vector2(0,0) && bombZone.Contains(ply.GetWorldPosition())){
			BombUpdate(new TriggerArgs(null,ply,true));
		}

	}

	if(bombStatus == 0 || bombStatus == -1){
		SetText(bombHud,"");
		SetText(bombHud2,"");
		
		int tSize = 0;
		foreach(Fighter o in Terrorist){
			if(o.Player != null && !o.Player.IsDead && !o.Player.IsRemoved){
				tSize ++;
			}
		}

		if(tSize == 0){
			GiveWin(1);
		}

	}

	int pSize = 0;
	foreach(Fighter o in Police){
		if(o.Player != null && !o.Player.IsDead && !o.Player.IsRemoved){
			pSize ++;
		}
	}

	if(pSize == 0){
		GiveWin(2);
	}

	if(bombStatus == 1 || bombStatus == 3){

		string hud = "[";

		for(int i = 0;i < 250;i += 25){
					
			if(i < bombTimer){
				hud += ":";
			}else{
				hud += " ";
			}

		}

		hud += "]";
		SetText(bombHud2,hud);

		if(bombTimer % 25 == 0){
			Game.PlaySound("MenuOK",bombHud[0].GetWorldPosition(),0.5f);
		}

		if(bombStatus == 1){
			SetText(bombHud,"Planting");
		}else{
			SetText(bombHud,"Defusing");
		}

		if(!bombZone.Contains(bombTarget.GetWorldPosition()) || bombTarget.IsDead || bombTarget.IsRemoved){
			bombTimer = 0;

			switch(bombStatus){
				case 1:
					bombStatus = 0;
				break;
				case 3:
					bombStatus = 2;
				break;
			}

			Game.PlaySound("MenuCancel",bombHud[0].GetWorldPosition());

		}else{
			bombTimer ++;

			if(bombTimer >= 250){

				switch(bombStatus){
					case 1:
						//Set bomb activated
						bombStatus = 2;
						bombExTimer = 1000;

						IObject obj = Game.GetSingleObjectByCustomID("Safe");

						foreach(Fighter o in Police){
							Game.ShowChatMessage("[ALERT] The bomb was was planted, hurry and defuse the situation",new Color(244, 98, 66), o.MyUser.UserIdentifier);
							o.Player.SetGuardTarget(obj);
						}
						foreach(Fighter o in Terrorist){
							Game.ShowChatMessage("[RADIO] Good work, continue to defend the bomb",new Color(201, 161, 74), o.MyUser.UserIdentifier);							
							o.Player.SetGuardTarget(null);
						}
					break;
					case 3:
						//Set bomb deactivated
						bombStatus = -1;
						GiveWin(1);
						Game.PlaySound("GrenadeDud", bombHud[0].GetWorldPosition());
						Game.PlayEffect("STM", bombHud[0].GetWorldPosition() + new Vector2(0,-8));
					break;
				}

			}

		}

	}
	if(bombStatus == 2 && bombExTimer > 0){
		string hud = "[";

		for(int i = 0;i < 1000;i += 100){
					
			if(i < bombExTimer){
				hud += ":";
			}else{
				hud += " ";
			}

		}

		hud += "]";
		SetText(bombHud2,hud);
		SetText(bombHud,"Time Left");

		if(bombExTimer % 100 == 0){
			Game.PlaySound("GrenadeDud", bombHud[0].GetWorldPosition());
			Game.PlayEffect("STM", bombHud[0].GetWorldPosition() + new Vector2(0,-8));
		}

		bombExTimer --;		
		
		//bomb went off
		if(bombExTimer <= 0){
			bombTimer = -1;
			GiveWin(2);
			bombStatus = -1;

			Game.GetSingleObjectByCustomID("Safe").Destroy();

			for(int w = 0;w < 5;w ++){

				for(int h = 0;h < 5;h ++){

					Game.TriggerExplosion(bombHud[0].GetWorldPosition() + new Vector2(-16 * 2.5f + 16 * w,-16 * 2.5f + 16 * h));

				}

			}
		}

	}
}

public List<IObject> SortObjectsByDistance(Vector2 Pos){
	List<IObject> temp = new List<IObject>();
	List<Double> tempDistance = new List<Double>();	

	foreach(IObject obj in Game.GetObjectsByName("SpawnPlayer")){
		Vector2 tempPos = obj.GetWorldPosition();
		double Distance = Math.Sqrt(Math.Pow(Pos.X - tempPos.X,2) + Math.Pow(Pos.Y - tempPos.Y,2) );

		int z = 0;

		for(int i = 0;i < tempDistance.Count; i ++){
			if(Distance < tempDistance[i]){
				break;
			}
			z = i;
		}

		temp.Insert(z, obj);
		tempDistance.Insert(z, Distance);

	}

	return temp;
}

class Fighter{

	public IPlayer Player;
	public IUser MyUser;

	public Fighter(IUser User, PlayerTeam Team){
		MyUser = User;

		IObject Spawn = null;
		if(Team == PlayerTeam.Team1){
			Spawn = policeSpawns[rnd.Next(0,policeSpawns.Count)];
		}else{
			Spawn = terroristSpawns[rnd.Next(0,terroristSpawns.Count)];
		}

		Player = Game.CreatePlayer(Spawn.GetWorldPosition());

		if(Team == PlayerTeam.Team2){
			Player.SetProfile(User.GetProfile());
		}else{
			Player.SetProfile(GetMetroSkin());
		}

		Player.SetTeam(Team);
		Player.SetFaceDirection(Spawn.GetFaceDirection());

		User.SetPlayer(Player);

		if(User.IsBot){
			Player.SetBotBehavior(new BotBehavior(true,User.BotPredefinedAIType));

			BotBehaviorSet bot = Player.GetBotBehaviorSet();
			bot.GuardRange = 1;
			Player.SetBotBehaviorSet(bot);

			if(Team == PlayerTeam.Team2){
				IObject obj = Game.GetSingleObjectByCustomID("Safe");
				Player.SetGuardTarget(obj);
			}

		}

		if(Team == PlayerTeam.Team1){
			Game.ShowChatMessage("[ALERT] Information suggests rebels are planning an attack near your location, eliminate the insurgents",new Color(244, 98, 66), User.UserIdentifier);
			Player.GiveWeaponItem(WeaponItem.PISTOL);
			Player.GiveWeaponItem(WeaponItem.SHOCK_BATON);
		}else{
			Game.ShowChatMessage("[RADIO] You're nearing the target location, plant the bomb and watch for enemy opposition",new Color(201, 161, 74), User.UserIdentifier);
		}
	}
}

public void BombUpdate(TriggerArgs args){
	if(args.Sender is IPlayer && !(args.Sender as IPlayer).IsDead){
		IPlayer Player = args.Sender as IPlayer;
		
		switch(bombStatus){
			case 0:

				if(Player.GetTeam() == PlayerTeam.Team2){
					bombTarget = Player;
					bombStatus = 1;
					bombTimer = 0;
				}
				
			break;
			case 2:

				if(Player.GetTeam() == PlayerTeam.Team1){
					bombTarget = Player;
					bombStatus = 3;
					bombTimer = 0;
				}

			break;
		}

	}

}

public void GiveWin(int Team){

	if(!GameOver){

		if(Team == 1){

			Game.SetGameOver("Metro Cops Win!");

			foreach(Fighter o in Police){
				o.MyUser.IncreaseScore();
			}

		}else{
			Game.SetGameOver("Super Fighters Win!");

			foreach(Fighter o in Terrorist){
				o.MyUser.IncreaseScore();
			}

		}

		GameOver = true;

	}

}

public static IProfile GetMetroSkin(){
	IProfile metro = new IProfile();

	metro.Head = new IProfileClothingItem("MetroLawGasMask","ClothingDarkGray","ClothingLightGray");
	metro.ChestOver = new IProfileClothingItem("MetroLawJacket","ClothingDarkGray","ClothingDarkGray");
	metro.Hands = new IProfileClothingItem("SafetyGlovesBlack","ClothingDarkGray");
	metro.Legs = new IProfileClothingItem("PantsBlack","ClothingDarkGray");
	metro.Feet = new IProfileClothingItem("BootsBlack","ClothingDarkGray");
	
	return metro;
}

public void SetText(List<IObjectText> Items, string Text){

	foreach(IObjectText o in Items){
		o.SetText(Text);
		o.SetTextColor(new Color(0,0,0));
		o.SetTextAlignment(TextAlignment.Middle);
	}
	Items[Items.Count - 1].SetTextColor(new Color(200,0,0));
}