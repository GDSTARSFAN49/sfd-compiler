<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SFD_COMPILER</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Misma version de Roslyn que usa SFD.ScriptEngine.dll (Microsoft.CodeAnalysis 4.13).
         Solo actua como respaldo: si en la carpeta de DLL estan los Microsoft.CodeAnalysis*.dll
         del propio juego, el motor se carga con los suyos. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DLL que se copian del juego. No se referencian en compilacion: el compilador los lee
         en caliente al arrancar, por eso basta con sustituirlos cuando SFD se actualice. -->
    <None Include="SFD.GameScriptInterface.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SFD.ScriptEngine.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Ensamblados de referencia de .NET 8: la superficie de API que ve el juego al compilar
         un script. Sin esto compilariamos contra el runtime de esta API y dariamos por buenos
         scripts que usan APIs mas nuevas que las que SFD tiene. Ver referencias/LEEME.md. -->
    <None Include="referencias\**\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>referencias\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
